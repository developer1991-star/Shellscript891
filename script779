    "workLocationAddress2Home",
    "workLocationCityHome",
    "workLocationStateHome",
    "workLocationCountryHome",
    "workEmailAddress",
]

MAX_RETRIES = 8
BASE_RETRY_SECONDS = 2

RETRYABLE_EXCEPTIONS = (
    DeadlineExceeded,
    ServiceUnavailable,
    InternalServerError,
    Aborted,
    ResourceExhausted,
)

store = firestore.Client(project=PROJECT_ID)


def retry(operation_name, fn):
    """Retry transient Google/Firestore failures with exponential backoff."""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            return fn()
        except RETRYABLE_EXCEPTIONS as exc:
            if attempt == MAX_RETRIES:
                raise
            sleep_seconds = min(60, BASE_RETRY_SECONDS * (2 ** (attempt - 1)))
            print(
                f"WARNING: {operation_name} failed: {type(exc).__name__}: {exc}\n"
                f"Retry {attempt}/{MAX_RETRIES} in {sleep_seconds}s..."
            )
            time.sleep(sleep_seconds)


def normalize_record(row: Dict[str, str]) -> Dict[str, str]:
    row = {
        (key.strip() if isinstance(key, str) else key):
        (value.strip() if isinstance(value, str) else value)
        for key, value in row.items()
        if key is not None
    }

    email = row.get("workEmailAddress")
    if isinstance(email, str):
        row["workEmailAddress"] = email.lower()

    row["homeCountryCode"] = row.get("homeLocationCountry")
    return row


def iter_valid_records() -> Iterable[Dict[str, str]]:
    with open(INPUT_FILE, "r", encoding="utf-8-sig", newline="") as f:
        if HAS_HEADER:
            reader = csv.DictReader(f, delimiter=DELIMITER)
        else:
            lines = ("empty_record" if line.isspace() else line for line in f)
            reader = csv.DictReader(lines, fieldnames=FIELDS, delimiter=DELIMITER)

        for row in reader:
            row = normalize_record(dict(row))
            emp_id = str(row.get("employeeID", "") or "").strip()

            if not emp_id:
                continue
            if emp_id == "empty_record" or emp_id.startswith("TRL"):
                continue
            if "/" in emp_id:
                print(f"WARNING: Skipping invalid employeeID: {emp_id}")
                continue

            row["employeeID"] = emp_id
            yield row


def chunks(iterable: Iterable[Dict[str, str]], size: int):
    chunk: List[Dict[str, str]] = []
    for item in iterable:
        chunk.append(item)
        if len(chunk) >= size:
            yield chunk
            chunk = []
    if chunk:
        yield chunk


def validate_update_fields():
    if len(UPDATE_FIELDS) != 2:
        raise ValueError("UPDATE_FIELDS must contain exactly two field names.")

    placeholders = {"COLUMN_A_FIELD_NAME", "COLUMN_B_FIELD_NAME"}
    if any(field in placeholders for field in UPDATE_FIELDS):
        raise ValueError(
            "Set UPDATE_FIELDS to the exact two fields you want to update "
            "for existing employees before running this script."
        )


def process_chunk(records: List[Dict[str, str]]) -> Tuple[int, int, int]:
    collection = store.collection(COLLECTION_NAME)

    records_by_id = {
        str(record["employeeID"]): record
        for record in records
    }

    refs_by_id = {
        emp_id: collection.document(emp_id)
        for emp_id in records_by_id
    }

    snapshots = retry(
        "Firestore employee lookup",
        lambda: list(store.get_all(list(refs_by_id.values()))),
    )

    existing_ids = {
        snapshot.id
        for snapshot in snapshots
        if snapshot.exists
    }

    batch = store.batch()

    inserted = 0
    updated = 0
    skipped = 0

    for emp_id, record in records_by_id.items():
        doc_ref = refs_by_id[emp_id]

        if emp_id in existing_ids:
            update_data = {}

            for field in UPDATE_FIELDS:
                if field not in record:
                    print(
                        f"WARNING: Employee {emp_id}: incoming row does not contain "
                        f"'{field}'. Field not updated."
                    )
                    continue
                update_data[field] = record[field]

            if update_data:
                batch.update(doc_ref, update_data)
                updated += 1
            else:
                skipped += 1

        else:
            batch.set(doc_ref, record)
            inserted += 1

    retry("Firestore batch commit", batch.commit)
    return inserted, updated, skipped


def main():
    validate_update_fields()

    print(f"Project:    {PROJECT_ID}")
    print(f"Collection: {COLLECTION_NAME}")
    print(f"Input:      {INPUT_FILE}")
    print(f"Delimiter:  {repr(DELIMITER)}")
    print(f"Update existing employees ONLY in: {UPDATE_FIELDS}")
    print()

    processed = 0
    total_inserted = 0
    total_updated = 0
    total_skipped = 0
    batch_number = 0

    for batch_records in chunks(iter_valid_records(), BATCH_SIZE):
        batch_number += 1

        inserted, updated, skipped = process_chunk(batch_records)

        processed += len(batch_records)
        total_inserted += inserted
        total_updated += updated
        total_skipped += skipped

        print(
            f"[Batch {batch_number}] "
            f"processed={processed:,} | "
            f"inserted={total_inserted:,} | "
            f"updated={total_updated:,} | "
            f"skipped={total_skipped:,}"
        )

    print()
    print("Employee load complete")
    print(f"Processed: {processed:,}")
    print(f"Inserted:  {total_inserted:,}")
    print(f"Updated:   {total_updated:,}")
    print(f"Skipped:   {total_skipped:,}")


if __name__ == "__main__":
    main()

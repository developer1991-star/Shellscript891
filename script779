using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PCPM.Application.D158500;

namespace PCPM.Pages;

public class D158500Model : PageModel
{
    private readonly ID158500Service _service;

    public D158500Model(ID158500Service service)
    {
        _service = service;
    }

    // =========================================================
    // INPUT FIELDS
    // =========================================================

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string JobNumber { get; set; } = string.Empty;

    [BindProperty]
    public string Sf { get; set; } = string.Empty;

    [BindProperty]
    public string SelRem { get; set; } = string.Empty;

    [BindProperty]
    public List<StatusRow> StatusRows { get; set; } =
        Enumerable.Range(0, 11)
            .Select(_ => new StatusRow())
            .ToList();


    // =========================================================
    // DISPLAY FIELDS
    // =========================================================

    public string Date { get; set; } = string.Empty;

    public string JobName { get; set; } = string.Empty;

    public string BidAmount { get; set; } = string.Empty;

    public string Remarks { get; set; } = string.Empty;

    public string ErrorMessage { get; set; } = string.Empty;


    // =========================================================
    // GET
    // =========================================================

    public async Task<IActionResult> OnGetAsync(string? jobNumber)
    {
        ClearMessage();

        if (!string.IsNullOrWhiteSpace(jobNumber))
        {
            JobNumber = Normalize(jobNumber);
        }

        /*
         * If a job number was passed to this screen, load it.
         *
         * The old COBOL LOAD-JOBREC logic searched for the first
         * eligible record whose JOBNO was >= the requested JOBNO.
         */
        if (!string.IsNullOrWhiteSpace(JobNumber))
        {
            await LoadJobAsync(JobNumber);
        }
        else
        {
            InitializeBlankScreen();
        }

        return Page();
    }


    // =========================================================
    // MAIN ENTER HANDLER
    // =========================================================

    public async Task<IActionResult> OnPostAsync()
    {
        NormalizeInput();

        /*
         * Legacy CHECK-CONFLICT.
         *
         * Only ONE navigation request can be active at a time:
         *
         *   ACTION
         *   SF
         *   SELREM
         *   one STATUS row
         */
        if (HasNavigationConflict())
        {
            ErrorMessage = "NAVIGATION CONFLICT";
            await ReloadCurrentJobAsync();

            return Page();
        }

        // -----------------------------------------------------
        // ACTION entered
        // -----------------------------------------------------

        if (!string.IsNullOrWhiteSpace(Action))
        {
            return await ProcessActionAsync();
        }

        // -----------------------------------------------------
        // SF selected
        //
        // Legacy:
        //     WHEN D158500.SF = 'S'
        //          SET W-NEXT = '510'
        // -----------------------------------------------------

        if (!string.IsNullOrWhiteSpace(Sf))
        {
            if (Sf != "S")
            {
                ErrorMessage = "INVALID SELECTION CODE";
                await ReloadCurrentJobAsync();
                return Page();
            }

            return RedirectToPage(
                "/D158510",
                BuildJobRouteValues());
        }

        // -----------------------------------------------------
        // REMARK selected
        //
        // Legacy:
        //     WHEN D158500.SELREM = 'S'
        //          SET W-NEXT = '550'
        // -----------------------------------------------------

        if (!string.IsNullOrWhiteSpace(SelRem))
        {
            if (SelRem != "S")
            {
                ErrorMessage = "INVALID SELECTION CODE";
                await ReloadCurrentJobAsync();
                return Page();
            }

            return RedirectToPage(
                "/D158550",
                BuildJobRouteValues());
        }

        // -----------------------------------------------------
        // STATUS / FUNCTIONAL AREA row selected
        // -----------------------------------------------------

        var selectedRow = StatusRows
            .Select((row, index) => new
            {
                Row = row,
                Index = index
            })
            .FirstOrDefault(x =>
                !string.IsNullOrWhiteSpace(x.Row.Selection));

        if (selectedRow != null)
        {
            return await ProcessStatusSelectionAsync(selectedRow.Row);
        }

        /*
         * Legacy NAVIGATION-PREP:
         *
         * No Action and no selected record means redisplay 500,
         * unless a new job number has been entered.
         */

        if (string.IsNullOrWhiteSpace(JobNumber))
        {
            ErrorMessage = "SELECTION NOT SPECIFIED";

            InitializeBlankScreen();

            return Page();
        }

        /*
         * Pressing Enter with a job number loads/reloads that job.
         */
        await LoadJobAsync(JobNumber);

        return Page();
    }


    // =========================================================
    // PF1 - HELP
    // =========================================================

    public IActionResult OnPostHelp()
    {
        NormalizeInput();

        return RedirectToPage(
            "/D158999",
            new
            {
                screen = "500",
                jobNumber = JobNumber
            });
    }


    // =========================================================
    // PF3 - PREVIOUS
    // =========================================================

    public IActionResult OnPostPrevious()
    {
        /*
         * Legacy P-RECORD handling returned control to the
         * previous screen.
         *
         * D158000 is used here as the safe PCPM landing point.
         * If your existing session service stores P-RECORD,
         * replace this redirect with that value.
         */
        return RedirectToPage("/D158000");
    }


    // =========================================================
    // PF6 - RESET
    // =========================================================

    public async Task<IActionResult> OnPostResetAsync()
    {
        Action = string.Empty;
        Sf = string.Empty;
        SelRem = string.Empty;
        ErrorMessage = string.Empty;

        foreach (var row in StatusRows)
        {
            row.Selection = string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(JobNumber))
        {
            await LoadJobAsync(JobNumber);
        }
        else
        {
            InitializeBlankScreen();
        }

        return Page();
    }


    // =========================================================
    // PF7 - BACKWARD
    // =========================================================

    public async Task<IActionResult> OnPostBackwardAsync()
    {
        NormalizeInput();
        ClearSelections();

        if (string.IsNullOrWhiteSpace(JobNumber))
        {
            ErrorMessage = "SELECTION NOT SPECIFIED";
            InitializeBlankScreen();

            return Page();
        }

        var result = await _service.GetPreviousJobAsync(JobNumber);

        if (result == null)
        {
            ErrorMessage = "BEGINNING OF FILE";
            await ReloadCurrentJobAsync();

            return Page();
        }

        ApplyScreen(result);

        return Page();
    }


    // =========================================================
    // PF8 - FORWARD
    // =========================================================

    public async Task<IActionResult> OnPostForwardAsync()
    {
        NormalizeInput();
        ClearSelections();

        if (string.IsNullOrWhiteSpace(JobNumber))
        {
            ErrorMessage = "SELECTION NOT SPECIFIED";
            InitializeBlankScreen();

            return Page();
        }

        var result = await _service.GetNextJobAsync(JobNumber);

        if (result == null)
        {
            ErrorMessage = "END OF FILE";
            await ReloadCurrentJobAsync();

            return Page();
        }

        ApplyScreen(result);

        return Page();
    }


    // =========================================================
    // PF12 - MAIN MENU
    // =========================================================

    public IActionResult OnPostMain()
    {
        return RedirectToPage("/D158000");
    }


    // =========================================================
    // ACTION PROCESSING
    // =========================================================

    private async Task<IActionResult> ProcessActionAsync()
    {
        Action = Normalize(Action);

        /*
         * Legacy VALIDATE-ACTION:
         *
         * Valid when:
         *   ACTION = SO
         *
         * OR:
         *   ACTION is a valid numeric screen number.
         */

        if (Action == "SO")
        {
            /*
             * Keep this on D158500 unless/until the exact SO
             * destination is confirmed by the surrounding
             * navigation program.
             */
            await ReloadCurrentJobAsync();

            return Page();
        }

        if (!int.TryParse(Action, out var screen))
        {
            ErrorMessage = "INVALID ACTION CODE";
            await ReloadCurrentJobAsync();

            return Page();
        }

        /*
         * Screen navigation is constrained deliberately instead
         * of allowing arbitrary URL input.
         *
         * Add/remove entries as the remaining PCPM panels are
         * migrated.
         */
        var allowedScreens = new HashSet<int>
        {
            500,
            510,
            550,

            101,
            201,
            202,
            301,
            302,
            401,

            700,
            800,
            900,
            915,
            920,
            940,
            945,
            950,
            999
        };

        if (!allowedScreens.Contains(screen))
        {
            ErrorMessage = "INVALID ACTION CODE";
            await ReloadCurrentJobAsync();

            return Page();
        }

        if (screen == 500)
        {
            await ReloadCurrentJobAsync();
            return Page();
        }

        return RedirectToPage(
            $"/D158{screen:000}",
            BuildJobRouteValues());
    }


    // =========================================================
    // STATUS ROW PROCESSING
    // =========================================================

    private async Task<IActionResult> ProcessStatusSelectionAsync(
        StatusRow row)
    {
        var selection = Normalize(row.Selection);
        var functionalArea = Normalize(row.FunctionalArea);

        /*
         * Legacy LOAD-SCREEN-ID:
         *
         *     S or I -> FA + 302
         *     U      -> FA + 202
         */

        switch (selection)
        {
            case "S":
            case "I":

                if (string.IsNullOrWhiteSpace(functionalArea))
                {
                    ErrorMessage = "INVALID FUNC AREA ON STATUS REC";
                    await ReloadCurrentJobAsync();
                    return Page();
                }

                return RedirectToPage(
                    "/D158302",
                    new
                    {
                        jobNumber = JobNumber,
                        functionalArea
                    });


            case "U":

                if (string.IsNullOrWhiteSpace(functionalArea))
                {
                    ErrorMessage = "INVALID FUNC AREA ON STATUS REC";
                    await ReloadCurrentJobAsync();
                    return Page();
                }

                return RedirectToPage(
                    "/D158202",
                    new
                    {
                        jobNumber = JobNumber,
                        functionalArea
                    });


            default:

                ErrorMessage = "INVALID SELECTION CODE";

                await ReloadCurrentJobAsync();

                return Page();
        }
    }


    // =========================================================
    // LOAD JOB
    // =========================================================

    private async Task LoadJobAsync(string requestedJobNumber)
    {
        ClearSelections();

        requestedJobNumber = Normalize(requestedJobNumber);

        var result =
            await _service.GetJobAsync(requestedJobNumber);

        if (result == null)
        {
            JobNumber = requestedJobNumber;
            ErrorMessage = "NO RECORDS FOUND AT ALL";

            ClearDisplayData();

            return;
        }

        ApplyScreen(result);

        /*
         * Legacy LOAD-JOBREC:
         *
         * The query uses JOBNO >= requested JOBNO.
         * If a greater job is returned:
         *
         *     NEXT JOB RECORD RETURNED
         */

        if (!string.Equals(
                result.JobNumber?.Trim(),
                requestedJobNumber.Trim(),
                StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "NEXT JOB RECORD RETURNED";
        }
    }


    // =========================================================
    // RELOAD CURRENT JOB
    // =========================================================

    private async Task ReloadCurrentJobAsync()
    {
        var message = ErrorMessage;

        if (!string.IsNullOrWhiteSpace(JobNumber))
        {
            var result = await _service.GetJobAsync(JobNumber);

            if (result != null)
            {
                ApplyScreen(result);
            }
            else
            {
                ClearDisplayData();
            }
        }
        else
        {
            ClearDisplayData();
        }

        ErrorMessage = message;
    }


    // =========================================================
    // MAP SERVICE MODEL -> SCREEN
    // =========================================================

    private void ApplyScreen(D158500Screen result)
    {
        JobNumber = result.JobNumber?.Trim() ?? string.Empty;
        JobName = result.JobName?.TrimEnd() ?? string.Empty;

        Date = string.IsNullOrWhiteSpace(result.Date)
            ? DateTime.Today.ToString("MM/dd/yyyy")
            : result.Date;

        BidAmount = result.BidAmount?.Trim() ?? string.Empty;

        Remarks = result.Remarks?.TrimEnd() ?? string.Empty;

        StatusRows = new List<StatusRow>();

        if (result.StatusRows != null)
        {
            foreach (var source in result.StatusRows.Take(11))
            {
                StatusRows.Add(new StatusRow
                {
                    Selection = string.Empty,

                    FunctionalArea =
                        source.FunctionalArea?.Trim() ?? string.Empty,

                    FunctionalAreaDescription =
                        source.FunctionalAreaDescription?.TrimEnd()
                        ?? string.Empty,

                    Percent =
                        source.Percent?.Trim() ?? string.Empty,

                    StartDate =
                        source.StartDate?.Trim() ?? string.Empty,

                    ProjectedEndDate =
                        source.ProjectedEndDate?.Trim() ?? string.Empty,

                    EndDate =
                        source.EndDate?.Trim() ?? string.Empty,

                    Status =
                        source.Status?.Trim() ?? string.Empty
                });
            }
        }

        EnsureElevenRows();
    }


    // =========================================================
    // CONFLICT CHECK
    // =========================================================

    private bool HasNavigationConflict()
    {
        var count = 0;

        if (!string.IsNullOrWhiteSpace(Action))
        {
            count++;
        }

        if (!string.IsNullOrWhiteSpace(Sf))
        {
            count++;
        }

        if (!string.IsNullOrWhiteSpace(SelRem))
        {
            count++;
        }

        count += StatusRows.Count(
            x => !string.IsNullOrWhiteSpace(x.Selection));

        /*
         * Legacy ENTER conflict:
         * more than one requested navigation operation.
         */
        return count > 1;
    }


    // =========================================================
    // INITIALIZATION
    // =========================================================

    private void InitializeBlankScreen()
    {
        Date = DateTime.Today.ToString("MM/dd/yyyy");

        JobName = string.Empty;
        BidAmount = string.Empty;
        Remarks = string.Empty;

        StatusRows = Enumerable.Range(0, 11)
            .Select(_ => new StatusRow())
            .ToList();
    }


    private void ClearDisplayData()
    {
        JobName = string.Empty;
        BidAmount = string.Empty;
        Remarks = string.Empty;

        StatusRows = Enumerable.Range(0, 11)
            .Select(_ => new StatusRow())
            .ToList();

        Date = DateTime.Today.ToString("MM/dd/yyyy");
    }


    private void EnsureElevenRows()
    {
        while (StatusRows.Count < 11)
        {
            StatusRows.Add(new StatusRow());
        }

        if (StatusRows.Count > 11)
        {
            StatusRows = StatusRows
                .Take(11)
                .ToList();
        }
    }


    // =========================================================
    // INPUT NORMALIZATION
    // =========================================================

    private void NormalizeInput()
    {
        Action = Normalize(Action);
        JobNumber = Normalize(JobNumber);
        Sf = Normalize(Sf);
        SelRem = Normalize(SelRem);

        EnsureElevenRows();

        foreach (var row in StatusRows)
        {
            row.Selection = Normalize(row.Selection);
            row.FunctionalArea = Normalize(row.FunctionalArea);
        }
    }


    private static string Normalize(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();
    }


    private void ClearSelections()
    {
        Action = string.Empty;
        Sf = string.Empty;
        SelRem = string.Empty;

        EnsureElevenRows();

        foreach (var row in StatusRows)
        {
            row.Selection = string.Empty;
        }
    }


    private void ClearMessage()
    {
        ErrorMessage = string.Empty;
    }


    // =========================================================
    // ROUTE VALUES
    // =========================================================

    private object BuildJobRouteValues()
    {
        return new
        {
            jobNumber = JobNumber
        };
    }


    // =========================================================
    // STATUS ROW MODEL USED BY RAZOR
    // =========================================================

    public class StatusRow
    {
        public string Selection { get; set; } = string.Empty;

        public string FunctionalArea { get; set; } = string.Empty;

        public string FunctionalAreaDescription { get; set; }
            = string.Empty;

        public string Percent { get; set; } = string.Empty;

        public string StartDate { get; set; } = string.Empty;

        public string ProjectedEndDate { get; set; } = string.Empty;

        public string EndDate { get; set; } = string.Empty;

        public string Status { get; set; } = string.Empty;
    }
}
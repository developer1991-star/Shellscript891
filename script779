@page
@model PCPM.Pages.D158010Model
@{
    Layout = null;
    ViewData["Title"] = "D158010";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158010</title>

    <link rel="stylesheet" href="~/css/pcpm-terminal.css" />

    <style>
        .security-screen {
            max-width: 1000px;
            margin: 0 auto;
        }

        .security-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 28px;
        }

        .security-table th {
            text-align: left;
            padding: 5px 6px 10px 6px;
            font-weight: 700;
        }

        .security-table td {
            padding: 5px 6px;
            height: 25px;
            vertical-align: middle;
        }

        .security-select-col {
            width: 100px;
            text-align: center;
        }

        .security-user-col {
            width: 170px;
        }

        .security-name-col {
            width: auto;
        }

        .security-selection {
            width: 28px;
            text-align: center;
            text-transform: uppercase;
        }

        .instruction-row {
            margin-top: 30px;
            margin-left: 80px;
        }

        .security-function-keys {
            margin-top: 15px;
            padding-top: 12px;
            border-top: 2px solid #555;
            display: flex;
            gap: 20px;
            align-items: center;
            white-space: nowrap;
        }

        .security-function-keys .function-button {
            font-weight: 700;
        }

        .hidden-submit {
            position: absolute;
            left: -10000px;
            top: -10000px;
            width: 1px;
            height: 1px;
        }

        .security-error {
            margin-top: 14px;
            min-height: 24px;
            color: #b00020;
            font-weight: 700;
        }

        .name-value {
            display: inline-block;
            min-width: 120px;
        }
    </style>
</head>

<body>
<div class="pcpm-screen security-screen">

    <form method="post" autocomplete="off" id="d158010Form">

        <!-- Makes ENTER perform the normal post rather than invoking F1 -->
        <button type="submit"
                class="hidden-submit"
                tabindex="-1"
                aria-hidden="true">
        </button>

        <input type="hidden" asp-for="PageIndex" />
        <input type="hidden" asp-for="DisplayDate" />

        <!-- HEADER -->
        <div class="header-grid">

            <div>
                <div class="field-group">
                    <label asp-for="Action">ACTION</label>

                    <input asp-for="Action"
                           maxlength="3"
                           class="terminal-dynamic-input action"
                           autocomplete="off"
                           autofocus />
                </div>
            </div>

            <div class="header-center">
                <div>ARDOT PRE-CONSTRUCTION PROJECT MONITORING</div>

                <div class="screen-row">
                    SECURITY BROWSE PANEL
                </div>
            </div>

            <div class="header-right">
                <div>D158010</div>
                <div class="screen-row">@Model.DisplayDate</div>
            </div>

        </div>

        <div class="screen-row">
            SCREEN&nbsp;&nbsp;&nbsp;&nbsp;010
        </div>

        <div class="separator"></div>

        <!-- SECURITY BROWSE ROWS -->
        <table class="security-table">
            <thead>
                <tr>
                    <th class="security-select-col">SELECT</th>
                    <th class="security-user-col">USER ID</th>
                    <th class="security-name-col">NAME</th>
                </tr>
            </thead>

            <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                <tr>
                    <td class="security-select-col">

                        <input type="hidden"
                               asp-for="Rows[i].UserId" />

                        <input type="hidden"
                               asp-for="Rows[i].LastName" />

                        <input type="hidden"
                               asp-for="Rows[i].FirstName" />

                        <input asp-for="Rows[i].Selection"
                               maxlength="1"
                               class="terminal-dynamic-input security-selection"
                               autocomplete="off" />
                    </td>

                    <td class="security-user-col">
                        @Model.Rows[i].UserId
                    </td>

                    <td class="security-name-col">
                        <span class="name-value">
                            @Model.Rows[i].LastName
                        </span>
                        <span>
                            @Model.Rows[i].FirstName
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <div class="instruction-row">
            ENTER 'S' IN THE SELECTION FIELD TO UPDATE SECURITY ACCESS
        </div>

        <!-- FUNCTION KEYS -->
        <div class="security-function-keys">

            <button type="submit"
                    asp-page-handler="Help"
                    id="btnF1"
                    class="function-button">
                F1=HELP
            </button>

            <button type="submit"
                    asp-page-handler="Previous"
                    id="btnF3"
                    class="function-button">
                F3=PREV
            </button>

            <button type="submit"
                    asp-page-handler="Reset"
                    id="btnF6"
                    class="function-button">
                F6=RESET
            </button>

            <button type="submit"
                    asp-page-handler="Backward"
                    id="btnF7"
                    class="function-button">
                F7=BKWRD
            </button>

            <button type="submit"
                    asp-page-handler="Forward"
                    id="btnF8"
                    class="function-button">
                F8=FRWRD
            </button>

            <button type="submit"
                    asp-page-handler="MainMenu"
                    id="btnF12"
                    class="function-button">
                F12=MAIN
            </button>

        </div>

        <div class="security-error">
            @Model.ErrorMessage
        </div>

    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Legacy screens force terminal entry fields to upper case.
        document.querySelectorAll(
            "#d158010Form input[type='text']"
        ).forEach(function (input) {

            input.addEventListener("input", function () {
                const start = this.selectionStart;
                const end = this.selectionEnd;

                this.value = this.value.toUpperCase();

                if (start !== null && end !== null) {
                    this.setSelectionRange(start, end);
                }
            });
        });

        document.addEventListener("keydown", function (event) {

            let button = null;

            switch (event.key) {
                case "F1":
                    button = document.getElementById("btnF1");
                    break;

                case "F3":
                    button = document.getElementById("btnF3");
                    break;

                case "F6":
                    button = document.getElementById("btnF6");
                    break;

                case "F7":
                    button = document.getElementById("btnF7");
                    break;

                case "F8":
                    button = document.getElementById("btnF8");
                    break;

                case "F12":
                    button = document.getElementById("btnF12");
                    break;
            }

            if (button) {
                event.preventDefault();
                button.click();
            }
        });
    });
</script>

</body>
</html>





using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158010Model : PageModel
{
    private const int RowsPerPage = 13;

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string DisplayDate { get; set; } = string.Empty;

    [BindProperty(SupportsGet = true)]
    public int PageIndex { get; set; }

    [BindProperty]
    public List<SecurityBrowseRow> Rows { get; set; } = new();

    public string ErrorMessage { get; set; } = string.Empty;

    public async Task OnGetAsync()
    {
        DisplayDate = DateTime.Now.ToString("MM/dd/yyyy");

        if (PageIndex < 0)
        {
            PageIndex = 0;
        }

        await LoadRowsAsync();
    }

    /// <summary>
    /// ENTER / normal form submission.
    /// </summary>
    public async Task<IActionResult> OnPostAsync()
    {
        NormalizeInput();

        /*
         * ACTION has priority when entered.
         *
         * Legacy help defines:
         *   SO  = sign off
         *   NNN = direct navigation
         */
        if (!string.IsNullOrWhiteSpace(Action))
        {
            return ProcessAction();
        }

        var enteredSelections = Rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Selection))
            .ToList();

        if (enteredSelections.Count == 0)
        {
            ErrorMessage = "SELECTION NOT SPECIFIED";
            EnsureThirteenRows();
            return Page();
        }

        if (enteredSelections.Count > 1)
        {
            ErrorMessage = "ONLY ONE SELECTION MAY BE ENTERED";
            EnsureThirteenRows();
            return Page();
        }

        var selected = enteredSelections[0];

        if (!string.Equals(
                selected.Selection,
                "S",
                StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "ENTER 'S' IN THE SELECTION FIELD";
            EnsureThirteenRows();
            return Page();
        }

        if (string.IsNullOrWhiteSpace(selected.UserId))
        {
            ErrorMessage = "INVALID SECURITY RECORD SELECTION";
            EnsureThirteenRows();
            return Page();
        }

        /*
         * D158010 says:
         *
         * "ENTER 'S' IN THE SELECTION FIELD TO UPDATE SECURITY ACCESS"
         *
         * D158020 exists as the corresponding security screen in the
         * PCPM menu set, so this is the migration routing assumption.
         *
         * If the main business COBOL uses a different transition,
         * change only this redirect.
         */
        return RedirectToPage(
            "/D158020",
            new
            {
                userId = selected.UserId
            });
    }

    public IActionResult OnPostHelp()
    {
        /*
         * D158999 is the generic PCPM help panel.
         *
         * The legacy program normally carries the helped screen number
         * through its passing-file state. In Razor we pass 010 explicitly.
         */
        return RedirectToPage(
            "/D158999",
            new
            {
                screen = "010"
            });
    }

    public IActionResult OnPostPrevious()
    {
        /*
         * D158010 is launched from the PCPM main menu.
         *
         * Once PreviousScreen is wired through the exact working
         * PcpmSessionService API, this handler can use that value instead.
         */
        return RedirectToPage("/D158000");
    }

    public IActionResult OnPostReset()
    {
        /*
         * Legacy F6 refreshes/reset fields on the current panel.
         * Redirecting gives us a clean GET while retaining the current
         * browse page.
         */
        return RedirectToPage(
            "/D158010",
            new
            {
                pageIndex = PageIndex
            });
    }

    public IActionResult OnPostBackward()
    {
        var newPage = Math.Max(0, PageIndex - 1);

        return RedirectToPage(
            "/D158010",
            new
            {
                pageIndex = newPage
            });
    }

    public IActionResult OnPostForward()
    {
        return RedirectToPage(
            "/D158010",
            new
            {
                pageIndex = PageIndex + 1
            });
    }

    public IActionResult OnPostMainMenu()
    {
        return RedirectToPage("/D158000");
    }

    private IActionResult ProcessAction()
    {
        var action = Normalize(Action);

        if (action == "SO")
        {
            /*
             * Do not guess the application's logout/session-destruction
             * implementation here.
             *
             * Replace this when the migrated PCPM sign-off handler is
             * available.
             */
            ErrorMessage = "SIGN OFF FUNCTION IS NOT YET WIRED";
            EnsureThirteenRows();

            return Page();
        }

        if (int.TryParse(action, out var panelNumber) &&
            panelNumber >= 0 &&
            panelNumber <= 999)
        {
            var targetPage = $"/D158{panelNumber:000}";

            return RedirectToPage(targetPage);
        }

        ErrorMessage = "INVALID ACTION CODE";
        EnsureThirteenRows();

        return Page();
    }

    private async Task LoadRowsAsync()
    {
        Rows.Clear();

        /*
         * ==========================================================
         * DATABASE / REPOSITORY WIRING GOES HERE
         * ==========================================================
         *
         * D158010.aspx and D158010.aspx.cbl define the presentation
         * contract but do not contain the business-program SQL/read
         * logic that supplies these records.
         *
         * When that COBOL or the table/view mapping is available,
         * replace this section with something like:
         *
         * var result = await _securityRepository.GetSecurityUsersAsync(
         *     PageIndex,
         *     RowsPerPage);
         *
         * Rows = result.Select(x => new SecurityBrowseRow
         * {
         *     UserId = x.UserId,
         *     LastName = x.LastName,
         *     FirstName = x.FirstName
         * }).ToList();
         *
         * Do not invent the physical database table/column names here.
         */

        await Task.CompletedTask;

        EnsureThirteenRows();
    }

    private void EnsureThirteenRows()
    {
        Rows ??= new List<SecurityBrowseRow>();

        while (Rows.Count < RowsPerPage)
        {
            Rows.Add(new SecurityBrowseRow());
        }

        if (Rows.Count > RowsPerPage)
        {
            Rows = Rows
                .Take(RowsPerPage)
                .ToList();
        }
    }

    private void NormalizeInput()
    {
        Action = Normalize(Action);

        Rows ??= new List<SecurityBrowseRow>();

        foreach (var row in Rows)
        {
            row.Selection = Normalize(row.Selection);
            row.UserId = Normalize(row.UserId);
            row.LastName = Normalize(row.LastName);
            row.FirstName = Normalize(row.FirstName);
        }

        EnsureThirteenRows();
    }

    private static string Normalize(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();
    }

    public class SecurityBrowseRow
    {
        public string Selection { get; set; } = string.Empty;

        public string UserId { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public string FirstName { get; set; } = string.Empty;
    }
}

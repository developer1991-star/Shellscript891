@page
@model PCPM.Pages.D158915Model

@{
    Layout = null;
    ViewData["Title"] = "D158915";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158915</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            background: #F2F3FF;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            color: #111;
        }

        .screen {
            position: relative;
            width: 800px;
            height: 620px;
            margin: 0 auto;
        }

        .abs {
            position: absolute;
            white-space: pre;
        }

        .field {
            position: absolute;
            height: 23px;
            box-sizing: border-box;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            padding: 1px 3px;
            border: 1px solid #777;
            background: #fff;
            text-transform: uppercase;
            border-radius: 0;
        }

        .field:focus {
            background: yellow;
            outline: none;
        }

        .readonly {
            background: LightGray;
        }

        .pf {
            position: absolute;
            border: 0;
            background: transparent;
            padding: 0;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            white-space: pre;
        }

        .error {
            color: red;
        }
    </style>
</head>

<body>
<form method="post" id="legacyForm">
    @Html.AntiForgeryToken()

    <div class="screen">

        <div class="abs error" style="left:20px; top:1px;">
            @Model.OfflineMessage
        </div>

        <div class="abs" style="left:10px; top:25px;">ACTION</div>

        <input name="Action"
               value="@Model.Action"
               maxlength="3"
               tabindex="1"
               class="field"
               style="left:90px; top:25px; width:34px;" />

        <div class="abs" style="left:200px; top:25px;">
            ARDOT PCPM         (PROJECT STATUS MODULE)
        </div>

        <div class="abs" style="left:710px; top:25px;">D158915</div>

        <div class="abs" style="left:10px; top:50px;">SCREEN</div>
        <div class="abs" style="left:90px; top:50px;">915</div>

        <div class="abs" style="left:290px; top:50px;">
            JOB NUMBER BROWSE PANEL
        </div>

        <div class="abs" style="left:680px; top:50px;">
            @Model.DateText
        </div>

        <div class="abs" style="left:10px; top:75px;">
            =============================================================================
        </div>

        <div class="abs" style="left:200px; top:100px;">
            BROWSE (OTHER THAN PROGRAMMED JOBS)
        </div>

        <div class="abs" style="left:10px; top:125px;">
            JOB NUMBER
        </div>

        <input name="WorkingJobNumber"
               value="@Model.WorkingJobNumber"
               maxlength="10"
               readonly
               tabindex="2"
               class="field readonly"
               style="left:130px; top:125px; width:80px;" />

        <div class="abs" style="left:250px; top:125px;">
            JOB SEQUENCE
        </div>

        <input name="WorkingJobSequence"
               value="@Model.WorkingJobSequence"
               maxlength="2"
               readonly
               tabindex="3"
               class="field readonly"
               style="left:390px; top:125px; width:26px;" />

        <div class="abs" style="left:10px; top:150px;">
            -----------------------------------------------------------------------------
        </div>

        <div class="abs" style="left:100px; top:175px;">JOB</div>
        <div class="abs" style="left:190px; top:175px;">DIST</div>

        <div class="abs" style="left:10px; top:200px;">S</div>
        <div class="abs" style="left:30px; top:200px;"> NUMBER  </div>
        <div class="abs" style="left:130px; top:200px;">SEQ ST</div>
        <div class="abs" style="left:230px; top:200px;">CO</div>
        <div class="abs" style="left:260px; top:200px;">RTE</div>
        <div class="abs" style="left:300px; top:200px;">SEC</div>
        <div class="abs" style="left:450px; top:200px;">JOB NAME</div>

        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var row = Model.Rows[i];
            var top = 225 + (i * 25);

            <input name="Rows[@i].Selection"
                   value="@row.Selection"
                   maxlength="1"
                   tabindex="@(4 + i)"
                   class="field"
                   style="left:10px; top:@(top)px; width:18px;" />

            <div class="abs" style="left:30px; top:@(top)px;">@row.JobNumber</div>
            <div class="abs" style="left:140px; top:@(top)px;">@row.JobSequence</div>
            <div class="abs" style="left:170px; top:@(top)px;">@row.Status</div>
            <div class="abs" style="left:200px; top:@(top)px;">@row.District</div>
            <div class="abs" style="left:230px; top:@(top)px;">@row.County</div>
            <div class="abs" style="left:260px; top:@(top)px;">@row.Route</div>
            <div class="abs" style="left:300px; top:@(top)px;">@row.Section</div>
            <div class="abs" style="left:340px; top:@(top)px;">@row.JobName</div>
        }

        <div class="abs" style="left:70px; top:500px;">
            ENTER 'A' 'S' 'I' 'D' OR 'U' IN THE SELECTION FIELD, PRESS ENTER
        </div>

        <div class="abs" style="left:10px; top:525px;">
            -----------------------------------------------------------------------------
        </div>

        <button type="submit"
                name="command"
                value="F1"
                class="pf"
                style="left:10px; top:550px;"> F1=HELP</button>

        <button type="submit"
                name="command"
                value="F3"
                class="pf"
                style="left:100px; top:550px;"> F3=PREVIOUS</button>

        <button type="submit"
                name="command"
                value="F6"
                class="pf"
                style="left:230px; top:550px;"> F6=RESET</button>

        <button type="submit"
                name="command"
                value="F7"
                class="pf"
                style="left:330px; top:550px;"> F7=BACKWARD</button>

        <button type="submit"
                name="command"
                value="F8"
                class="pf"
                style="left:460px; top:550px;"> F8=FORWARD</button>

        <button type="submit"
                name="command"
                value="F12"
                class="pf"
                style="left:580px; top:550px;"> F12=MAIN MENU</button>

        <div class="abs error"
             style="left:10px; top:575px;">
            @Model.ErrorMessage
        </div>

    </div>
</form>

<script>
    document.querySelectorAll(".field:not([readonly])")
        .forEach(function (field) {
            field.addEventListener("input", function () {
                this.value = this.value.toUpperCase();
            });
        });

    document.addEventListener("keydown", function (event) {
        const keys = ["F1", "F3", "F6", "F7", "F8", "F12"];

        if (!keys.includes(event.key))
            return;

        event.preventDefault();

        const form = document.getElementById("legacyForm");
        const field = document.createElement("input");

        field.type = "hidden";
        field.name = "command";
        field.value = event.key;

        form.appendChild(field);
        form.submit();
    });
</script>
</body>
</html>



using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158915Model : PageModel
{
    private static readonly HashSet<string> ValidSelections =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "A",
            "S",
            "I",
            "D",
            "U"
        };

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string WorkingJobNumber { get; set; } = string.Empty;

    [BindProperty]
    public string WorkingJobSequence { get; set; } = string.Empty;

    [BindProperty]
    public List<JobBrowseRow> Rows { get; set; } = CreateRows();

    public string DateText { get; set; } = string.Empty;

    public string ErrorMessage { get; set; } = string.Empty;

    public string OfflineMessage { get; set; } = string.Empty;

    public async Task OnGetAsync(
        string? jobNo = null,
        string? jobSeq = null)
    {
        DateText = DateTime.Today.ToString("MM/dd/yyyy");

        WorkingJobNumber = Normalize(jobNo, 10);
        WorkingJobSequence = Normalize(jobSeq, 2);

        EnsureRows();

        await LoadRowsAsync();
    }

    public async Task<IActionResult> OnPostAsync(string? command)
    {
        Action = Normalize(Action, 3);
        WorkingJobNumber = Normalize(WorkingJobNumber, 10);
        WorkingJobSequence = Normalize(WorkingJobSequence, 2);

        EnsureRows();

        foreach (var row in Rows)
            row.Selection = Normalize(row.Selection, 1);

        await LoadRowsAsync();

        switch (command?.ToUpperInvariant())
        {
            case "F6":
                foreach (var row in Rows)
                    row.Selection = string.Empty;

                ErrorMessage = string.Empty;
                return Page();

            case "F7":
                await LoadPreviousPageAsync();
                return Page();

            case "F8":
                await LoadNextPageAsync();
                return Page();

            case "F12":
                return RedirectToPage("/D158000");

            case "F3":
                return PreviousOrMain();

            case "F1":
                ErrorMessage =
                    "TODO: wire D158915 help processing to the migrated help screen.";
                return Page();
        }

        var selected = Rows
            .Select((row, index) => new
            {
                Row = row,
                Index = index
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Row.Selection))
            .ToList();

        if (selected.Count > 1)
        {
            ErrorMessage = "ONLY ONE SELECTION MAY BE ENTERED";
            return Page();
        }

        if (selected.Count == 1)
        {
            var selectedRow = selected[0];

            if (!ValidSelections.Contains(selectedRow.Row.Selection))
            {
                ErrorMessage =
                    "ENTER 'A' 'S' 'I' 'D' OR 'U' IN THE SELECTION FIELD";

                return Page();
            }

            /*
             * TODO:
             * Dispatch the selected job and operation through the Application
             * layer using the routing defined by the D158915 main COBOL.
             *
             * Do not guess A/S/I/D/U destination panels here.
             */
        }

        return Page();
    }

    private async Task LoadRowsAsync()
    {
        /*
         * TODO:
         * Repository/Application service should load the ten displayed jobs.
         *
         * Display-only values:
         *   JobNumber
         *   JobSequence
         *   Status
         *   District
         *   County
         *   Route
         *   Section
         *   JobName
         *
         * D158915 wrapper PIC sizes:
         *
         * SELECT    X(1)
         * JOBNO     X(10)
         * JOBSEQ    X(2)
         * STATUS    X(2)
         * DIST      X(2)
         * CO        X(2)
         * RTE       X(3)
         * SEC       X(3)
         * JOBNAM    X(45)
         */

        EnsureRows();

        await Task.CompletedTask;
    }

    private async Task LoadPreviousPageAsync()
    {
        // TODO: implement F7 BACKWARD from the main business COBOL.
        ErrorMessage = "TODO: D158915 backward browse.";

        await Task.CompletedTask;
    }

    private async Task LoadNextPageAsync()
    {
        // TODO: implement F8 FORWARD from the main business COBOL.
        ErrorMessage = "TODO: D158915 forward browse.";

        await Task.CompletedTask;
    }

    private IActionResult PreviousOrMain()
    {
        var referer = Request.Headers.Referer.ToString();

        if (Uri.TryCreate(referer, UriKind.Absolute, out var uri) &&
            string.Equals(
                uri.Authority,
                Request.Host.Value,
                StringComparison.OrdinalIgnoreCase))
        {
            return LocalRedirect(uri.PathAndQuery);
        }

        return RedirectToPage("/D158000");
    }

    private void EnsureRows()
    {
        Rows ??= new List<JobBrowseRow>();

        while (Rows.Count < 10)
            Rows.Add(new JobBrowseRow());

        if (Rows.Count > 10)
            Rows = Rows.Take(10).ToList();
    }

    private static List<JobBrowseRow> CreateRows()
    {
        return Enumerable.Range(0, 10)
            .Select(_ => new JobBrowseRow())
            .ToList();
    }

    private static string Normalize(string? value, int maxLength)
    {
        var result = (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        return result.Length <= maxLength
            ? result
            : result[..maxLength];
    }

    public sealed class JobBrowseRow
    {
        public string Selection { get; set; } = string.Empty;

        public string JobNumber { get; set; } = string.Empty;

        public string JobSequence { get; set; } = string.Empty;

        public string Status { get; set; } = string.Empty;

        public string District { get; set; } = string.Empty;

        public string County { get; set; } = string.Empty;

        public string Route { get; set; } = string.Empty;

        public string Section { get; set; } = string.Empty;

        public string JobName { get; set; } = string.Empty;
    }
}

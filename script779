using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158800Model : PageModel
{
    private const string ScreenName = "D158800";

    // ============================================================
    // Screen fields
    // ============================================================

    [BindProperty]
    public string Action { get; set; } = string.Empty;


    public string DateText { get; private set; } = string.Empty;


    /*
     * ASPX:
     *   S_FA MaxLength 2, readonly, LightGray
     *
     * Wrapper:
     *   FA PIC X(2), initial attr PSL
     */
    [BindProperty(SupportsGet = true)]
    public string FunctionalArea { get; set; } = string.Empty;


    /*
     * FA-TRANS is a protected 14-character output field.
     */
    [BindProperty]
    public string FunctionalAreaDescription { get; set; } = string.Empty;


    /*
     * USRID is a protected/display-only PIC X(7).
     */
    [BindProperty(SupportsGet = true)]
    public string UserId { get; set; } = string.Empty;


    [BindProperty]
    public string Sel1 { get; set; } = string.Empty;

    [BindProperty]
    public string Sel2 { get; set; } = string.Empty;

    [BindProperty]
    public string Sel3 { get; set; } = string.Empty;

    [BindProperty]
    public string Sel4 { get; set; } = string.Empty;


    public string ErrorMessage { get; set; } = string.Empty;


    // ============================================================
    // Dynamic visibility
    // ============================================================

    /*
     * PF1/PF3/PF12 start PSL, therefore visible.
     *
     * ENTER-KEY starts PSI, therefore hidden.
     *
     * The legacy business program can dynamically change these
     * attributes. Until that business COBOL is migrated, these
     * defaults reproduce the wrapper's initial state.
     */
    public bool ShowF1 { get; set; } = true;

    public bool ShowF3 { get; set; } = true;

    public bool ShowF12 { get; set; } = true;

    public bool ShowEnterKey { get; set; } = false;


    // ============================================================
    // GET
    // ============================================================

    public void OnGet()
    {
        PreparePage();

        /*
         * D158800 receives FA/user context from the surrounding PCPM
         * application. If the existing D158000/IPcpmSessionService
         * implementation supplies these values, load them here using
         * that exact API.
         *
         * SupportsGet also allows this page to receive:
         *
         * /D158800?functionalArea=RD&userId=USER123
         *
         * without inventing a dependency on an unknown session API.
         */

        FunctionalArea =
            Normalize(FunctionalArea);

        UserId =
            Normalize(UserId);
    }


    // ============================================================
    // ENTER / ACCEPT
    // ============================================================

    public IActionResult OnPost()
    {
        PreparePage();

        NormalizeInput();


        /*
         * ACTION is separate from the four selection fields.
         */
        if (!string.IsNullOrWhiteSpace(Action))
        {
            var actionResult =
                ProcessAction();

            if (actionResult != null)
            {
                return actionResult;
            }
        }


        var selections = new[]
        {
            Sel1,
            Sel2,
            Sel3,
            Sel4
        };


        var selected = selections
            .Select((value, index) => new
            {
                Value = value,
                Index = index
            })
            .Where(x =>
                !string.IsNullOrWhiteSpace(x.Value))
            .ToList();


        if (selected.Count == 0)
        {
            ErrorMessage =
                "SELECTION NOT SPECIFIED";

            return Page();
        }


        if (selected.Count > 1)
        {
            ErrorMessage =
                "ONLY ONE SELECTION MAY BE SPECIFIED";

            return Page();
        }


        if (!string.Equals(
                selected[0].Value,
                "S",
                StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage =
                "ENTER 'S' IN THE SELECTION FIELD";

            return Page();
        }


        /*
         * These destination screen numbers are explicit in
         * D158800.aspx.
         */
        return selected[0].Index switch
        {
            0 => GoToRemarkScreen("/D158801"),
            1 => GoToRemarkScreen("/D158802"),
            2 => GoToRemarkScreen("/D158803"),
            3 => GoToRemarkScreen("/D158804"),

            _ => Page()
        };
    }


    // ============================================================
    // PF KEYS
    // ============================================================

    public IActionResult OnPostHelp()
    {
        /*
         * D158999 is the generic help screen already identified
         * in this migration.
         */
        return RedirectToPage(
            "/D158999",
            new
            {
                hScreen = "800"
            });
    }


    public IActionResult OnPostPrevious()
    {
        /*
         * D158800 is a main-menu option from D158000.
         *
         * When this PageModel is wired to the exact same
         * IPcpmSessionService API used by the working D158000,
         * this can use PreviousScreen instead.
         */
        return RedirectToPage("/D158000");
    }


    public IActionResult OnPostReset()
    {
        /*
         * Legacy F6 resets the entry fields while retaining
         * the screen's context.
         */
        return RedirectToPage(
            "/D158800",
            new
            {
                functionalArea =
                    FunctionalArea,

                userId =
                    UserId
            });
    }


    public IActionResult OnPostMainMenu()
    {
        return RedirectToPage("/D158000");
    }


    // ============================================================
    // ACTION
    // ============================================================

    private IActionResult? ProcessAction()
    {
        Action = Normalize(Action);


        if (string.IsNullOrWhiteSpace(Action))
        {
            return null;
        }


        /*
         * The wrapper explicitly handles the different case forms
         * of "SO" by converting them to uppercase.
         *
         * The actual sign-off business operation is not contained
         * in D158800.aspx.cbl, so we do not fabricate logout logic.
         */
        if (Action == "SO")
        {
            ErrorMessage =
                "SIGN OFF FUNCTION IS NOT YET WIRED";

            return Page();
        }


        /*
         * PCPM screens support three-digit direct panel navigation.
         * The business COBOL should ultimately remain authoritative
         * for the exact list of permitted panels.
         */
        if (Action.Length == 3 &&
            Action.All(char.IsDigit))
        {
            return RedirectToPage(
                "/D158" + Action);
        }


        ErrorMessage =
            "INVALID ACTION";

        return Page();
    }


    // ============================================================
    // DESTINATION ROUTING
    // ============================================================

    private IActionResult GoToRemarkScreen(
        string page)
    {
        /*
         * Carry the D158800 context into the child panel.
         *
         * Once all pages use the existing PcpmSessionService,
         * these values can instead be read from that server-side
         * session state.
         */
        return RedirectToPage(
            page,
            new
            {
                functionalArea =
                    FunctionalArea,

                userId =
                    UserId
            });
    }


    // ============================================================
    // PAGE STATE
    // ============================================================

    private void PreparePage()
    {
        DateText =
            DateTime.Now.ToString("MM/dd/yyyy");


        /*
         * Initial wrapper attributes:
         *
         * PF1-KEY    PSL -> visible
         * PF3-KEY    PSL -> visible
         * PF12-KEY   PSL -> visible
         * ENTER-KEY  PSI -> invisible
         *
         * PF6 has no dynamic hide logic in the supplied wrapper.
         */
        ShowF1 = true;
        ShowF3 = true;
        ShowF12 = true;
        ShowEnterKey = false;
    }


    private void NormalizeInput()
    {
        Action =
            Limit(Normalize(Action), 3);

        FunctionalArea =
            Limit(Normalize(FunctionalArea), 2);

        UserId =
            Limit(Normalize(UserId), 7);

        Sel1 =
            Limit(Normalize(Sel1), 1);

        Sel2 =
            Limit(Normalize(Sel2), 1);

        Sel3 =
            Limit(Normalize(Sel3), 1);

        Sel4 =
            Limit(Normalize(Sel4), 1);
    }


    private static string Normalize(
        string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();
    }


    private static string Limit(
        string value,
        int maxLength)
    {
        if (value.Length <= maxLength)
        {
            return value;
        }

        return value[..maxLength];
    }
}





@page
@model PCPM.Pages.D158800Model

@{
    Layout = null;
    ViewData["Title"] = "D158800";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158800</title>

    <link rel="stylesheet"
          href="~/css/pcpm-terminal.css"
          asp-append-version="true" />

    <style>
        .remark-menu-screen {
            width: 800px;
            margin: 0 auto;
        }

        .remark-header {
            display: grid;
            grid-template-columns: 160px 1fr 140px;
            align-items: start;
        }

        .remark-center {
            text-align: center;
        }

        .remark-right {
            text-align: right;
        }

        .context-row {
            display: grid;
            grid-template-columns: 160px 55px 1fr 90px 90px;
            align-items: center;
            margin-top: 28px;
        }

        .fa-field {
            width: 40px;
            text-align: center;
        }

        .protected-field {
            background-color: lightgray !important;
        }

        .remark-table {
            width: 520px;
            margin: 32px auto 0 auto;
            border-collapse: collapse;
        }

        .remark-table th {
            text-align: left;
            padding: 5px 8px 18px 8px;
        }

        .remark-table td {
            padding: 13px 8px;
            vertical-align: middle;
        }

        .remark-select-column {
            width: 80px;
            text-align: center;
        }

        .remark-title-column {
            width: 300px;
        }

        .remark-screen-column {
            width: 100px;
            text-align: center;
        }

        .remark-select {
            width: 28px;
            text-align: center;
            text-transform: uppercase;
        }

        .remark-instruction {
            margin-top: 38px;
            text-align: center;
        }

        .remark-functions {
            margin-top: 55px;
            padding-top: 12px;
            border-top: 2px solid #555;

            display: flex;
            align-items: center;
            gap: 25px;

            white-space: nowrap;
        }

        .enter-label {
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
        }

        .hidden-enter {
            position: absolute;
            left: -10000px;
            top: -10000px;
            width: 1px;
            height: 1px;
        }

        .remark-error {
            min-height: 25px;
            margin-top: 14px;
            color: #b00020;
            font-weight: 700;
        }
    </style>
</head>

<body>

<div class="pcpm-screen remark-menu-screen">

    <form method="post"
          id="d158800Form"
          autocomplete="off">

        <!-- Makes normal ENTER perform OnPost rather than a PF handler. -->
        <button type="submit"
                class="hidden-enter"
                tabindex="-1"
                aria-hidden="true">
            ENTER
        </button>

        <!-- Preserve the display context during a post. -->
        <input type="hidden" asp-for="FunctionalAreaDescription" />
        <input type="hidden" asp-for="UserId" />

        <!-- ======================================================
             HEADER
             ====================================================== -->

        <div class="remark-header">

            <div class="field-group">
                <label asp-for="Action">ACTION</label>

                <input asp-for="Action"
                       maxlength="3"
                       tabindex="1"
                       class="terminal-dynamic-input action"
                       autocomplete="off"
                       autofocus />
            </div>

            <div class="remark-center">
                ARDOT PRE-CONSTRUCTION PROJECT MONITORING
            </div>

            <div class="remark-right">
                D158800
            </div>

        </div>


        <div class="remark-header screen-row">

            <div>
                SCREEN&nbsp;&nbsp;&nbsp;&nbsp;800
            </div>

            <div class="remark-center">
                STANDARD REMARK MAINTENANCE PANEL
            </div>

            <div class="remark-right">
                @Model.DateText
            </div>

        </div>


        <div class="separator"></div>


        <!-- ======================================================
             FUNCTIONAL AREA / USER
             ====================================================== -->

        <div class="context-row">

            <div>
                FUNCTIONAL AREA
            </div>

            <div>
                <input asp-for="FunctionalArea"
                       maxlength="2"
                       tabindex="2"
                       readonly
                       class="terminal-dynamic-input fa-field protected-field" />
            </div>

            <div>
                @Model.FunctionalAreaDescription
            </div>

            <div>
                USER ID
            </div>

            <div>
                @Model.UserId
            </div>

        </div>


        <!-- ======================================================
             MENU
             ====================================================== -->

        <table class="remark-table">
            <thead>
            <tr>
                <th class="remark-select-column">
                    SEL
                </th>

                <th class="remark-title-column">
                    TITLE
                </th>

                <th class="remark-screen-column">
                    SCREEN
                </th>
            </tr>
            </thead>

            <tbody>

            <tr>
                <td class="remark-select-column">
                    <input asp-for="Sel1"
                           maxlength="1"
                           tabindex="3"
                           class="terminal-dynamic-input remark-select"
                           autocomplete="off" />
                </td>

                <td>
                    ADD STANDARD REMARK
                </td>

                <td class="remark-screen-column">
                    801
                </td>
            </tr>


            <tr>
                <td class="remark-select-column">
                    <input asp-for="Sel2"
                           maxlength="1"
                           tabindex="4"
                           class="terminal-dynamic-input remark-select"
                           autocomplete="off" />
                </td>

                <td>
                    UPDATE STANDARD REMARK
                </td>

                <td class="remark-screen-column">
                    802
                </td>
            </tr>


            <tr>
                <td class="remark-select-column">
                    <input asp-for="Sel3"
                           maxlength="1"
                           tabindex="5"
                           class="terminal-dynamic-input remark-select"
                           autocomplete="off" />
                </td>

                <td>
                    INQUIRY STANDARD REMARKS
                </td>

                <td class="remark-screen-column">
                    803
                </td>
            </tr>


            <tr>
                <td class="remark-select-column">
                    <input asp-for="Sel4"
                           maxlength="1"
                           tabindex="6"
                           class="terminal-dynamic-input remark-select"
                           autocomplete="off" />
                </td>

                <td>
                    DELETE STANDARD REMARK
                </td>

                <td class="remark-screen-column">
                    804
                </td>
            </tr>

            </tbody>
        </table>


        <div class="remark-instruction">
            ENTER 'S' IN THE SELECTION FIELD, PRESS ENTER
        </div>


        <!-- ======================================================
             FUNCTION KEYS
             ====================================================== -->

        <div class="remark-functions">

            @if (Model.ShowF1)
            {
                <button type="submit"
                        asp-page-handler="Help"
                        id="pf1"
                        class="function-button">
                    F1=HELP
                </button>
            }

            @if (Model.ShowF3)
            {
                <button type="submit"
                        asp-page-handler="Previous"
                        id="pf3"
                        class="function-button">
                    F3=PREVIOUS
                </button>
            }

            <button type="submit"
                    asp-page-handler="Reset"
                    id="pf6"
                    class="function-button">
                F6=RESET
            </button>

            @if (Model.ShowF12)
            {
                <button type="submit"
                        asp-page-handler="MainMenu"
                        id="pf12"
                        class="function-button">
                    F12=MAIN MENU
                </button>
            }

            @if (Model.ShowEnterKey)
            {
                <span class="enter-label">
                    ENTER=ACCEPT
                </span>
            }

        </div>


        <div class="remark-error">
            @Model.ErrorMessage
        </div>

    </form>

</div>


<script>
    (() => {

        const form = document.getElementById("d158800Form");

        /*
         * Legacy Unload_Screen uppercases ACTION, FA and SEL1-SEL4.
         * FA is currently protected, so this mainly affects Action
         * and the four selection fields.
         */
        form.querySelectorAll(
            "input[type='text']:not([readonly])"
        ).forEach(function (input) {

            input.addEventListener("input", function () {

                const start = this.selectionStart;
                const end = this.selectionEnd;

                this.value =
                    this.value.toUpperCase();

                if (start !== null && end !== null) {
                    this.setSelectionRange(start, end);
                }
            });

        });


        /*
         * Preserve the terminal PF-key experience.
         */
        document.addEventListener("keydown", function (event) {

            let buttonId = null;

            switch (event.key) {

                case "F1":
                    buttonId = "pf1";
                    break;

                case "F3":
                    buttonId = "pf3";
                    break;

                case "F6":
                    buttonId = "pf6";
                    break;

                case "F12":
                    buttonId = "pf12";
                    break;
            }

            if (!buttonId) {
                return;
            }

            const button =
                document.getElementById(buttonId);

            if (!button) {
                return;
            }

            event.preventDefault();
            button.click();
        });

    })();
</script>

</body>
</html>



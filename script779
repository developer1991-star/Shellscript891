namespace PCPM.Application.D158302;

public interface ID158302Repository
{
    Task<D158302StatusRecord?> FindStatusAsync(
        string jobNumber,
        string functionalArea,
        CancellationToken cancellationToken = default);

    Task<D158302StatusRecord?> FindNextStatusAsync(
        string jobNumber,
        string functionalArea,
        CancellationToken cancellationToken = default);

    Task<D158302StatusRecord?> FindPreviousStatusAsync(
        string jobNumber,
        string functionalArea,
        CancellationToken cancellationToken = default);

    Task<string?> GetFunctionalAreaDescriptionAsync(
        string functionalArea,
        CancellationToken cancellationToken = default);

    Task<IReadOnlyList<D158302RemarkRecord>> GetInitialRemarksAsync(
        string jobNumber,
        string functionalArea,
        string historyFlag,
        CancellationToken cancellationToken = default);

    Task<IReadOnlyList<D158302RemarkRecord>> GetRemarksForwardAsync(
        string jobNumber,
        string functionalArea,
        string historyFlag,
        string lastUpdated,
        int remarkType,
        int remarkSequence,
        CancellationToken cancellationToken = default);

    Task<IReadOnlyList<D158302RemarkRecord>> GetRemarksBackwardAsync(
        string jobNumber,
        string functionalArea,
        string historyFlag,
        string lastUpdated,
        int remarkType,
        int remarkSequence,
        CancellationToken cancellationToken = default);

    Task<D158302RemarkRecord?> GetLatestRemarkAsync(
        string jobNumber,
        CancellationToken cancellationToken = default);

    Task<string?> GetMessageAsync(
        string messageId,
        CancellationToken cancellationToken = default);
}

namespace PCPM.Application.D158302;

public sealed class D158302StatusRecord
{
    public string JobNumber { get; set; } = "";
    public string FunctionalArea { get; set; } = "";
    public string FunctionalAreaStatus { get; set; } = "";
    public string PercentComplete { get; set; } = "";
    public string StartDate { get; set; } = "";
    public string ProjectedEndDate { get; set; } = "";
    public string EndDate { get; set; } = "";
    public string LastUpdated { get; set; } = "";
    public string UserId { get; set; } = "";
}

public sealed class D158302RemarkRecord
{
    public string JobNumber { get; set; } = "";
    public string FunctionalArea { get; set; } = "";

    public string Remark { get; set; } = "";
    public string LastUpdated { get; set; } = "";

    public int RemarkType { get; set; }
    public int RemarkSequence { get; set; }

    public string RemarkStatusFlag { get; set; } = "";
    public string RemarkDistributionFlag { get; set; } = "";

    public string HistoryFlag { get; set; } = "";
    public string UserId { get; set; } = "";
}

using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PCPM.Application.D158500;

namespace PCPM.Pages;

public class D158500Model : PageModel
{
    private readonly ID158500Service _service;

    public D158500Model(ID158500Service service)
    {
        _service = service;
    }

    // ============================================================
    // INPUT FIELDS
    // ============================================================

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string JobNumber { get; set; } = string.Empty;

    [BindProperty]
    public string Sf { get; set; } = string.Empty;

    [BindProperty]
    public string SelRem { get; set; } = string.Empty;

    [BindProperty]
    public List<string> Selections { get; set; } =
        Enumerable.Repeat(string.Empty, 11).ToList();


    // ============================================================
    // DISPLAY DATA
    // ============================================================

    public D158500Screen Screen { get; private set; } = new();


    // ============================================================
    // GET
    // ============================================================

    public async Task<IActionResult> OnGetAsync(
        string? jobNumber,
        CancellationToken cancellationToken)
    {
        jobNumber = Normalize(jobNumber);

        Screen = await _service.LoadAsync(
            string.IsNullOrWhiteSpace(jobNumber)
                ? null
                : jobNumber,
            cancellationToken);

        CopyScreenToPage();

        return Page();
    }


    // ============================================================
    // ENTER
    // ============================================================

    public async Task<IActionResult> OnPostAsync(
        CancellationToken cancellationToken)
    {
        NormalizeInputs();

        var input = BuildInput();

        var result = await _service.ProcessEnterAsync(
            input,
            cancellationToken);

        /*
         * IMPORTANT:
         *
         * ProcessEnterAsync owns the old COBOL navigation logic:
         *
         *   ACTION
         *   SF
         *   SELREM
         *   STATUS selections
         *   conflict detection
         *   S/I -> 302
         *   U   -> 202
         *   invalid selection
         *   selection not specified
         *
         * The Razor Page should not duplicate all of that logic.
         */

        Screen = result.Screen;

        CopyScreenToPage();

        /*
         * Navigate only when the service says that another
         * PCPM screen should be displayed.
         */
        if (!string.IsNullOrWhiteSpace(result.NextScreen))
        {
            return RedirectToPcpmScreen(result);
        }

        return Page();
    }


    // ============================================================
    // F1
    // ============================================================

    public IActionResult OnPostHelp()
    {
        return RedirectToPage(
            "/D158999",
            new
            {
                screen = "500",
                jobNumber = Normalize(JobNumber)
            });
    }


    // ============================================================
    // F3
    // ============================================================

    public IActionResult OnPostPrevious()
    {
        /*
         * Eventually this should use the PCPM previous-screen
         * value from your existing session service.
         *
         * Do not invent a new session key here.
         *
         * For now D158000 is the safe fallback.
         */
        return RedirectToPage("/D158000");
    }


    // ============================================================
    // F6 RESET
    // ============================================================

    public async Task<IActionResult> OnPostResetAsync(
        CancellationToken cancellationToken)
    {
        Screen = await _service.ResetAsync(
            cancellationToken);

        CopyScreenToPage();

        ClearSelections();

        Action = string.Empty;

        return Page();
    }


    // ============================================================
    // F7 BACKWARD
    // ============================================================

    public async Task<IActionResult> OnPostBackwardAsync(
        CancellationToken cancellationToken)
    {
        JobNumber = Normalize(JobNumber);

        if (string.IsNullOrWhiteSpace(JobNumber))
        {
            Screen = await _service.LoadAsync(
                null,
                cancellationToken);

            CopyScreenToPage();

            return Page();
        }

        Screen = await _service.ScrollBackwardAsync(
            JobNumber,
            cancellationToken);

        CopyScreenToPage();

        ClearSelections();

        return Page();
    }


    // ============================================================
    // F8 FORWARD
    // ============================================================

    public async Task<IActionResult> OnPostForwardAsync(
        CancellationToken cancellationToken)
    {
        JobNumber = Normalize(JobNumber);

        if (string.IsNullOrWhiteSpace(JobNumber))
        {
            Screen = await _service.LoadAsync(
                null,
                cancellationToken);

            CopyScreenToPage();

            return Page();
        }

        Screen = await _service.ScrollForwardAsync(
            JobNumber,
            cancellationToken);

        CopyScreenToPage();

        ClearSelections();

        return Page();
    }


    // ============================================================
    // F12 MAIN
    // ============================================================

    public IActionResult OnPostMain()
    {
        return RedirectToPage("/D158000");
    }


    // ============================================================
    // BUILD SERVICE INPUT
    // ============================================================

    private D158500Input BuildInput()
    {
        EnsureSelectionCount();

        return new D158500Input
        {
            Action = Normalize(Action),
            JobNumber = Normalize(JobNumber),
            Sf = Normalize(Sf),
            SelRem = Normalize(SelRem),

            Selections = Selections
                .Select(Normalize)
                .ToList()
        };
    }


    // ============================================================
    // SCREEN -> PAGE
    // ============================================================

    private void CopyScreenToPage()
    {
        /*
         * JobNumber is kept as the PageModel-bound property
         * because it is posted back by the Razor form.
         */

        JobNumber = Screen.JobNumber?.Trim() ?? string.Empty;

        EnsureSelectionCount();
    }


    // ============================================================
    // NAVIGATION
    // ============================================================

    private IActionResult RedirectToPcpmScreen(
        D158500Result result)
    {
        var screen = Normalize(result.NextScreen);

        /*
         * The service returns COBOL-style numbers such as:
         *
         *   202
         *   302
         *   510
         *   550
         *
         * Convert them to Razor Page names.
         */

        if (screen.Length == 3 &&
            int.TryParse(screen, out var number))
        {
            var page = $"/D158{number:000}";

            return RedirectToPage(
                page,
                new
                {
                    jobNumber = Screen.JobNumber,
                    functionalArea = result.FunctionalArea
                });
        }

        /*
         * Don't redirect to arbitrary text returned from a form.
         */
        Screen.ErrorMessage = "INVALID SCREEN NAVIGATION";

        return Page();
    }


    // ============================================================
    // NORMALIZATION
    // ============================================================

    private void NormalizeInputs()
    {
        Action = Normalize(Action);
        JobNumber = Normalize(JobNumber);
        Sf = Normalize(Sf);
        SelRem = Normalize(SelRem);

        EnsureSelectionCount();

        for (var i = 0; i < Selections.Count; i++)
        {
            Selections[i] = Normalize(Selections[i]);
        }
    }


    private static string Normalize(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();
    }


    private void ClearSelections()
    {
        EnsureSelectionCount();

        for (var i = 0; i < Selections.Count; i++)
        {
            Selections[i] = string.Empty;
        }

        Sf = string.Empty;
        SelRem = string.Empty;
    }


    private void EnsureSelectionCount()
    {
        Selections ??= new List<string>();

        while (Selections.Count < 11)
        {
            Selections.Add(string.Empty);
        }

        if (Selections.Count > 11)
        {
            Selections = Selections
                .Take(11)
                .ToList();
        }
    }
}
@page
@model PCPM.Pages.D158500Model
@{
    Layout = null;
    ViewData["Title"] = "D158500";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>D158500</title>

    <link rel="stylesheet"
          href="~/css/pcpm-terminal.css"
          asp-append-version="true" />
</head>

<body>

<div class="pcpm-screen">

<form method="post"
      id="pcpmForm"
      class="pcpm-form">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="pcpm-header-row">

        <div class="pcpm-header-left">

            ACTION

            <input asp-for="Action"
                   class="pcpm-input pcpm-input-3"
                   maxlength="3"
                   autocomplete="off"
                   autofocus />

        </div>


        <div class="pcpm-header-center">
            ARDOT PRE-CONSTRUCTION PROJECT MONITORING
        </div>


        <div class="pcpm-header-right">
            D158500
        </div>

    </div>


    <div class="pcpm-header-row">

        <div class="pcpm-header-left">
            SCREEN&nbsp;&nbsp;500
        </div>


        <div class="pcpm-header-center">
            JOB STATUS SUMMARY INQUIRY
        </div>


        <div class="pcpm-header-right">
            @Model.DisplayDate
        </div>

    </div>


    <div class="pcpm-separator"></div>


    <!-- =========================================================
         JOB
         ========================================================= -->

    <div class="d158500-job-row">

        <span>JOB NUMBER:</span>

        <input asp-for="JobNumber"
               class="pcpm-input pcpm-input-job"
               maxlength="10"
               readonly />


        <span>NAME:</span>

        <span>@Model.JobName</span>

    </div>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="d158500-summary-row">

        <span>SF</span>

        <input asp-for="SF"
               class="pcpm-input pcpm-input-1"
               maxlength="1"
               autocomplete="off" />


        <span>TOTAL FUNDING:</span>

        <span>@Model.TotalFunding</span>


        <span>PS&amp;E:</span>

        <span>@Model.PseEnd</span>


        <span>VALUE ENGINEERING:</span>

        <span>@Model.ValueEngineeringPercent</span>

    </div>


    <!-- =========================================================
         TABLE HEADER
         ========================================================= -->

    <div class="d158500-table-header">

        <span>SEL</span>

        <span>FUNCTIONAL AREA</span>

        <span>FA</span>

        <span>STARTED</span>

        <span>PROJ COM</span>

        <span>% COMPL</span>

        <span>COMPLETE</span>

        <span>FLAG</span>

    </div>


    <!-- =========================================================
         11 STATUS ROWS
         ========================================================= -->

    @for (var i = 0;
          i < Model.Rows.Count;
          i++)
    {
        <div class="d158500-table-row">

            <input type="hidden"
                   asp-for="Rows[i].RowNumber" />

            <input type="hidden"
                   asp-for="Rows[i].FunctionalAreaDescription" />

            <input type="hidden"
                   asp-for="Rows[i].FunctionalArea" />

            <input type="hidden"
                   asp-for="Rows[i].StartDate" />

            <input type="hidden"
                   asp-for="Rows[i].ProjectedCompletion" />

            <input type="hidden"
                   asp-for="Rows[i].PercentComplete" />

            <input type="hidden"
                   asp-for="Rows[i].CompletionDate" />

            <input type="hidden"
                   asp-for="Rows[i].StatusFlag" />


            <input asp-for="Rows[i].Selection"
                   class="pcpm-input pcpm-input-1 selection-field"
                   maxlength="1"
                   autocomplete="off" />


            <span>
                @Model.Rows[i].FunctionalAreaDescription
            </span>


            <span>
                @Model.Rows[i].FunctionalArea
            </span>


            <span>
                @Model.Rows[i].StartDate
            </span>


            <span>
                @Model.Rows[i].ProjectedCompletion
            </span>


            <span>
                @Model.Rows[i].PercentComplete
            </span>


            <span>
                @Model.Rows[i].CompletionDate
            </span>


            <span>
                @Model.Rows[i].StatusFlag
            </span>

        </div>
    }


    <!-- =========================================================
         REMARK
         ========================================================= -->

    <div class="d158500-remark-row">

        <input asp-for="SelectRemark"
               class="pcpm-input pcpm-input-1"
               maxlength="1"
               autocomplete="off" />


        <span>LAST REMARK:</span>


        <span>
            @Model.LastRemark
        </span>


        <span>
            @Model.LastUpdated
        </span>

    </div>


    <div class="pcpm-separator"></div>


    <!-- =========================================================
         FUNCTION KEYS
         ========================================================= -->

    <div class="pcpm-function-keys">

        <button type="submit"
                asp-page-handler="Help"
                id="helpButton"
                class="pcpm-function-button">
            F1=HELP
        </button>


        <button type="submit"
                asp-page-handler="Previous"
                id="previousButton"
                class="pcpm-function-button">
            F3=PREVIOUS
        </button>


        <button type="submit"
                asp-page-handler="Reset"
                id="resetButton"
                class="pcpm-function-button">
            F6=RESET
        </button>


        <button type="submit"
                asp-page-handler="Backward"
                id="backwardButton"
                class="pcpm-function-button">
            F7=BACKWARD
        </button>


        <button type="submit"
                asp-page-handler="Forward"
                id="forwardButton"
                class="pcpm-function-button">
            F8=FORWARD
        </button>


        <button type="submit"
                asp-page-handler="MainMenu"
                id="mainMenuButton"
                class="pcpm-function-button">
            F12=MAIN MENU
        </button>

    </div>


    <div class="pcpm-error">
        @Model.ErrorMessage
    </div>


    <button type="submit"
            id="enterButton"
            class="pcpm-hidden-submit">
    </button>

</form>

</div>


<script>
    (() => {

        document.querySelectorAll(
            ".selection-field, .pcpm-input"
        ).forEach(input => {

            input.addEventListener(
                "input",
                function () {

                    this.value =
                        this.value.toUpperCase();

                });

        });


        document.addEventListener(
            "keydown",
            function (event) {

                let id = null;


                switch (event.key) {

                    case "Enter":
                        id = "enterButton";
                        break;

                    case "F1":
                        id = "helpButton";
                        break;

                    case "F3":
                        id = "previousButton";
                        break;

                    case "F6":
                        id = "resetButton";
                        break;

                    case "F7":
                        id = "backwardButton";
                        break;

                    case "F8":
                        id = "forwardButton";
                        break;

                    case "F12":
                        id = "mainMenuButton";
                        break;
                }


                if (!id)
                    return;


                event.preventDefault();


                document
                    .getElementById(id)
                    .click();

            });

    })();
</script>

</body>
</html>





using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PCPM.Session;

namespace PCPM.Pages;

public class D158500Model : PageModel
{
    private const string ScreenName =
        "D158500";


    [BindProperty]
    public string Action { get; set; } =
        string.Empty;


    [BindProperty]
    public string JobNumber { get; set; } =
        string.Empty;


    public string JobName { get; set; } =
        string.Empty;


    [BindProperty]
    public string SF { get; set; } =
        string.Empty;


    public string TotalFunding { get; set; } =
        string.Empty;


    public string PseEnd { get; set; } =
        string.Empty;


    public string ValueEngineeringPercent
    {
        get;
        set;
    } = string.Empty;


    [BindProperty]
    public List<D158500Row> Rows { get; set; } =
        new();


    [BindProperty]
    public string SelectRemark { get; set; } =
        string.Empty;


    public string LastRemark { get; set; } =
        string.Empty;


    public string LastUpdated { get; set; } =
        string.Empty;


    public string ErrorMessage { get; set; } =
        string.Empty;


    public string DisplayDate =>
        DateTime.Now.ToString("MM/dd/yyyy");


    // ============================================================
    // GET
    // ============================================================

    public IActionResult OnGet()
    {
        UpdateScreenSession();


        JobNumber =
            HttpContext.Session.GetString(
                PcpmSessionKeys.JobNumber)
            ?? string.Empty;


        BuildBlankRows();


        /*
         * DATABASE LOADING WILL GO HERE NEXT:
         *
         * JobName
         * TotalFunding
         * PseEnd
         * ValueEngineeringPercent
         * Rows
         * LastRemark
         * LastUpdated
         */


        return Page();
    }


    // ============================================================
    // ENTER
    // ============================================================

    public IActionResult OnPost()
    {
        Normalize();

        EnsureRows();


        var selectedRows =
            Rows
                .Where(x =>
                    !string.IsNullOrWhiteSpace(
                        x.Selection))
                .ToList();


        var navigationCount = 0;


        if (!string.IsNullOrWhiteSpace(Action))
            navigationCount++;


        if (!string.IsNullOrWhiteSpace(SF))
            navigationCount++;


        if (!string.IsNullOrWhiteSpace(
                SelectRemark))
            navigationCount++;


        navigationCount +=
            selectedRows.Count;


        if (navigationCount > 1)
        {
            ErrorMessage =
                "NAVIGATION CONFLICT.";

            return Page();
        }


        // --------------------------------------------------------
        // ACTION
        // --------------------------------------------------------

        if (!string.IsNullOrWhiteSpace(Action))
        {
            return ProcessAction();
        }


        // --------------------------------------------------------
        // SF
        //
        // Legacy PCPM:
        //
        // SF = S -> 510
        // --------------------------------------------------------

        if (!string.IsNullOrWhiteSpace(SF))
        {
            if (SF != "S")
            {
                ErrorMessage =
                    "INVALID SF SELECTION.";

                return Page();
            }


            SaveJobNumber();


            return GoToScreen(
                "D158510");
        }


        // --------------------------------------------------------
        // LAST REMARK
        //
        // SELREM = S -> 550
        // --------------------------------------------------------

        if (!string.IsNullOrWhiteSpace(
                SelectRemark))
        {
            if (SelectRemark != "S")
            {
                ErrorMessage =
                    "INVALID REMARK SELECTION.";

                return Page();
            }


            SaveJobNumber();


            return GoToScreen(
                "D158550");
        }


        // --------------------------------------------------------
        // FUNCTIONAL AREA ROW
        //
        // S / I -> 302
        // U     -> 202
        // --------------------------------------------------------

        if (selectedRows.Count == 1)
        {
            var row =
                selectedRows[0];


            if (string.IsNullOrWhiteSpace(
                    row.FunctionalArea))
            {
                ErrorMessage =
                    "FUNCTIONAL AREA NOT AVAILABLE.";

                return Page();
            }


            HttpContext.Session.SetString(
                PcpmSessionKeys.FunctionalArea,
                row.FunctionalArea);


            SaveJobNumber();


            if (row.Selection == "S" ||
                row.Selection == "I")
            {
                return GoToScreen(
                    "D158302");
            }


            if (row.Selection == "U")
            {
                return GoToScreen(
                    "D158202");
            }


            ErrorMessage =
                "INVALID SELECTION CODE.";

            return Page();
        }


        ErrorMessage =
            "SELECTION NOT SPECIFIED.";

        return Page();
    }


    // ============================================================
    // F1
    // ============================================================

    public IActionResult OnPostHelp()
    {
        Normalize();
        EnsureRows();

        ErrorMessage =
            "ENTER A VALID SELECTION AND PRESS ENTER.";

        return Page();
    }


    // ============================================================
    // F3
    // ============================================================

    public IActionResult OnPostPrevious()
    {
        SaveJobNumber();

        var previous =
            HttpContext.Session.GetString(
                PcpmSessionKeys.PreviousScreen);


        if (string.IsNullOrWhiteSpace(previous) ||
            previous == ScreenName)
        {
            previous = "D158100";
        }


        return RedirectToPage(
            "/" + previous);
    }


    // ============================================================
    // F6
    // ============================================================

    public IActionResult OnPostReset()
    {
        Action =
            string.Empty;

        SF =
            string.Empty;

        SelectRemark =
            string.Empty;

        ErrorMessage =
            string.Empty;


        BuildBlankRows();


        JobNumber =
            HttpContext.Session.GetString(
                PcpmSessionKeys.JobNumber)
            ?? string.Empty;


        return Page();
    }


    // ============================================================
    // F7
    //
    // Actual DB backward-job lookup will be connected later.
    // ============================================================

    public IActionResult OnPostBackward()
    {
        Normalize();
        EnsureRows();

        ErrorMessage =
            "BACKWARD JOB LOOKUP IS NOT WIRED YET.";

        return Page();
    }


    // ============================================================
    // F8
    //
    // Actual DB forward-job lookup will be connected later.
    // ============================================================

    public IActionResult OnPostForward()
    {
        Normalize();
        EnsureRows();

        ErrorMessage =
            "FORWARD JOB LOOKUP IS NOT WIRED YET.";

        return Page();
    }


    // ============================================================
    // F12
    // ============================================================

    public IActionResult OnPostMainMenu()
    {
        SaveJobNumber();

        return GoToScreen(
            "D158000");
    }


    // ============================================================
    // ACTION
    // ============================================================

    private IActionResult ProcessAction()
    {
        if (Action == "SO")
        {
            ErrorMessage =
                "SO ACTION IS NOT WIRED YET.";

            return Page();
        }


        if (!Action.All(char.IsDigit))
        {
            ErrorMessage =
                "INVALID ACTION CODE.";

            return Page();
        }


        if (!int.TryParse(
                Action,
                out var screen))
        {
            ErrorMessage =
                "INVALID ACTION CODE.";

            return Page();
        }


        SaveJobNumber();


        return GoToScreen(
            $"D158{screen:000}");
    }


    // ============================================================
    // ROW INITIALIZATION
    // ============================================================

    private void BuildBlankRows()
    {
        Rows =
            Enumerable
                .Range(1, 11)
                .Select(x =>
                    new D158500Row
                    {
                        RowNumber = x
                    })
                .ToList();
    }


    private void EnsureRows()
    {
        Rows ??=
            new List<D158500Row>();


        while (Rows.Count < 11)
        {
            Rows.Add(
                new D158500Row
                {
                    RowNumber =
                        Rows.Count + 1
                });
        }


        if (Rows.Count > 11)
        {
            Rows =
                Rows
                    .Take(11)
                    .ToList();
        }
    }


    private void Normalize()
    {
        Action =
            (Action ?? string.Empty)
            .Trim()
            .ToUpperInvariant();


        JobNumber =
            (JobNumber ?? string.Empty)
            .Trim()
            .ToUpperInvariant();


        SF =
            (SF ?? string.Empty)
            .Trim()
            .ToUpperInvariant();


        SelectRemark =
            (SelectRemark ?? string.Empty)
            .Trim()
            .ToUpperInvariant();


        Rows ??=
            new List<D158500Row>();


        foreach (var row in Rows)
        {
            row.Selection =
                (row.Selection ??
                 string.Empty)
                .Trim()
                .ToUpperInvariant();


            row.FunctionalArea =
                (row.FunctionalArea ??
                 string.Empty)
                .Trim()
                .ToUpperInvariant();
        }
    }


    private void SaveJobNumber()
    {
        if (string.IsNullOrWhiteSpace(
                JobNumber))
        {
            return;
        }


        HttpContext.Session.SetString(
            PcpmSessionKeys.JobNumber,
            JobNumber);
    }


    private IActionResult GoToScreen(
        string screen)
    {
        HttpContext.Session.SetString(
            PcpmSessionKeys.PreviousScreen,
            ScreenName);


        HttpContext.Session.SetString(
            PcpmSessionKeys.CurrentScreen,
            screen);


        return RedirectToPage(
            "/" + screen);
    }


    private void UpdateScreenSession()
    {
        var current =
            HttpContext.Session.GetString(
                PcpmSessionKeys.CurrentScreen);


        if (!string.IsNullOrWhiteSpace(current) &&
            !string.Equals(
                current,
                ScreenName,
                StringComparison.OrdinalIgnoreCase))
        {
            HttpContext.Session.SetString(
                PcpmSessionKeys.PreviousScreen,
                current);
        }


        HttpContext.Session.SetString(
            PcpmSessionKeys.CurrentScreen,
            ScreenName);
    }
}


public class D158500Row
{
    public int RowNumber { get; set; }


    public string Selection { get; set; } =
        string.Empty;


    // COBOL X(15)
    public string FunctionalAreaDescription
    {
        get;
        set;
    } = string.Empty;


    // COBOL X(2)
    public string FunctionalArea { get; set; } =
        string.Empty;


    // COBOL X(7)
    public string StartDate { get; set; } =
        string.Empty;


    // COBOL X(7)
    public string ProjectedCompletion
    {
        get;
        set;
    } = string.Empty;


    // COBOL X(3)
    public string PercentComplete
    {
        get;
        set;
    } = string.Empty;


    // COBOL X(7)
    public string CompletionDate
    {
        get;
        set;
    } = string.Empty;


    // COBOL X(2)
    public string StatusFlag { get; set; } =
        string.Empty;
}
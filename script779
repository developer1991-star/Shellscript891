    "jobFamily",
    "jobGroupCode",
    "regionID",
    "districtID",
    "fullTimeIndicator",
    "sortType",
    "managerID",
    "buildingMnemonic",
    "firstNameAlternative",
    "middleNameAlternative",
    "lastNameAlternative",
    "primaryPhoneNumber",
    "workPhoneNumber",
    "birthdate",

      *                                                                                                                                                                                                 
      ************************************************                                                                                                                                                  
      *                                                                                                                                                                                                 
      * CHECK FIELD CONTAINS ONLY NUMERIC CHARACTERS                                                                                                                                                    
      *                                                                                                                                                                                                 
      ************************************************                                                                                                                                                  
      *                                                                                                                                                                                                 
       method-id.  Check_Numeric_Logic protected.                                                                                                                                                       
       procedure division.                                                                                                                                                                              
                                                                                                                                                                                                        
           MOVE "Y"       TO WS-NUMERIC-CHECK-FLAG.                                                                                                                                                     
           MOVE ZERO      TO WS-NC-NUMBER-COUNT.                                                                                                                                                        
           MOVE ZERO      TO WS-NC-DECIMAL-COUNT.                                                                                                                                                       
           MOVE SPACE     TO WS-NC-DP-FLAG.                                                                                                                                                             
           MOVE SPACE     TO WS-NC-SIGN.                                                                                                                                                                
           MOVE SPACE     TO WS-NC-EXTRA-CHARS.                                                                                                                                                         
                                                                                                                                                                                                        
      * Check for all spaces                                                                                                                                                                            
                                                                                                                                                                                                        
           IF WS-NUMERIC-CHECK = SPACES                                                                                                                                                                 
              GO TO Check_Numeric_Logic_Exit.                                                                                                                                                           
                                                                                                                                                                                                        
      * Remove $ or ,                                                                                                                                                                                   
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
           MOVE ZERO TO WS-SUB1.                                                                                                                                                                        
           MOVE SPACES TO WORK-FIELD.                                                                                                                                                                   
       Check_Numeric_Logic_PreLoop.                                                                                                                                                                     
           ADD 1 TO WS-SUB.                                                                                                                                                                             
           IF WS-SUB > 20                                                                                                                                                                               
              GO TO Check_Numeric_Logic_Code.                                                                                                                                                           
           IF WS-NUMERIC-CHECK(WS-SUB:) = SPACES                                                                                                                                                        
              GO TO Check_Numeric_Logic_Code.                                                                                                                                                           
           IF WS-NUMERIC-CHECK(WS-SUB:1) = "$" OR ","                                                                                                                                                   
              GO TO Check_Numeric_Logic_PreLoop.                                                                                                                                                        
           ADD 1 TO WS-SUB1.                                                                                                                                                                            
           MOVE WS-NUMERIC-CHECK(WS-SUB:1) TO                                                                                                                                                           
                      WORK-FIELD(WS-SUB1:1).                                                                                                                                                            
           GO TO Check_Numeric_Logic_PreLoop.                                                                                                                                                           
                                                                                                                                                                                                        
       Check_Numeric_Logic_Code.                                                                                                                                                                        
           MOVE WORK-FIELD TO WS-NUMERIC-CHECK.                                                                                                                                                         
                                                                                                                                                                                                        
      * Check only contains ., -, +, space, or number                                                                                                                                                   
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
       Check_Numeric_Logic_Loop_0.                                                                                                                                                                      
           ADD 1 TO WS-SUB.                                                                                                                                                                             
           IF WS-SUB < 21                                                                                                                                                                               
              IF WS-NUMERIC-CHECK(WS-SUB:1) = "." OR "-" OR "+" OR " "                                                                                                                                  
                 MOVE "Y"             TO WS-NC-EXTRA-CHARS                                                                                                                                              
                 GO TO Check_Numeric_Logic_Loop_0                                                                                                                                                       
              END-IF                                                                                                                                                                                    
              IF WS-NUMERIC-CHECK(WS-SUB:1) < 0 OR > 9                                                                                                                                                  
                 MOVE "N" TO WS-NUMERIC-CHECK-FLAG                                                                                                                                                      
                 GO TO Check_Numeric_Logic_Exit                                                                                                                                                         
              END-IF                                                                                                                                                                                    
              GO TO Check_Numeric_Logic_Loop_0.                                                                                                                                                         
                                                                                                                                                                                                        
                                                                                                                                                                                                        
      * Left justify                                                                                                                                                                                    
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
       Check_Numeric_Logic_Loop_1.                                                                                                                                                                      
           ADD 1 TO WS-SUB.                                                                                                                                                                             
           IF WS-NUMERIC-CHECK(1:1) = SPACE                                                                                                                                                             
              MOVE WS-NUMERIC-CHECK(2:) TO WS-NUMERIC-CHECK(1:)                                                                                                                                         
              GO TO Check_Numeric_Logic_Loop_1.                                                                                                                                                         
                                                                                                                                                                                                        
      * If embedded space then set error flag                                                                                                                                                           
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
       Check_Numeric_Logic_Loop_2.                                                                                                                                                                      
           ADD 1 TO WS-SUB.                                                                                                                                                                             
           IF WS-SUB < 21                                                                                                                                                                               
              IF WS-NUMERIC-CHECK(WS-SUB:1) NOT = SPACE                                                                                                                                                 
                 GO TO Check_Numeric_Logic_Loop_2                                                                                                                                                       
              ELSE                                                                                                                                                                                      
                 IF WS-NUMERIC-CHECK(WS-SUB:) NOT = SPACES                                                                                                                                              
                    MOVE "N" TO WS-NUMERIC-CHECK-FLAG                                                                                                                                                   
                    GO TO Check_Numeric_Logic_Exit.                                                                                                                                                     
                                                                                                                                                                                                        
                                                                                                                                                                                                        
      * Check for only one - or +                                                                                                                                                                       
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
           INSPECT WS-NUMERIC-CHECK TALLYING WS-SUB FOR ALL "-".                                                                                                                                        
           INSPECT WS-NUMERIC-CHECK TALLYING WS-SUB FOR ALL "+".                                                                                                                                        
           IF WS-SUB > 1                                                                                                                                                                                
              MOVE "N" TO WS-NUMERIC-CHECK-FLAG                                                                                                                                                         
              GO TO Check_Numeric_Logic_Exit.                                                                                                                                                           
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
           INSPECT WS-NUMERIC-CHECK TALLYING WS-SUB FOR ALL "-".                                                                                                                                        
           IF WS-SUB = 1                                                                                                                                                                                
              MOVE "-" TO WS-NC-SIGN.                                                                                                                                                                   
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
           INSPECT WS-NUMERIC-CHECK TALLYING WS-SUB FOR ALL "+".                                                                                                                                        
           IF WS-SUB = 1                                                                                                                                                                                
              MOVE "+" TO WS-NC-SIGN.                                                                                                                                                                   
                                                                                                                                                                                                        
      * Check for only one .                                                                                                                                                                            
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
           INSPECT WS-NUMERIC-CHECK TALLYING WS-SUB FOR ALL ".".                                                                                                                                        
           IF WS-SUB > 1                                                                                                                                                                                
              MOVE "N" TO WS-NUMERIC-CHECK-FLAG                                                                                                                                                         
              GO TO Check_Numeric_Logic_Exit.                                                                                                                                                           
                                                                                                                                                                                                        
                                                                                                                                                                                                        
      * If embedded "-" or "+" then set error flag                                                                                                                                                      
                                                                                                                                                                                                        
           MOVE 1 TO WS-SUB.                                                                                                                                                                            
       Check_Numeric_Logic_Loop_3.                                                                                                                                                                      
           ADD 1 TO WS-SUB.                                                                                                                                                                             
           IF WS-SUB < 20                                                                                                                                                                               
              IF WS-NUMERIC-CHECK(WS-SUB:1) = "-" or "+"                                                                                                                                                
                 IF WS-NUMERIC-CHECK(WS-SUB + 1:) NOT = SPACES                                                                                                                                          
                    MOVE "N" TO WS-NUMERIC-CHECK-FLAG                                                                                                                                                   
                    GO TO Check_Numeric_Logic_Exit                                                                                                                                                      
                 END-IF                                                                                                                                                                                 
              ELSE                                                                                                                                                                                      
                 GO TO Check_Numeric_Logic_Loop_3.                                                                                                                                                      
                                                                                                                                                                                                        
                                                                                                                                                                                                        
      * Count numeric and decimal characters                                                                                                                                                            
                                                                                                                                                                                                        
           MOVE ZERO TO WS-SUB.                                                                                                                                                                         
       Check_Numeric_Logic_Loop_4.                                                                                                                                                                      
           ADD 1 TO WS-SUB.                                                                                                                                                                             
           IF WS-SUB < 21                                                                                                                                                                               
              IF WS-NUMERIC-CHECK(WS-SUB:1) = SPACE                                                                                                                                                     
                 MOVE 22 TO WS-SUB                                                                                                                                                                      
              ELSE                                                                                                                                                                                      
                 IF WS-NUMERIC-CHECK(WS-SUB:1) = "-" OR "+"                                                                                                                                             
                    GO TO Check_Numeric_Logic_Loop_4                                                                                                                                                    
                 ELSE                                                                                                                                                                                   
                    IF WS-NUMERIC-CHECK(WS-SUB:1) = "."                                                                                                                                                 
                       MOVE "Y" TO WS-NC-DP-FLAG                                                                                                                                                        
                       GO TO Check_Numeric_Logic_Loop_4                                                                                                                                                 
                    ELSE                                                                                                                                                                                
                       IF WS-NC-DP-FLAG = SPACE                                                                                                                                                         
                          ADD 1 TO WS-NC-NUMBER-COUNT                                                                                                                                                   
                       ELSE                                                                                                                                                                             
                          ADD 1 TO WS-NC-DECIMAL-COUNT                                                                                                                                                  
                       END-IF                                                                                                                                                                           
                       GO TO Check_Numeric_Logic_Loop_4.                                                                                                                                                
                                                                                                                                                                                                        
       Check_Numeric_Logic_Exit.                                                                                                                                                                        
      *                                                                                                                                                                                                 
       end method Check_Numeric_Logic.                                                                                                                                                                  
                                                                                                                                                                                                        

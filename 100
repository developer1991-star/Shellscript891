@page
@model PCPM.Pages.D158801Model
@{
    Layout = null;
    ViewData["Title"] = "D158801";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158801</title>

    <link rel="stylesheet" href="/css/pcpm-terminal.css" />

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #F2F3FF;
            color: #111;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
        }

        .legacy-screen {
            position: relative;
            width: 820px;
            height: 620px;
            margin: 0 auto;
            font-family: "Courier New", Courier, monospace;
            font-weight: 700;
        }

        .legacy-label {
            position: absolute;
            white-space: pre;
            line-height: 20px;
        }

        .legacy-input {
            position: absolute;
            box-sizing: border-box;
            height: 22px;
            padding: 1px 2px;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            color: #111;
            background-color: #fff;
            border: 1px solid #666;
            border-radius: 0;
        }

        .legacy-input:focus {
            outline: none;
            background-color: #ffff00;
        }

        .legacy-input[readonly] {
            background-color: LightGray;
        }

        .pf-button {
            position: absolute;
            margin: 0;
            padding: 0;
            border: none;
            background: transparent;
            color: #111;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            white-space: pre;
        }

        .pf-button:hover,
        .pf-button:focus {
            text-decoration: underline;
        }

        .default-submit {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }

        .error-message {
            position: absolute;
            left: 10px;
            top: 575px;
            width: 790px;
            color: red;
            white-space: pre-wrap;
        }

        .offline-message {
            position: absolute;
            left: 20px;
            top: 1px;
            color: red;
        }
    </style>
</head>

<body>

<form method="post" action="/D158801">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="fa"
           value="@Model.Wfa" />

    <div class="legacy-screen">

        @*
            Physical ENTER key still submits even though the legacy
            ENTER=ACCEPT label starts hidden (PSI).
        *@
        <button type="submit"
                name="Command"
                value="ENTER"
                class="default-submit"
                tabindex="-1">
        </button>

        @* ================================================================
           HEADER
           ================================================================ *@

        <span class="legacy-label"
              style="left:10px; top:25px;">ACTION</span>

        <input class="legacy-input"
               id="Action"
               name="Action"
               value="@Model.Action"
               maxlength="3"
               tabindex="1"
               style="left:90px; top:25px; width:24px;" />

        <span class="legacy-label"
              style="left:190px; top:25px;">ARDOT PRE-CONSTRUCTION PROJECT MONITORING</span>

        <span class="legacy-label"
              style="left:710px; top:25px;">D158801</span>

        <span class="legacy-label"
              style="left:10px; top:50px;">SCREEN</span>

        <span class="legacy-label"
              style="left:90px; top:50px;">801</span>

        <span class="legacy-label"
              style="left:270px; top:50px;">ADD STANDARD REMARKS PANEL</span>

        <span class="legacy-label"
              style="left:680px; top:50px;">@Model.DateText</span>

        <span class="legacy-label"
              style="left:10px; top:75px;">=============================================================================</span>

        @* ================================================================
           FUNCTIONAL AREA / USER
           ================================================================ *@

        <span class="legacy-label"
              style="left:10px; top:100px;">FUNCTIONAL AREA</span>

        <input class="legacy-input"
               value="@Model.Wfa"
               maxlength="2"
               readonly
               tabindex="2"
               style="left:180px; top:100px; width:16px;" />

        <span class="legacy-label"
              style="left:220px; top:100px;">@Model.WfaTranslation</span>

        <span class="legacy-label"
              style="left:620px; top:100px;">USER ID</span>

        <span class="legacy-label"
              style="left:710px; top:100px;">@Model.UserId</span>

        <span class="legacy-label"
              style="left:10px; top:125px;">-----------------------------------------------------------------------------</span>

        @* ================================================================
           CURRENT STANDARD REMARKS
           ================================================================ *@

        <span class="legacy-label"
              style="left:270px; top:150px;">STANDARDIZED REMARKS</span>

        <span class="legacy-label"
              style="left:170px; top:175px;">FA</span>

        <span class="legacy-label"
              style="left:210px; top:175px;">TYPE</span>

        <span class="legacy-label"
              style="left:460px; top:175px;">REMARK</span>

        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var top = 200 + (i * 25);

            <span class="legacy-label"
                  style="@($"left:170px; top:{top}px;")">@Model.Rows[i].FunctionalArea</span>

            <span class="legacy-label"
                  style="@($"left:220px; top:{top}px;")">@Model.Rows[i].RemarkType</span>

            <span class="legacy-label"
                  style="@($"left:280px; top:{top}px;")">@Model.Rows[i].Remark</span>
        }

        <span class="legacy-label"
              style="left:10px; top:475px;">-----------------------------------------------------------------------------</span>

        @* ================================================================
           ADD STANDARD REMARK
           ================================================================ *@

        <span class="legacy-label"
              style="left:10px; top:500px;">ADD STD REMARK</span>

        <span class="legacy-label"
              style="left:170px; top:500px;">@Model.WorkFunctionalArea</span>

        <input class="legacy-input"
               id="WRemarkType"
               name="WRemarkType"
               value="@Model.WRemarkType"
               maxlength="3"
               tabindex="3"
               inputmode="numeric"
               style="left:220px; top:500px; width:24px;" />

        <input class="legacy-input"
               id="WRemark"
               name="WRemark"
               value="@Model.WRemark"
               maxlength="50"
               tabindex="4"
               style="left:280px; top:500px; width:400px;" />

        <span class="legacy-label"
              style="left:10px; top:525px;">-----------------------------------------------------------------------------</span>

        @* ================================================================
           FUNCTION KEYS
           ================================================================ *@

        <button type="submit"
                name="Command"
                value="PF1"
                data-command="PF1"
                class="pf-button"
                style="left:10px; top:550px;"> F1=HELP</button>

        <button type="submit"
                name="Command"
                value="PF3"
                data-command="PF3"
                class="pf-button"
                style="left:100px; top:550px;"> F3=PREV</button>

        <button type="submit"
                name="Command"
                value="PF4"
                data-command="PF4"
                class="pf-button"
                style="left:190px; top:550px;"> F4=SCRLB</button>

        <button type="submit"
                name="Command"
                value="PF5"
                data-command="PF5"
                class="pf-button"
                style="left:290px; top:550px;"> F5=SCRLF</button>

        <button type="submit"
                name="Command"
                value="PF6"
                data-command="PF6"
                class="pf-button"
                style="left:390px; top:550px;"> F6=RESET</button>

        <button type="submit"
                name="Command"
                value="PF12"
                data-command="PF12"
                class="pf-button"
                style="left:490px; top:550px;"> F12=MAIN</button>

        @*
            Wrapper initial attribute:
                ENTER-KEY-INITIAL-ATTR = "PSI"

            Therefore ENTER=ACCEPT starts invisible.

            The physical Enter key still posts Command=ENTER.
            If the business program later has a state in which this
            label becomes visible, ShowEnterKey can be set accordingly.
        *@

        @if (Model.ShowEnterKey)
        {
            <button type="submit"
                    name="Command"
                    value="ENTER"
                    data-command="ENTER"
                    class="pf-button"
                    style="left:590px; top:550px;">ENTER=ACCEPT</button>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.OfflineMessage))
        {
            <div class="offline-message">@Model.OfflineMessage</div>
        }
    </div>
</form>

<script>
    (() => {
        const action = document.getElementById("Action");
        const remarkType = document.getElementById("WRemarkType");
        const remark = document.getElementById("WRemark");

        function upper(element) {
            if (element && typeof element.value === "string") {
                element.value = element.value.toUpperCase();
            }
        }

        document.addEventListener("input", event => {
            if (!(event.target instanceof HTMLInputElement)) {
                return;
            }

            if (event.target.id === "Action" ||
                event.target.id === "WRemark") {
                upper(event.target);
            }
        });

        document.addEventListener("keydown", event => {
            const keyMap = {
                "F1": "PF1",
                "F3": "PF3",
                "F4": "PF4",
                "F5": "PF5",
                "F6": "PF6",
                "F12": "PF12"
            };

            const command = keyMap[event.key];

            if (command) {
                event.preventDefault();

                const button =
                    document.querySelector(
                        `[data-command="${command}"]`
                    );

                button?.click();
                return;
            }

            if (event.key === "Enter" &&
                event.target instanceof HTMLInputElement) {

                event.preventDefault();

                const form = event.target.form;

                if (!form) {
                    return;
                }

                const submit =
                    form.querySelector(
                        'button[name="Command"][value="ENTER"]'
                    );

                submit?.click();
            }
        });

        /*
         * Legacy initial cursor:
         *
         * WREMTYPE-INITIAL-ATTR = UALC
         * Set_Screen_Cursor -> 1022
         */
        remarkType?.focus();
        remarkType?.select();
    })();
</script>

</body>
</html>





using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158801Model : PageModel
{
    private const int RowCount = 11;

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string WRemarkType { get; set; } = string.Empty;

    [BindProperty]
    public string WRemark { get; set; } = string.Empty;

    [BindProperty]
    public string Command { get; set; } = string.Empty;

    public string DateText { get; private set; } = "00/00/0000";

    public string Wfa { get; private set; } = string.Empty;

    public string WfaTranslation { get; private set; } = string.Empty;

    public string UserId { get; private set; } = string.Empty;

    /*
     * Corresponds to legacy S_SFA.
     *
     * The wrapper proves that this is display-only X(2), but the
     * supplied source does not prove exactly how the main COBOL
     * populates it.
     */
    public string WorkFunctionalArea { get; private set; } = string.Empty;

    public string ErrorMessage { get; private set; } = string.Empty;

    public string OfflineMessage { get; private set; } = string.Empty;

    public List<StandardRemarkRow> Rows { get; private set; } = [];

    /*
     * Legacy initial attribute for ENTER:
     *
     *     ENTER-KEY-INITIAL-ATTR = "PSI"
     *
     * So the text label starts hidden.
     *
     * Main business COBOL may later make it visible.
     */
    public bool ShowEnterKey { get; private set; }

    public async Task OnGetAsync(string? fa)
    {
        InitializeContext(fa);

        await LoadScreenDataAsync();
    }

    public async Task<IActionResult> OnPostAsync(string? fa)
    {
        InitializeContext(fa);

        NormalizePostedFields();

        /*
         * The 11 rows are display-only in D158801.
         * Reload them from the trusted server-side source instead of
         * accepting posted copies from the browser.
         */
        await LoadScreenDataAsync();

        switch (Command)
        {
            case "PF1":
                /*
                 * TODO:
                 * Main D158801 COBOL required to confirm the exact
                 * help-panel destination.
                 */
                ErrorMessage =
                    "D158801 HELP ROUTE HAS NOT YET BEEN WIRED.";

                return Page();

            case "PF3":
                /*
                 * PROVISIONAL:
                 * D158800 is the Standard Remark Maintenance menu
                 * from which panel 801 is selected.
                 */
                return RedirectToPage(
                    "/D158800",
                    new
                    {
                        fa = Wfa
                    });

            case "PF4":
                /*
                 * TODO:
                 * Main COBOL required to determine the exact
                 * scroll-backward key and browse position.
                 */
                ErrorMessage =
                    "D158801 SCRLB BUSINESS LOGIC HAS NOT YET BEEN WIRED.";

                return Page();

            case "PF5":
                /*
                 * TODO:
                 * Main COBOL required to determine exact
                 * scroll-forward behavior.
                 */
                ErrorMessage =
                    "D158801 SCRLF BUSINESS LOGIC HAS NOT YET BEEN WIRED.";

                return Page();

            case "PF6":
                ResetEntryFields();

                await LoadScreenDataAsync();

                return Page();

            case "PF12":
                /*
                 * PROVISIONAL PCPM main-menu convention.
                 */
                return RedirectToPage("/D158000");

            case "ENTER":
            case "":
                return await ProcessEnterAsync();

            default:
                /*
                 * ACTION is authoritative as PIC X(3) and uppercase.
                 * The supplied wrapper does not contain its business
                 * validation or routing table.
                 */
                ErrorMessage =
                    $"ACTION '{Action}' IS NOT YET WIRED FOR D158801.";

                return Page();
        }
    }

    private async Task<IActionResult> ProcessEnterAsync()
    {
        /*
         * D158801 wrapper validation:
         *
         * ALLOW-SEPARATOR = "N"
         * ALLOW-SIGN      = "N"
         *
         * Therefore WREMTYPE must be blank or unsigned whole digits.
         *
         * The legacy numeric routine also removes '$' and ',' before
         * validating.
         */
        if (!TryNormalizeLegacyRemarkType(
                WRemarkType,
                out var normalizedRemarkType))
        {
            ErrorMessage =
                "STANDARD REMARK TYPE MUST BE NUMERIC.";

            return Page();
        }

        /*
         * Preserve what the user sees on the terminal.
         */
        WRemarkType = normalizedRemarkType;

        WRemark =
            NormalizeUpper(
                WRemark,
                50);

        /*
         * Important D158801 legacy distinction:
         *
         * In Input_To_Pcim_Data, a blank WREMTYPE executes:
         *
         *     MOVE ALL ZEROES TO WREMTYPE
         *
         * So the business program receives numeric zero when the
         * visible work type is blank.
         */
        var legacyProgramRemarkType =
            string.IsNullOrWhiteSpace(normalizedRemarkType)
                ? "000"
                : normalizedRemarkType.PadLeft(3, ' ');

        /*
         * Do not invent requiredness or duplicate/type-range rules here.
         * Those belong to the missing main D158801 COBOL.
         */
        var added = await AddStandardRemarkAsync(
            WorkFunctionalArea,
            legacyProgramRemarkType,
            WRemark);

        if (!added)
        {
            ErrorMessage =
                "D158801 ADD SERVICE HAS NOT YET BEEN WIRED.";

            return Page();
        }

        ResetEntryFields();

        await LoadScreenDataAsync();

        return Page();
    }

    private void InitializeContext(string? fa)
    {
        /*
         * Temporary migration bridge.
         *
         * Replace this with the exact IPcpmSessionService usage from
         * the working D158000 page once that API is wired into these
         * standard-remark pages.
         */
        Wfa =
            NormalizeUpper(
                fa,
                2);

        UserId = GetLegacyUserId();

        DateText =
            DateTime.Today.ToString("MM/dd/yyyy");
    }

    private void NormalizePostedFields()
    {
        Action =
            NormalizeUpper(
                Action,
                3);

        Command =
            NormalizeUpper(
                Command,
                10);

        WRemark =
            NormalizeUpper(
                WRemark,
                50);

        /*
         * WREMTYPE is processed separately by the legacy-compatible
         * numeric validator because '$' and ',' stripping is part of
         * the wrapper behavior.
         */
        WRemarkType =
            (WRemarkType ?? string.Empty)
            .Trim();

        if (WRemarkType.Length > 3)
        {
            WRemarkType =
                WRemarkType[..3];
        }
    }

    private async Task LoadScreenDataAsync()
    {
        /*
         * TODO BUSINESS / DATA INTEGRATION
         *
         * The authoritative wrapper defines:
         *
         *     WFA          PIC X(2)
         *     WFA-TRANS    PIC X(14)
         *     USRID        PIC X(7)
         *
         *     OCCURS 11:
         *         FA       PIC X(2)
         *         REMTYPE  PIC X(3)
         *         STDREM   PIC X(50)
         *
         *     SFA          PIC X(2)
         *
         * But the supplied ASPX + wrapper do NOT tell us:
         *
         * - physical SQL table/view
         * - retrieval filter
         * - ordering
         * - paging key
         * - delete-state filtering
         * - authorization
         *
         * Replace this placeholder with an Application-level service.
         * SQL belongs in PCPM.Infrastructure.
         */

        await Task.CompletedTask;

        WfaTranslation ??= string.Empty;

        WorkFunctionalArea ??= string.Empty;

        Rows = Enumerable
            .Range(0, RowCount)
            .Select(_ => new StandardRemarkRow())
            .ToList();

        /*
         * Future example only:
         *
         * var result =
         *     await _standardRemarkService
         *         .GetAddScreenAsync(Wfa);
         *
         * WfaTranslation =
         *     result.FunctionalAreaDescription;
         *
         * WorkFunctionalArea =
         *     result.WorkFunctionalArea;
         *
         * Rows = result.Rows
         *     .Take(RowCount)
         *     .Select(x => new StandardRemarkRow
         *     {
         *         FunctionalArea = x.FunctionalArea,
         *         RemarkType = FormatRemarkType(x.RemarkType),
         *         Remark = x.Remark
         *     })
         *     .ToList();
         */
    }

    private Task<bool> AddStandardRemarkAsync(
        string functionalArea,
        string remarkType,
        string remark)
    {
        /*
         * TODO BUSINESS / DATA INTEGRATION
         *
         * Do not invent an INSERT statement here.
         *
         * Main D158801 business COBOL is still required to establish:
         *
         * - actual data source/table
         * - functional-area key
         * - remark-type rules
         * - duplicate handling
         * - whether type zero means blank/invalid
         * - whether remark is required
         * - security/authorization
         * - exact success/error handling
         * - paging position after add
         */

        return Task.FromResult(false);
    }

    private void ResetEntryFields()
    {
        Action = string.Empty;

        WRemarkType = string.Empty;

        WRemark = string.Empty;

        ErrorMessage = string.Empty;

        ShowEnterKey = false;
    }

    /*
     * Mirrors the important D158801 Check_Numeric_Logic behavior for
     * the editable WREMTYPE field.
     */
    private static bool TryNormalizeLegacyRemarkType(
        string? value,
        out string normalized)
    {
        normalized =
            (value ?? string.Empty)
            .Trim();

        /*
         * Legacy routine removes '$' and ',' before numeric checking.
         */
        normalized =
            normalized
            .Replace("$", string.Empty)
            .Replace(",", string.Empty);

        normalized = normalized.Trim();

        if (normalized.Length == 0)
        {
            normalized = string.Empty;
            return true;
        }

        /*
         * ALLOW-SEPARATOR = N
         * ALLOW-SIGN      = N
         *
         * No '.', '+', '-' or other characters are accepted.
         */
        foreach (var character in normalized)
        {
            if (!char.IsDigit(character))
            {
                return false;
            }
        }

        /*
         * PIC X(3) / ASPX MaxLength=3.
         */
        if (normalized.Length > 3)
        {
            return false;
        }

        return true;
    }

    private string GetLegacyUserId()
    {
        var value =
            User?.Identity?.Name ??
            string.Empty;

        var slash =
            value.LastIndexOf('\\');

        if (slash >= 0 &&
            slash < value.Length - 1)
        {
            value =
                value[(slash + 1)..];
        }

        return NormalizeUpper(
            value,
            7);
    }

    private static string NormalizeUpper(
        string? value,
        int maxLength)
    {
        var normalized =
            (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        if (normalized.Length > maxLength)
        {
            normalized =
                normalized[..maxLength];
        }

        return normalized;
    }

    public sealed class StandardRemarkRow
    {
        public string FunctionalArea { get; set; } =
            string.Empty;

        public string RemarkType { get; set; } =
            string.Empty;

        public string Remark { get; set; } =
            string.Empty;
    }
}
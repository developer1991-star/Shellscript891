    public async Task<string?> GetMessageAsync(
        string messageId,
        CancellationToken cancellationToken = default)
    {
        const string sql = """
            SELECT TOP (1)
                MESSAGE_TEXT
            FROM [PRECONSTRUCTION].[dbo].[T158_MESSAGE]
            WHERE LTRIM(RTRIM(T158_MESSAGE_PRIMARY_KEY)) =
                  LTRIM(RTRIM(@MessageId))
            ORDER BY T158_MESSAGE_PRIMARY_KEY ASC;
            """;

        await using var connection =
            new SqlConnection(_connectionString);

        await connection.OpenAsync(cancellationToken);

        await using var command =
            new SqlCommand(sql, connection);

        command.Parameters.Add(
            "@MessageId",
            SqlDbType.VarChar,
            6).Value = Normalize(messageId);

        var result =
            await command.ExecuteScalarAsync(cancellationToken);

        if (result is null || result == DBNull.Value)
            return null;

        return result.ToString()?.Trim();
    }

    // ============================================================
    // STATUS MAPPING
    // ============================================================

    private static D158302StatusRecord MapStatus(
        SqlDataReader reader)
    {
        return new D158302StatusRecord
        {
            JobNumber =
                ReadString(reader, "JOBNO"),

            FunctionalArea =
                ReadString(reader, "FUNC_AREA"),

            FunctionalAreaStatus =
                ReadString(reader, "FA_STATUS"),

            PercentComplete =
                ReadString(reader, "FA_PERCENT"),

            StartDate =
                ReadString(reader, "FA_START_DATE"),

            ProjectedEndDate =
                ReadString(reader, "FA_PROJ_END"),

            EndDate =
                ReadString(reader, "FA_END"),

            LastUpdated =
                ReadString(reader, "LAST_UPDATED"),

            UserId =
                ReadString(reader, "USERID_R")
        };
    }

    // ============================================================
    // REMARK MAPPING
    // ============================================================

    private static D158302RemarkRecord MapRemark(
        SqlDataReader reader)
    {
        return new D158302RemarkRecord
        {
            JobNumber =
                ReadString(reader, "JOBNO"),

            FunctionalArea =
                ReadString(reader, "FUNC_AREA"),

            Remark =
                ReadString(reader, "REMARK_R"),

            LastUpdated =
                ReadString(reader, "LAST_UPDATED"),

            RemarkType =
                ReadInt(reader, "REMTYPE"),

            RemarkSequence =
                ReadInt(reader, "REMSEQ"),

            StatusFlag =
                ReadString(reader, "REM_STA_FLAG"),

            // Your Application model calls this DeleteFlag.
            // On Screen 302 this corresponds to the legacy
            // REM-DIS-FLAG field.
            DeleteFlag =
                ReadString(reader, "REM_DIS_FLAG"),

            HistoryFlag =
                ReadString(reader, "HIST_FLAG"),

            UserId =
                ReadString(reader, "USERID_R")
        };
    }

    // ============================================================
    // SQL PARAMETERS
    // ============================================================

    private static void AddJobNumberParameter(
        SqlCommand command,
        string? jobNumber)
    {
        command.Parameters.Add(
            "@JobNumber",
            SqlDbType.VarChar,
            10).Value = Normalize(jobNumber);
    }

    private static void AddFunctionalAreaParameter(
        SqlCommand command,
        string? functionalArea)
    {
        command.Parameters.Add(
            "@FunctionalArea",
            SqlDbType.VarChar,
            2).Value = Normalize(functionalArea);
    }

    private static void AddHistoryParameter(
        SqlCommand command,
        string? history)
    {
        var value = Normalize(history);

        if (value != "Y")
            value = "N";

        command.Parameters.Add(
            "@History",
            SqlDbType.VarChar,
            1).Value = value;
    }

    private static void AddRemarkKeyParameters(
        SqlCommand command,
        D158302RemarkKey key)
    {
        command.Parameters.Add(
            "@LastUpdated",
            SqlDbType.VarChar,
            8).Value = Normalize(key.LastUpdated);

        command.Parameters.Add(
            "@RemarkType",
            SqlDbType.Int).Value = key.RemarkType;

        command.Parameters.Add(
            "@RemarkSequence",
            SqlDbType.Int).Value = key.RemarkSequence;
    }

    // ============================================================
    // VALUE HELPERS
    // ============================================================

    private static string ReadString(
        SqlDataReader reader,
        string columnName)
    {
        var value = reader[columnName];

        if (value is null || value == DBNull.Value)
            return "";

        // Handles database DATE/DATETIME if LAST_UPDATED is
        // represented as an actual SQL date.
        if (value is DateTime date)
        {
            return date.ToString(
                "yyyyMMdd",
                CultureInfo.InvariantCulture);
        }

        return Convert.ToString(
                   value,
                   CultureInfo.InvariantCulture)
                   ?.Trim()
               ?? "";
    }

    private static int ReadInt(
        SqlDataReader reader,
        string columnName)
    {
        var value = reader[columnName];

        if (value is null || value == DBNull.Value)
            return 0;

        if (value is int intValue)
            return intValue;

        if (value is short shortValue)
            return shortValue;

        if (value is long longValue)
            return checked((int)longValue);

        if (value is decimal decimalValue)
            return Convert.ToInt32(decimalValue);

        return int.TryParse(
            value.ToString()?.Trim(),
            out var parsed)
            ? parsed
            : 0;
    }

    private static string Normalize(
        string? value)
    {
        return (value ?? "")
            .Replace("'", "")
            .Trim()
            .ToUpperInvariant();
    }
}
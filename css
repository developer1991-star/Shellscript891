           IF CURSOR-POSITION >= 00258 AND <= 00260                                                                                                                                                     
              MOVE 1 TO WFA-CURSOR.                                                                                                                                                                     
           IF CURSOR-POSITION >= 00262 AND <= 00276                                                                                                                                                     
              MOVE 1 TO WFA-TRANS-CURSOR.                                                                                                                                                               

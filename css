@page
@model PCPM.Pages.D158803Model
@{
    Layout = null;
    ViewData["Title"] = "D158803";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158803</title>
    <link rel="stylesheet" href="/css/pcpm-terminal.css" />

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #F2F3FF;
            color: #111;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
        }

        .legacy-screen {
            position: relative;
            width: 820px;
            height: 620px;
            margin: 0 auto;
            font-family: "Courier New", Courier, monospace;
            font-weight: 700;
        }

        .legacy-label {
            position: absolute;
            white-space: pre;
            line-height: 20px;
        }

        .legacy-input {
            position: absolute;
            box-sizing: border-box;
            height: 22px;
            padding: 1px 2px;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            color: #111;
            background: white;
            border: 1px solid #666;
            border-radius: 0;
        }

        .legacy-input:focus {
            outline: none;
            background: #ffff00;
        }

        .legacy-input[readonly] {
            background: LightGray;
        }

        .pf-button {
            position: absolute;
            border: none;
            background: transparent;
            padding: 0;
            margin: 0;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            color: #111;
            cursor: pointer;
            white-space: pre;
        }

        .pf-button:hover,
        .pf-button:focus {
            text-decoration: underline;
        }

        .default-submit {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
        }

        .error-message {
            position: absolute;
            left: 10px;
            top: 575px;
            width: 790px;
            color: red;
            white-space: pre-wrap;
        }

        .offline-message {
            position: absolute;
            left: 20px;
            top: 1px;
            color: red;
        }
    </style>
</head>

<body>
<form method="post"
      action="/D158803?fa=@Uri.EscapeDataString(Model.Wfa ?? string.Empty)">

    @Html.AntiForgeryToken()

    <div class="legacy-screen">

        <button type="submit"
                name="Command"
                value="ENTER"
                class="default-submit"
                tabindex="-1">
        </button>

        @* -----------------------------------------------------------------
           HEADER
           ----------------------------------------------------------------- *@

        <span class="legacy-label"
              style="left:10px; top:25px;">ACTION</span>

        <input class="legacy-input"
               id="Action"
               name="Action"
               value="@Model.Action"
               maxlength="3"
               style="left:90px; top:25px; width:24px;"
               tabindex="1"
               autofocus />

        <span class="legacy-label"
              style="left:190px; top:25px;">ARDOT PRE-CONSTRUCTION PROJECT MONITORING</span>

        <span class="legacy-label"
              style="left:710px; top:25px;">D158803</span>

        <span class="legacy-label"
              style="left:10px; top:50px;">SCREEN</span>

        <span class="legacy-label"
              style="left:90px; top:50px;">803</span>

        <span class="legacy-label"
              style="left:250px; top:50px;">INQUIRY STANDARD REMARKS PANEL</span>

        <span class="legacy-label"
              style="left:680px; top:50px;">@Model.DateText</span>

        <span class="legacy-label"
              style="left:10px; top:75px;">=============================================================================</span>

        @* -----------------------------------------------------------------
           CONTEXT
           ----------------------------------------------------------------- *@

        <span class="legacy-label"
              style="left:10px; top:100px;">FUNCTIONAL AREA</span>

        <input class="legacy-input"
               value="@Model.Wfa"
               maxlength="2"
               readonly
               style="left:180px; top:100px; width:16px;"
               tabindex="2" />

        <span class="legacy-label"
              style="left:220px; top:100px;">@Model.WfaTranslation</span>

        <span class="legacy-label"
              style="left:620px; top:100px;">USER ID</span>

        <span class="legacy-label"
              style="left:710px; top:100px;">@Model.UserId</span>

        <span class="legacy-label"
              style="left:10px; top:125px;">-----------------------------------------------------------------------------</span>

        @* -----------------------------------------------------------------
           STANDARD REMARKS
           ----------------------------------------------------------------- *@

        <span class="legacy-label"
              style="left:270px; top:150px;">STANDARDIZED REMARKS</span>

        <span class="legacy-label"
              style="left:170px; top:175px;">FA</span>

        <span class="legacy-label"
              style="left:210px; top:175px;">TYPE</span>

        <span class="legacy-label"
              style="left:460px; top:175px;">REMARK</span>

        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var top = 200 + (i * 25);

            <span class="legacy-label"
                  style="@($"left:170px; top:{top}px;")">@Model.Rows[i].FunctionalArea</span>

            <span class="legacy-label"
                  style="@($"left:220px; top:{top}px;")">@Model.Rows[i].RemarkType</span>

            <span class="legacy-label"
                  style="@($"left:280px; top:{top}px;")">@Model.Rows[i].Remark</span>
        }

        <span class="legacy-label"
              style="left:10px; top:525px;">-----------------------------------------------------------------------------</span>

        @* -----------------------------------------------------------------
           FUNCTION KEYS
           ----------------------------------------------------------------- *@

        <button type="submit"
                name="Command"
                value="PF1"
                data-command="PF1"
                class="pf-button"
                style="left:10px; top:550px;"> F1=HELP</button>

        <button type="submit"
                name="Command"
                value="PF3"
                data-command="PF3"
                class="pf-button"
                style="left:100px; top:550px;"> F3=PREV</button>

        <button type="submit"
                name="Command"
                value="PF4"
                data-command="PF4"
                class="pf-button"
                style="left:190px; top:550px;"> F4=SCRLB</button>

        <button type="submit"
                name="Command"
                value="PF5"
                data-command="PF5"
                class="pf-button"
                style="left:290px; top:550px;"> F5=SCRLF</button>

        <button type="submit"
                name="Command"
                value="PF6"
                data-command="PF6"
                class="pf-button"
                style="left:390px; top:550px;"> F6=RESET</button>

        <button type="submit"
                name="Command"
                value="PF12"
                data-command="PF12"
                class="pf-button"
                style="left:490px; top:550px;"> F12=MAIN</button>

        <button type="submit"
                name="Command"
                value="ENTER"
                data-command="ENTER"
                class="pf-button"
                style="left:590px; top:550px;">ENTER=ACCEPT</button>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.OfflineMessage))
        {
            <div class="offline-message">@Model.OfflineMessage</div>
        }
    </div>
</form>

<script>
    (() => {
        const action = document.getElementById("Action");

        action?.addEventListener("input", () => {
            action.value = action.value.toUpperCase();
        });

        document.addEventListener("keydown", event => {
            const map = {
                "F1": "PF1",
                "F3": "PF3",
                "F4": "PF4",
                "F5": "PF5",
                "F6": "PF6",
                "F12": "PF12"
            };

            const command = map[event.key];

            if (command) {
                event.preventDefault();

                const button =
                    document.querySelector(`[data-command="${command}"]`);

                button?.click();
                return;
            }

            if (event.key === "Enter" &&
                event.target instanceof HTMLInputElement) {

                event.preventDefault();

                document
                    .querySelector('[data-command="ENTER"]')
                    ?.click();
            }
        });

        action?.focus();
    })();
</script>
</body>
</html>



using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158803Model : PageModel
{
    private const int RowCount = 13;

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string Command { get; set; } = string.Empty;

    public string DateText { get; private set; } = "00/00/0000";

    public string Wfa { get; private set; } = string.Empty;

    public string WfaTranslation { get; private set; } = string.Empty;

    public string UserId { get; private set; } = string.Empty;

    public string ErrorMessage { get; private set; } = string.Empty;

    public string OfflineMessage { get; private set; } = string.Empty;

    public List<StandardRemarkRow> Rows { get; private set; } = [];

    public async Task OnGetAsync(string? fa)
    {
        InitializeContext(fa);

        await LoadScreenDataAsync();
    }

    public async Task<IActionResult> OnPostAsync(string? fa)
    {
        InitializeContext(fa);

        Action = Normalize(Action, 3);
        Command = Normalize(Command, 10);

        /*
         * Display-only fields are intentionally reloaded server-side.
         * We do not trust posted copies of FA / REMTYPE / STDREM.
         */
        await LoadScreenDataAsync();

        switch (Command)
        {
            case "PF1":
                /*
                 * TODO:
                 * Exact Help handling must come from the D158803
                 * business COBOL.
                 */
                ErrorMessage =
                    "D158803 HELP ROUTE HAS NOT YET BEEN WIRED.";

                return Page();

            case "PF3":
                /*
                 * PROVISIONAL:
                 * D158800 is the menu that launches D158803.
                 */
                return RedirectToPage("/D158800", new
                {
                    fa = Wfa
                });

            case "PF4":
                /*
                 * TODO:
                 * The wrapper exposes F4=SCRLB, but does not establish
                 * the authoritative browse key/order/scroll behavior.
                 */
                ErrorMessage =
                    "D158803 SCRLB BUSINESS LOGIC HAS NOT YET BEEN WIRED.";

                return Page();

            case "PF5":
                /*
                 * TODO:
                 * Main COBOL required for exact SCRLF behavior.
                 */
                ErrorMessage =
                    "D158803 SCRLF BUSINESS LOGIC HAS NOT YET BEEN WIRED.";

                return Page();

            case "PF6":
                Action = string.Empty;

                await LoadScreenDataAsync();

                return Page();

            case "PF12":
                /*
                 * PROVISIONAL existing PCPM convention.
                 */
                return RedirectToPage("/D158000");

            case "ENTER":
            case "":
                /*
                 * The inquiry screen has no editable detail rows.
                 * The main COBOL may use ENTER for other control
                 * processing, so for now simply redisplay trusted data.
                 */
                return Page();

            default:
                ErrorMessage =
                    $"ACTION '{Action}' IS NOT YET WIRED FOR D158803.";

                return Page();
        }
    }

    private void InitializeContext(string? fa)
    {
        /*
         * Temporary integration point with the D158800 menu.
         *
         * Replace this with the established D158000
         * IPcpmSessionService access once that exact API is reused
         * on this screen.
         */
        Wfa = Normalize(fa, 2);

        UserId = GetLegacyUserId();

        DateText = DateTime.Today.ToString("MM/dd/yyyy");
    }

    private async Task LoadScreenDataAsync()
    {
        /*
         * TODO BUSINESS/DATA INTEGRATION
         *
         * Authoritative wrapper structure:
         *
         *   WFA        PIC X(2)
         *   WFA-TRANS  PIC X(14)
         *   USRID      PIC X(7)
         *
         *   OCCURS 13:
         *      FA       PIC X(2)
         *      REMTYPE  PIC X(3)
         *      STDREM   PIC X(50)
         *
         * We do not yet have the main D158803 business COBOL, so
         * physical SQL/view/table names and ordering must not be
         * invented here.
         *
         * Replace this placeholder with an Application service.
         * Put SQL implementation in PCPM.Infrastructure.
         */

        await Task.CompletedTask;

        WfaTranslation ??= string.Empty;

        Rows = Enumerable.Range(0, RowCount)
            .Select(_ => new StandardRemarkRow())
            .ToList();

        /*
         * Future shape:
         *
         * var result =
         *     await _standardRemarkService
         *         .GetInquiryRowsAsync(Wfa);
         *
         * WfaTranslation = result.FunctionalAreaDescription;
         *
         * Rows = result.Rows
         *     .Take(RowCount)
         *     .Select(x => new StandardRemarkRow
         *     {
         *         FunctionalArea = x.FunctionalArea,
         *         RemarkType = FormatRemarkType(x.RemarkType),
         *         Remark = x.Remark
         *     })
         *     .ToList();
         */
    }

    private string GetLegacyUserId()
    {
        var name =
            User?.Identity?.Name ?? string.Empty;

        var slash =
            name.LastIndexOf('\\');

        if (slash >= 0 &&
            slash < name.Length - 1)
        {
            name = name[(slash + 1)..];
        }

        return Normalize(name, 7);
    }

    private static string Normalize(
        string? value,
        int maxLength)
    {
        var result =
            (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        if (result.Length > maxLength)
        {
            result = result[..maxLength];
        }

        return result;
    }

    public sealed class StandardRemarkRow
    {
        public string FunctionalArea { get; set; } = string.Empty;

        public string RemarkType { get; set; } = string.Empty;

        public string Remark { get; set; } = string.Empty;
    }
}

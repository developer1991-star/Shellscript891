      *                                                                                                                                                                                                 
      ************************************************                                                                                                                                                  
      *                                                                                                                                                                                                 
      * LOAD SCREEN WITH FIELD ATTRIBUTES FROM PROGRAM                                                                                                                                                  
      *                                                                                                                                                                                                 
      ************************************************                                                                                                                                                  
      *                                                                                                                                                                                                 
       method-id.  Modify_Attributes protected.                                                                                                                                                         
       procedure division.                                                                                                                                                                              
           IF ACTION-ATTR NOT = SPACES                                                                                                                                                                  
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT ACTION-ATTR TALLYING UCT-COUNT FOR ALL "U"                                                                                                                                        
              INSPECT ACTION-ATTR TALLYING UCT-COUNT FOR ALL "C"                                                                                                                                        
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_ACTION::ReadOnly to False                                                                                                                                                        
                 set S_ACTION::BackColor to type System.Drawing.Color::White                                                                                                                            
              END-IF                                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT ACTION-ATTR TALLYING UCT-COUNT FOR ALL "P"                                                                                                                                        
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_ACTION::ReadOnly to True                                                                                                                                                         
                 set S_ACTION::BackColor to type System.Drawing.Color::LightGray                                                                                                                        
              END-IF                                                                                                                                                                                    
              IF ACTION-ATTR(1:3) = "UAH"                                                                                                                                                               
                 set S_ACTION::BorderColor to type System.Drawing.Color::Red                                                                                                                            
                 set S_ACTION::BorderStyle to type System.Web.UI.WebControls.BorderStyle::Solid                                                                                                         
              ELSE                                                                                                                                                                                      
                 set S_ACTION::BorderColor to type System.Drawing.Color::White                                                                                                                          
                 set S_ACTION::BorderStyle to type System.Web.UI.WebControls.BorderStyle::NotSet                                                                                                        
              END-IF                                                                                                                                                                                    
           END-IF.                                                                                                                                                                                      
           IF WFA-ATTR NOT = SPACES                                                                                                                                                                     
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT WFA-ATTR TALLYING UCT-COUNT FOR ALL "U"                                                                                                                                           
              INSPECT WFA-ATTR TALLYING UCT-COUNT FOR ALL "C"                                                                                                                                           
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_WFA::ReadOnly to False                                                                                                                                                           
                 set S_WFA::BackColor to type System.Drawing.Color::White                                                                                                                               
              END-IF                                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT WFA-ATTR TALLYING UCT-COUNT FOR ALL "P"                                                                                                                                           
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_WFA::ReadOnly to True                                                                                                                                                            
                 set S_WFA::BackColor to type System.Drawing.Color::LightGray                                                                                                                           
              END-IF                                                                                                                                                                                    
              IF WFA-ATTR(1:3) = "UAH"                                                                                                                                                                  
                 set S_WFA::BorderColor to type System.Drawing.Color::Red                                                                                                                               
                 set S_WFA::BorderStyle to type System.Web.UI.WebControls.BorderStyle::Solid                                                                                                            
              ELSE                                                                                                                                                                                      
                 set S_WFA::BorderColor to type System.Drawing.Color::White                                                                                                                             
                 set S_WFA::BorderStyle to type System.Web.UI.WebControls.BorderStyle::NotSet                                                                                                           
              END-IF                                                                                                                                                                                    
           END-IF.
CNVTEL     IF PF1-KEY-ATTR NOT = SPACES
CNVTEL        MOVE ZERO TO UCT-COUNT
CNVTEL        INSPECT PF1-KEY-ATTR TALLYING UCT-COUNT FOR ALL "I"

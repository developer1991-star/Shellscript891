              MOVE WS-NUMERIC-CHECK TO I-REMTYPE(12)                                                                                                                                                    
           ELSE                                                                                                                                                                                         
              MOVE "2" TO  REMTYPE-ERROR(12)                                                                                                                                                            
              MOVE 1 TO  VALIDATION-ERROR                                                                                                                                                               
              GO TO Validation_Rules_Exit.                                                                                                                                                              
           IF WS-NC-DECIMAL-COUNT >  00                                                                                                                                                                 
              MOVE "2" TO  REMTYPE-ERROR(12)                                                                                                                                                            
              MOVE 1 TO  VALIDATION-ERROR                                                                                                                                                               
              GO TO Validation_Rules_Exit.                                                                                                                                                              
           MOVE I-REMTYPE(13) TO WS-NUMERIC-CHECK.                                                                                                                                                      
           Invoke "Check_Numeric_Logic".                                                                                                                                                                
           IF WS-NUMERIC-CHECK-FLAG = "Y"                                                                                                                                                               
              MOVE WS-NUMERIC-CHECK TO I-REMTYPE(13)                                                                                                                                                    
           ELSE                                                                                                                                                                                         
              MOVE "2" TO  REMTYPE-ERROR(13)                                                                                                                                                            
              MOVE 1 TO  VALIDATION-ERROR                                                                                                                                                               
              GO TO Validation_Rules_Exit.                                                                                                                                                              
           IF WS-NC-DECIMAL-COUNT >  00                                                                                                                                                                 
              MOVE "2" TO  REMTYPE-ERROR(13)                                                                                                                                                            
              MOVE 1 TO  VALIDATION-ERROR                                                                                                                                                               
              GO TO Validation_Rules_Exit.                                                                                                                                                              
                                                                                                                                                                                                        
       Validation_Rules_Exit.                                                                                                                                                                           

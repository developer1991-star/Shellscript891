@page
@model PCPM.Pages.D158500Model
@{
    Layout = null;
    ViewData["Title"] = "D158500";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>D158500</title>

    <link rel="stylesheet"
          href="~/css/pcpm-terminal.css"
          asp-append-version="true" />
</head>

<body>

    <div class="pcpm-screen">

        <form method="post"
              asp-page="/D158500"
              id="pcpmForm"
              class="pcpm-form">


            <!-- =========================================================
                 HEADER
                 ========================================================= -->

            <div class="pcpm-header-row">

                <div class="pcpm-header-left">

                    ACTION

                    <input asp-for="Action"
                           class="pcpm-input pcpm-input-3"
                           maxlength="3"
                           autocomplete="off"
                           oninput="this.value = this.value.toUpperCase();"
                           autofocus />

                </div>


                <div class="pcpm-header-center">
                    ARDOT PRE-CONSTRUCTION PROJECT MONITORING
                </div>


                <div class="pcpm-header-right">
                    D158500
                </div>

            </div>


            <div class="pcpm-header-row">

                <div class="pcpm-header-left">
                    SCREEN&nbsp;&nbsp;500
                </div>


                <div class="pcpm-header-center">
                    JOB STATUS SUMMARY INQUIRY
                </div>


                <div class="pcpm-header-right">
                    @Model.DisplayDate
                </div>

            </div>


            <div class="pcpm-separator"></div>


            <!-- =========================================================
                 JOB
                 ========================================================= -->

            <div class="d158500-job-row">

                <span>JOB NUMBER:</span>

                <input asp-for="JobNumber"
                       class="pcpm-input pcpm-input-job"
                       maxlength="10"
                       autocomplete="off"
                       oninput="this.value = this.value.toUpperCase();"
                       readonly="@(Model.Screen?.ScreenReset == true ? null : "readonly")" />

                <input type="hidden" asp-for="OriginalJobNumber" />
                <span>NAME:</span>

                <span>@Model.JobName</span>

            </div>


            <!-- =========================================================
                 SUMMARY
                 ========================================================= -->

            <div class="d158500-summary-row">

                <span>SF</span>

                <input asp-for="SF"
                       class="pcpm-input pcpm-input-1"
                       maxlength="1"
                       autocomplete="off"
                       oninput="this.value = this.value.toUpperCase();" />


                <span>TOTAL FUNDING:</span>

                <span>@Model.TotalFunding</span>


                <span>PS&amp;E:</span>

                <span>@Model.PseEnd</span>


                <span>VALUE ENGINEERING:</span>

                <span>@Model.ValueEngineeringPercent</span>

            </div>


            <!-- =========================================================
                 TABLE HEADER
                 ========================================================= -->

            <div class="d158500-table-header">

                <span>SEL</span>

                <span>FUNCTIONAL AREA</span>

                <span>FA</span>

                <span>STARTED</span>

                <span>PROJ COM</span>

                <span>% COMPL</span>

                <span>COMPLETE</span>

                <span>FLAG</span>

            </div>


            <!-- =========================================================
                 11 STATUS ROWS
                 ========================================================= -->
            @for (var i = 0;
            i < Model.Rows.Count;
            i++)
            {
                <div class="d158500-table-row">

                   

                    <input asp-for="Selections[i]"
                           class="pcpm-input pcpm-input-1 selection-field"
                           maxlength="1"
                           autocomplete="off" 
                           oninput="this.value = this.value.toUpperCase();" />


                    <span>
                        @Model.Rows[i].Description
                    </span>


                    <span>
                        @Model.Rows[i].FunctionalArea
                    </span>


                    <span>
                        @Model.Rows[i].StartDate
                    </span>


                    <span>
                        @Model.Rows[i].ProjectedEndDate
                    </span>


                    <span>
                        @Model.Rows[i].Percent
                    </span>


                    <span>
                        @Model.Rows[i].EndDate
                    </span>


                    <span>
                        @Model.Rows[i].Status
                    </span>

                </div>
            }


            <!-- =========================================================
                 REMARK
                 ========================================================= -->

            <div class="d158500-remark-row">

                <input asp-for="SelRem"
                       class="pcpm-input pcpm-input-1"
                       maxlength="1"
                       autocomplete="off"
                       oninput="this.value = this.value.toUpperCase();" />


                <span>LAST REMARK:</span>


                <span>
                    @Model.LatestRemark
                </span>


                <span>
                    @Model.LastUpdated
                </span>

            </div>


            <div class="pcpm-separator"></div>


            <!-- =========================================================
                 FUNCTION KEYS
                 ========================================================= -->

            <div class="pcpm-function-keys">

                <button type="submit"
                        asp-page-handler="Help"
                        id="helpButton"
                        class="pcpm-function-button">
                    F1=HELP
                </button>


                <button type="submit"
                        asp-page-handler="Previous"
                        id="previousButton"
                        class="pcpm-function-button">
                    F3=PREVIOUS
                </button>


                <button type="submit"
                        asp-page-handler="Reset"
                        id="resetButton"
                        class="pcpm-function-button">
                    F6=RESET
                </button>


                <button type="submit"
                        asp-page-handler="Backward"
                        id="backwardButton"
                        class="pcpm-function-button">
                    F7=BACKWARD
                </button>


                <button type="submit"
                        asp-page-handler="Forward"
                        id="forwardButton"
                        class="pcpm-function-button">
                    F8=FORWARD
                </button>


                <button type="submit"
                        asp-page-handler="MainMenu"
                        id="mainMenuButton"
                        class="pcpm-function-button">
                    F12=MAIN MENU
                </button>

            </div>


            <div class="pcpm-error">
                @Model.ErrorMessage
            </div>


            <button type="submit"
                    id="enterButton"
                    class="pcpm-hidden-submit">
            </button>

        </form>

    </div>


    <script>
        (() => {

            document.querySelectorAll(
                ".selection-field, .pcpm-input"
            ).forEach(input => {

                input.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value.toUpperCase();

                    });

            });


            document.addEventListener(
                "keydown",
                function (event) {

                    let id = null;


                    switch (event.key) {

                        case "Enter":
                            id = "enterButton";
                            break;

                        case "F1":
                            id = "helpButton";
                            break;

                        case "F3":
                            id = "previousButton";
                            break;

                        case "F6":
                            id = "resetButton";
                            break;

                        case "F7":
                            id = "backwardButton";
                            break;

                        case "F8":
                            id = "forwardButton";
                            break;

                        case "F12":
                            id = "mainMenuButton";
                            break;
                    }


                    if (!id)
                        return;


                    event.preventDefault();


                    document
                        .getElementById(id)
                        .click();

                });

        })();
    </script>

</body>
</html>

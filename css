
public async Task<IReadOnlyList<D158302RemarkRecord>>
    GetRemarksForwardAsync(
        string jobNumber,
        string functionalArea,
        string history,
        D158302RemarkKey? bottomKey,
        int count,
        CancellationToken cancellationToken = default)
{
    if (count <= 0)
        return Array.Empty<D158302RemarkRecord>();

    var sql = @"
        SELECT TOP (@Count)
            JOBNO,
            FUNC_AREA,
            REMARK_R,
            LAST_UPDATED,
            REMTYPE,
            REMSEQ,
            REM_STA_FLAG,
            REM_DIS_FLAG,
            HIST_FLAG,
            USERID_R
        FROM [PRECONSTRUCTION].[dbo].[T158_REMARKS]
        WHERE ISNULL(LTRIM(RTRIM(DELFLAG)), '') = ''
          AND LTRIM(RTRIM(HIST_FLAG)) =
              LTRIM(RTRIM(@History))
          AND LTRIM(RTRIM(JOBNO)) =
              LTRIM(RTRIM(@JobNumber))
          AND LTRIM(RTRIM(FUNC_AREA)) =
              LTRIM(RTRIM(@FunctionalArea))";

    if (bottomKey is not null)
    {
        sql += @"
          AND
          (
                LTRIM(RTRIM(LAST_UPDATED)) < @LastUpdated

             OR
             (
                 LTRIM(RTRIM(LAST_UPDATED)) = @LastUpdated
                 AND REMTYPE < @RemarkType
             )

             OR
             (
                 LTRIM(RTRIM(LAST_UPDATED)) = @LastUpdated
                 AND REMTYPE = @RemarkType
                 AND REMSEQ < @RemarkSequence
             )
          )";
    }

    sql += @"
        ORDER BY
            LAST_UPDATED DESC,
            REMTYPE DESC,
            REMSEQ DESC;";

    var records =
        new List<D158302RemarkRecord>();

    await using var connection =
        new SqlConnection(_connectionString);

    await connection.OpenAsync(cancellationToken);

    await using var command =
        new SqlCommand(sql, connection);

    AddJobNumberParameter(
        command,
        jobNumber);

    AddFunctionalAreaParameter(
        command,
        functionalArea);

    AddHistoryParameter(
        command,
        history);

    command.Parameters.Add(
        "@Count",
        SqlDbType.Int).Value = count;

    if (bottomKey is not null)
    {
        AddRemarkKeyParameters(
            command,
            bottomKey);
    }

    await using var reader =
        await command.ExecuteReaderAsync(cancellationToken);

    while (await reader.ReadAsync(cancellationToken))
    {
        records.Add(
            MapRemark(reader));
    }

    return records;
}






public async Task<IReadOnlyList<D158302RemarkRecord>>
    GetRemarksBackwardAsync(
        string jobNumber,
        string functionalArea,
        string history,
        D158302RemarkKey topKey,
        int count,
        CancellationToken cancellationToken = default)
{
    if (count <= 0)
        return Array.Empty<D158302RemarkRecord>();

    const string sql = @"
        SELECT TOP (@Count)
            JOBNO,
            FUNC_AREA,
            REMARK_R,
            LAST_UPDATED,
            REMTYPE,
            REMSEQ,
            REM_STA_FLAG,
            REM_DIS_FLAG,
            HIST_FLAG,
            USERID_R
        FROM [PRECONSTRUCTION].[dbo].[T158_REMARKS]
        WHERE ISNULL(LTRIM(RTRIM(DELFLAG)), '') = ''
          AND LTRIM(RTRIM(HIST_FLAG)) =
              LTRIM(RTRIM(@History))
          AND LTRIM(RTRIM(JOBNO)) =
              LTRIM(RTRIM(@JobNumber))
          AND LTRIM(RTRIM(FUNC_AREA)) =
              LTRIM(RTRIM(@FunctionalArea))
          AND
          (
                LTRIM(RTRIM(LAST_UPDATED)) > @LastUpdated

             OR
             (
                 LTRIM(RTRIM(LAST_UPDATED)) = @LastUpdated
                 AND REMTYPE > @RemarkType
             )

             OR
             (
                 LTRIM(RTRIM(LAST_UPDATED)) = @LastUpdated
                 AND REMTYPE = @RemarkType
                 AND REMSEQ > @RemarkSequence
             )
          )
        ORDER BY
            LAST_UPDATED ASC,
            REMTYPE ASC,
            REMSEQ ASC;";

    var records =
        new List<D158302RemarkRecord>();

    await using var connection =
        new SqlConnection(_connectionString);

    await connection.OpenAsync(cancellationToken);

    await using var command =
        new SqlCommand(sql, connection);

    AddJobNumberParameter(
        command,
        jobNumber);

    AddFunctionalAreaParameter(
        command,
        functionalArea);

    AddHistoryParameter(
        command,
        history);

    command.Parameters.Add(
        "@Count",
        SqlDbType.Int).Value = count;

    AddRemarkKeyParameters(
        command,
        topKey);

    await using var reader =
        await command.ExecuteReaderAsync(cancellationToken);

    while (await reader.ReadAsync(cancellationToken))
    {
        records.Add(
            MapRemark(reader));
    }

    // Database query is ASC because this is reverse scrolling.
    // Screen 302 displays remarks newest to oldest.
    records.Reverse();

    return records;
}





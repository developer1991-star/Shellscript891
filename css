    private readonly string _connectionString;

    public D158302Repository(IConfiguration configuration)
    {
        _connectionString =
            configuration.GetConnectionString("PCPM")
            ?? throw new InvalidOperationException(
                "Connection string 'PCPM' was not found.");
    }

    // ============================================================
    // STATUS
    // Legacy: LOAD-STATUS-REC
    //
    // STATUS_R = '01'
    // DELFLAG = blank
    // FUNC_AREA = requested FA
    // JOBNO >= requested job
    // ============================================================

    public async Task<D158302StatusRecord?> FindStatusAsync(
        string jobNumber,
        string functionalArea,
        CancellationToken cancellationToken = default)
    {
        const string sql = """
            SELECT TOP (1)
                JOBNO,
                FUNC_AREA,
                FA_STATUS,
                FA_PERCENT,
                FA_START_DATE,
                FA_PROJ_END,
                FA_END,
                LAST_UPDATED,
                USERID_R
            FROM [PRECONSTRUCTION].[dbo].[T158_PRECON_STATUS]
            WHERE LTRIM(RTRIM(STATUS_R)) = '01'
              AND ISNULL(LTRIM(RTRIM(DELFLAG)), '') = ''
              AND LTRIM(RTRIM(FUNC_AREA)) =
                  LTRIM(RTRIM(@FunctionalArea))
              AND LTRIM(RTRIM(JOBNO)) >=
                  LTRIM(RTRIM(@JobNumber))
            ORDER BY
                LTRIM(RTRIM(JOBNO)) ASC,
                LTRIM(RTRIM(FUNC_AREA)) ASC;
            """;

        await using var connection =
            new SqlConnection(_connectionString);

        await connection.OpenAsync(cancellationToken);

        await using var command =
            new SqlCommand(sql, connection);

        AddJobNumberParameter(command, jobNumber);
        AddFunctionalAreaParameter(command, functionalArea);

        await using var reader =
            await command.ExecuteReaderAsync(cancellationToken);

        if (!await reader.ReadAsync(cancellationToken))
            return null;

        return MapStatus(reader);
    }


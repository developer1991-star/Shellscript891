    // ============================================================
    // FUNCTIONAL AREA DESCRIPTION
    // Legacy: V158-FAR104R0 / T158_FUNC_AREA
    // ============================================================

    public async Task<string?> GetFunctionalAreaDescriptionAsync(
        string functionalArea,
        CancellationToken cancellationToken = default)
    {
        const string sql = """
            SELECT TOP (1)
                FUNC_AREA_DESC
            FROM [PRECONSTRUCTION].[dbo].[T158_FUNC_AREA]
            WHERE LTRIM(RTRIM(FUNC_AREA)) =
                  LTRIM(RTRIM(@FunctionalArea))
            ORDER BY LTRIM(RTRIM(FUNC_AREA)) ASC;
            """;

        await using var connection =
            new SqlConnection(_connectionString);

        await connection.OpenAsync(cancellationToken);

        await using var command =
            new SqlCommand(sql, connection);

        AddFunctionalAreaParameter(command, functionalArea);

        var result =
            await command.ExecuteScalarAsync(cancellationToken);

        if (result is null || result == DBNull.Value)
            return null;

        return result.ToString()?.Trim();
    }


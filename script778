using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PCPM.Application.D158500;

namespace PCPM.Pages;

public sealed class D158500Model : PageModel
{
    private readonly ID158500Service _service;

    public D158500Model(ID158500Service service)
    {
        _service = service;
    }

    // ------------------------------------------------------------
    // Editable fields from the Razor screen
    // ------------------------------------------------------------

    [BindProperty]
    public string Action { get; set; } = "";

    [BindProperty]
    public string JobNumber { get; set; } = "";

    /*
     * Important:
     * This allows us to determine whether ENTER was pressed after
     * typing a different job number.
     *
     * We do NOT need to alter D158500Input for this.
     */
    [BindProperty]
    public string OriginalJobNumber { get; set; } = "";

    [BindProperty]
    public string SF { get; set; } = "";

    [BindProperty]
    public string SelRem { get; set; } = "";

    [BindProperty]
    public List<string> Selections { get; set; } =
        Enumerable.Repeat("", 11).ToList();

    // ------------------------------------------------------------
    // Display model
    // ------------------------------------------------------------

    public D158500Screen Screen { get; private set; } =
        new();

    public string DisplayDate =>
        DateTime.Now.ToString("MM/dd/yyyy");

    public string JobName =>
        Screen.JobName;

    public string PseEnd =>
        Screen.PcEnd;

    public string ValueEngineeringPercent =>
        Screen.VePercent;

    public string LatestRemark =>
        Screen.LatestRemark;

    public string ErrorMessage =>
        Screen.ErrorMessage;

    public IReadOnlyList<D158500Row> Rows =>
        Screen.Rows;

    /*
     * Your current D158500Screen does NOT expose BidAmount.
     *
     * This property exists so existing Razor markup that references
     * Model.TotalFunding will compile.
     *
     * If you want the legacy Bid Amount displayed, see my note below.
     */
    public string TotalFunding => "";

    // ------------------------------------------------------------
    // Initial load
    // ------------------------------------------------------------

    public async Task OnGetAsync(
        string? jobNumber,
        CancellationToken cancellationToken)
    {
        Screen = await _service.LoadAsync(
            jobNumber,
            cancellationToken);

        ApplyScreenToPage();
    }

    // ------------------------------------------------------------
    // ENTER
    // ------------------------------------------------------------

    public async Task<IActionResult> OnPostAsync(
        CancellationToken cancellationToken)
    {
        return await ProcessEnterAsync(cancellationToken);
    }

    public async Task<IActionResult> OnPostEnterAsync(
        CancellationToken cancellationToken)
    {
        return await ProcessEnterAsync(cancellationToken);
    }

    private async Task<IActionResult> ProcessEnterAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        /*
         * Legacy NEW-JOB check:
         *
         * If the user typed another job number and pressed ENTER,
         * load that job rather than producing
         * "SELECTION NOT SPECIFIED".
         */
        if (!string.IsNullOrWhiteSpace(JobNumber) &&
            !string.Equals(
                JobNumber,
                OriginalJobNumber,
                StringComparison.OrdinalIgnoreCase))
        {
            Screen = await _service.LoadAsync(
                JobNumber,
                cancellationToken);

            ApplyScreenToPage();

            return Page();
        }

        /*
         * Reload trusted display data.
         *
         * We do not trust functional-area codes sent from the browser.
         * Only the selection boxes are taken from the POST.
         */
        var trustedScreen = await _service.LoadAsync(
            JobNumber,
            cancellationToken);

        var input = BuildInput(trustedScreen);

        var result = await _service.ProcessEnterAsync(
            input,
            cancellationToken);

        if (result.Navigate)
        {
            return Navigate(result);
        }

        Screen =
            result.Screen ??
            trustedScreen;

        /*
         * Do not call ApplyScreenToPage here because that would
         * clear the user's posted selection values after an error.
         */
        OriginalJobNumber = Screen.JobNumber;

        EnsureSelections();

        return Page();
    }

    // ------------------------------------------------------------
    // F6 RESET
    // ------------------------------------------------------------

    public async Task<IActionResult> OnPostResetAsync(
        CancellationToken cancellationToken)
    {
        Screen = await _service.ResetAsync(
            cancellationToken);

        Action = "";
        JobNumber = "";
        OriginalJobNumber = "";
        SF = "";
        SelRem = "";

        Selections =
            Enumerable.Repeat("", 11).ToList();

        return Page();
    }

    // ------------------------------------------------------------
    // F7 BACKWARD
    // ------------------------------------------------------------

    public async Task<IActionResult> OnPostBackwardAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        var currentJob =
            !string.IsNullOrWhiteSpace(OriginalJobNumber)
                ? OriginalJobNumber
                : JobNumber;

        Screen = await _service.ScrollBackwardAsync(
            currentJob,
            cancellationToken);

        ApplyScreenToPage();

        return Page();
    }

    // ------------------------------------------------------------
    // F8 FORWARD
    // ------------------------------------------------------------

    public async Task<IActionResult> OnPostForwardAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        var currentJob =
            !string.IsNullOrWhiteSpace(OriginalJobNumber)
                ? OriginalJobNumber
                : JobNumber;

        Screen = await _service.ScrollForwardAsync(
            currentJob,
            cancellationToken);

        ApplyScreenToPage();

        return Page();
    }

    // ------------------------------------------------------------
    // F1 HELP
    // ------------------------------------------------------------

    public IActionResult OnPostHelp()
    {
        /*
         * D158999 is your generic legacy help panel.
         *
         * Adjust the query parameter name only if your D158999
         * PageModel expects something different.
         */
        return RedirectToPage(
            "/D158999",
            new
            {
                screen = "500"
            });
    }

    // ------------------------------------------------------------
    // F3 PREVIOUS
    // ------------------------------------------------------------

    public IActionResult OnPostPrevious()
    {
        /*
         * Legacy code uses W-PREV / P-RECORD, which is effectively
         * a navigation stack.
         *
         * Until that navigation-stack state is wired into the new
         * session service, D158000 is the safe PCPM fallback.
         */
        return RedirectToPage("/D158000");
    }

    // ------------------------------------------------------------
    // F12 MAIN MENU
    // ------------------------------------------------------------

    public IActionResult OnPostMain()
    {
        return RedirectToPage("/D158000");
    }

    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------

    private D158500Input BuildInput(
        D158500Screen trustedScreen)
    {
        EnsureSelections();

        var input = new D158500Input
        {
            Action = Action,
            JobNumber = JobNumber,
            SummaryFunction = SF,
            RemarkSelection = SelRem,
            Rows = new List<D158500RowInput>()
        };

        for (var i = 0; i < trustedScreen.Rows.Count; i++)
        {
            var selection =
                i < Selections.Count
                    ? Selections[i]
                    : "";

            input.Rows.Add(
                new D158500RowInput
                {
                    FunctionalArea =
                        trustedScreen.Rows[i].FunctionalArea,

                    Selection = selection
                });
        }

        return input;
    }

    private IActionResult Navigate(
        D158500Result result)
    {
        var destination =
            result.DestinationPage?.Trim() ?? "";

        /*
         * Do not create a page named D158SO.
         */
        if (!destination.All(char.IsDigit))
        {
            Screen = new D158500Screen
            {
                JobNumber = JobNumber,
                ErrorMessage =
                    $"UNSUPPORTED NAVIGATION ACTION: {destination}"
            };

            return Page();
        }

        var pageName =
            $"/D158{destination}";

        /*
         * We are passing the context explicitly for now.
         *
         * If D158202 / D158302 / D158510 / D158550 use your
         * PcpmSessionService instead, replace these query values with
         * calls to that service.
         */
        return RedirectToPage(
            pageName,
            new
            {
                jobNumber = JobNumber,
                fa = result.FunctionalArea
            });
    }

    private void ApplyScreenToPage()
    {
        JobNumber = Screen.JobNumber;
        OriginalJobNumber = Screen.JobNumber;

        Action = "";
        SF = "";
        SelRem = "";

        Selections =
            Enumerable.Repeat(
                "",
                Math.Max(11, Screen.Rows.Count))
            .Take(11)
            .ToList();
    }

    private void NormalizePostedValues()
    {
        Action =
            (Action ?? "")
            .Trim()
            .ToUpperInvariant();

        JobNumber =
            (JobNumber ?? "")
            .Trim()
            .ToUpperInvariant();

        OriginalJobNumber =
            (OriginalJobNumber ?? "")
            .Trim()
            .ToUpperInvariant();

        SF =
            (SF ?? "")
            .Trim()
            .ToUpperInvariant();

        SelRem =
            (SelRem ?? "")
            .Trim()
            .ToUpperInvariant();

        EnsureSelections();

        for (var i = 0; i < Selections.Count; i++)
        {
            Selections[i] =
                (Selections[i] ?? "")
                .Trim()
                .ToUpperInvariant();
        }
    }

    private void EnsureSelections()
    {
        Selections ??= new List<string>();

        while (Selections.Count < 11)
            Selections.Add("");

        if (Selections.Count > 11)
        {
            Selections =
                Selections.Take(11).ToList();
        }
    }
}
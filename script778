@page
@model PCPM.Pages.D158999Model

@{
    Layout = null;
    ViewData["Title"] = "D158999";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <title>D158999</title>

    <link rel="stylesheet"
          href="~/css/pcpm-terminal.css"
          asp-append-version="true" />

    <style>

        .help-text {
            white-space: pre;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.55;
        }

    </style>

</head>

<body>

<div class="pcpm-screen">

<form method="post" id="pcpmForm">

    <input type="hidden" asp-for="Command" />

    <div class="header-grid">

        <div>
            <div>ACTION</div>
            <div class="screen-row">
                SCREEN&nbsp;&nbsp;&nbsp;999
            </div>
        </div>

        <div class="header-center">
            <div>ARDOT PRE-CONSTRUCTION PROJECT MONITORING</div>
            <div>HELP FOR PANEL @Model.HelpScreen</div>
        </div>

        <div class="header-right">
            <div>D158999</div>
            <div>@Model.DateText</div>
        </div>

    </div>

    <div class="separator"></div>

    <div class="input-row">

        <span>JOBNO</span>
        <span>@Model.JobNumber</span>

        <span>JOB SEQUENCE</span>
        <span>@Model.JobSequence</span>

        <span>FUNCTIONAL AREA</span>
        <span>@Model.FunctionalArea</span>

        <span>@Model.FunctionalAreaAuthority</span>

        <span>USERID</span>
        <span>@Model.UserId</span>

    </div>

<pre class="help-text">
--------------------------ACTION CODE ENTRIES--------------------------------
'SO' TO SIGN OFF   OR                 'NNN' (VALID PANEL NUMBER) FOR DIRECT NAVIGATION

------------------------SELECTION FIELD ENTRIES------------------------------
'A' SELECT FOR ADD                            'D' SELECT FOR DELETE
'U' SELECT FOR UPDATE (FA ACCESS REQUIRED)    'I' SELECT FOR INQUIRY
'S' SELECT FOR OTHER ACTION

------------------------PROGRAM FUNCTION KEYS--------------------------------
 F1   CALL HELP PANEL                  F2   NOT USED
 F3   GO TO PREVIOUS PANEL             F4   SCROLL LINES BACKWARD
 F5   SCROLL LINES FORWARD             F6   RESET FIELDS ON CURRENT PANEL
 F7   PAGE BACKWARD IN THE FILE        F8   PAGE FORWARD IN THE FILE
 F9   NOT USED                         F10  NOT USED
 F11  NOT USED                         F12  RETURN TO MAIN MENU
PF13  THRU  PF24 NOT USED
-----------------------------------------------------------------------------
</pre>

    <div class="function-keys">

        <button type="submit"
                class="function-button"
                onclick="setCommand('F3')">
            F3=PREVIOUS
        </button>

        <button type="submit"
                class="function-button"
                onclick="setCommand('F12')">
            F12=MAIN MENU
        </button>

    </div>

</form>

</div>

<script>

    function setCommand(command) {
        document.getElementById("Command").value =
            command;
    }

    document.addEventListener("keydown", function (event) {

        if (event.key !== "F3" &&
            event.key !== "F12")
            return;

        event.preventDefault();

        document.getElementById("Command").value =
            event.key;

        document.getElementById("pcpmForm").submit();

    });

</script>

</body>
</html>





using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158999Model : PageModel
{
    [BindProperty]
    public string Command { get; set; } = string.Empty;

    public string DateText { get; set; } = string.Empty;

    public string HelpScreen { get; set; } = string.Empty;

    public string JobNumber { get; set; } = string.Empty;

    public string JobSequence { get; set; } = string.Empty;

    public string FunctionalArea { get; set; } = string.Empty;

    public string FunctionalAreaAuthority { get; set; } =
        string.Empty;

    public string UserId { get; set; } = string.Empty;

    public void OnGet(string? screen = null)
    {
        var previousCurrent =
            HttpContext.Session.GetString("CurrentScreen");

        if (!string.IsNullOrWhiteSpace(previousCurrent) &&
            !string.Equals(
                previousCurrent,
                "D158999",
                StringComparison.OrdinalIgnoreCase))
        {
            HttpContext.Session.SetString(
                "PreviousScreen",
                previousCurrent);
        }

        HttpContext.Session.SetString(
            "CurrentScreen",
            "D158999");

        DateText =
            DateTime.Now.ToString("MM/dd/yyyy");

        HelpScreen =
            NormalizeScreen(screen)
            ?? NormalizeScreen(previousCurrent)
            ?? string.Empty;

        JobNumber =
            HttpContext.Session.GetString("JobNumber")
            ?? string.Empty;

        JobSequence =
            HttpContext.Session.GetString("JobSequence")
            ?? string.Empty;

        FunctionalArea =
            HttpContext.Session.GetString("FunctionalArea")
            ?? string.Empty;

        FunctionalAreaAuthority =
            HttpContext.Session.GetString(
                "FunctionalAreaAuthority")
            ?? string.Empty;

        var identity =
            User?.Identity?.Name ?? string.Empty;

        if (identity.Contains('\\'))
        {
            UserId =
                identity[
                    (identity.LastIndexOf('\\') + 1)..];
        }
        else
        {
            UserId = identity;
        }
    }

    public IActionResult OnPost()
    {
        switch (
            (Command ?? string.Empty)
            .Trim()
            .ToUpperInvariant())
        {
            case "F12":
                return RedirectToPage("/D158000");

            case "F3":
            default:
                return PreviousPage();
        }
    }

    private string? NormalizeScreen(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var screen =
            value.Trim().TrimStart('/');

        if (screen.StartsWith(
                "D158",
                StringComparison.OrdinalIgnoreCase))
        {
            screen = screen[4..];
        }

        return screen.All(char.IsDigit)
            ? screen
            : null;
    }

    private IActionResult PreviousPage()
    {
        var previous =
            HttpContext.Session.GetString("PreviousScreen");

        if (string.IsNullOrWhiteSpace(previous))
            return RedirectToPage("/D158000");

        return RedirectToPage(
            "/" + previous.Trim().TrimStart('/'));
    }
}


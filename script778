    public IActionResult OnPost()
    {
        DateText = DateTime.Now.ToString("MM/dd/yyyy");

        NormalizeUppercase();

        switch (Upper(Command))
        {
            case "F1":
                SaveWorkingSessionValues();

                return RedirectToPage(
                    "/D158999",
                    new { screen = "940" });

            case "F3":
                return PreviousPage();

            case "F4":
                ErrorMessage =
                    "SCROLL BACKWARD LOGIC HAS NOT YET BEEN CONNECTED.";
                return Page();

            case "F5":
                ErrorMessage =
                    "SCROLL FORWARD LOGIC HAS NOT YET BEEN CONNECTED.";
                return Page();

            case "F6":
                return ResetPage();

            case "F7":
                ErrorMessage =
                    "BACKWARD BROWSE LOGIC HAS NOT YET BEEN CONNECTED.";
                return Page();

            case "F8":
                ErrorMessage =
                    "FORWARD BROWSE LOGIC HAS NOT YET BEEN CONNECTED.";
                return Page();

            case "F12":
                return RedirectToPage("/D158000");
        }

        /*
         * The legacy ACTION field accepts navigation/action commands.
         * Exact business routing belongs in the migrated business
         * service once the main D158940 COBOL logic is connected.
         */
        if (!string.IsNullOrWhiteSpace(Action))
        {
            var actionResult = ProcessAction();

            if (actionResult != null)
                return actionResult;
        }

        /*
         * Legacy screen says:
         * ENTER 'S' TO SEE REMARKS
         */
        if (!string.IsNullOrWhiteSpace(RemarkSelection))
        {
            if (RemarkSelection != "S")
            {
                ErrorMessage =
                    "ENTER 'S' TO SEE REMARKS.";

                return Page();
            }

            SaveWorkingSessionValues();

            /*
             * The final target should follow the business COBOL.
             * D158950 is the detailed remark browse panel supplied
             * during this migration.
             */
            return RedirectToPage("/D158950");
        }

        ValidateLegacyNumericFields();

        if (!ModelState.IsValid)
        {
            ErrorMessage =
                "PLEASE CORRECT THE INVALID FIELD(S).";

            return Page();
        }

        SaveWorkingSessionValues();

        /*
         * TODO:
         *
         * Call the Application layer here.
         *
         * Example:
         *
         * await _projectStatusService.UpdateAsync(...);
         *
         * The SQL/repository implementation belongs in
         * PCPM.Infrastructure.
         *
         * Do not put SQL directly in this PageModel.
         */

        ErrorMessage =
            "PROJECT STATUS UPDATE SERVICE HAS NOT YET BEEN CONNECTED.";

        return Page();
    }


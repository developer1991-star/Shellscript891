    // =========================================================
    // PRIVATE HELPERS
    // =========================================================

    private async Task<IReadOnlyList<D158302RemarkRecord>>
        ReadRemarksAsync(
            string sql,
            Action<SqlCommand> configureCommand,
            bool reverseResults,
            CancellationToken cancellationToken)
    {
        var records =
            new List<D158302RemarkRecord>();

        await using var connection =
            new SqlConnection(_connectionString);

        await connection.OpenAsync(cancellationToken);

        await using var command =
            new SqlCommand(sql, connection);

        configureCommand(command);

        await using var reader =
            await command.ExecuteReaderAsync(cancellationToken);

        while (await reader.ReadAsync(cancellationToken))
        {
            records.Add(MapRemark(reader));
        }

        if (reverseResults)
            records.Reverse();

        return records;
    }

    private static void AddRemarkParameters(
        SqlCommand command,
        string jobNumber,
        string functionalArea,
        string historyFlag,
        string lastUpdated,
        int remarkType,
        int remarkSequence)
    {
        command.Parameters.AddWithValue(
            "@JobNumber",
            Normalize(jobNumber));

        command.Parameters.AddWithValue(
            "@FunctionalArea",
            Normalize(functionalArea));

        command.Parameters.AddWithValue(
            "@HistoryFlag",
            Normalize(historyFlag));

        command.Parameters.AddWithValue(
            "@LastUpdated",
            Normalize(lastUpdated));

        command.Parameters.AddWithValue(
            "@RemarkType",
            remarkType);

        command.Parameters.AddWithValue(
            "@RemarkSequence",
            remarkSequence);
    }

    private static D158302StatusRecord MapStatus(
        SqlDataReader reader)
    {
        return new D158302StatusRecord
        {
            JobNumber =
                ReadString(reader, "JOBNO"),

            FunctionalArea =
                ReadString(reader, "FUNC_AREA"),

            FunctionalAreaStatus =
                ReadString(reader, "FA_STATUS"),

            PercentComplete =
                ReadString(reader, "FA_PERCENT"),

            StartDate =
                ReadString(reader, "FA_START_DATE"),

            ProjectedEndDate =
                ReadString(reader, "FA_PROJ_END"),

            EndDate =
                ReadString(reader, "FA_END"),

            LastUpdated =
                ReadString(reader, "LAST_UPDATED"),

            UserId =
                ReadString(reader, "USERID_R")
        };
    }

    private static D158302RemarkRecord MapRemark(
        SqlDataReader reader)
    {
        return new D158302RemarkRecord
        {
            JobNumber =
                ReadString(reader, "JOBNO"),

            FunctionalArea =
                ReadString(reader, "FUNC_AREA"),

            Remark =
                ReadString(reader, "REMARK_R"),

            LastUpdated =
                ReadString(reader, "LAST_UPDATED"),

            RemarkType =
                ReadInt(reader, "REMTYPE"),

            RemarkSequence =
                ReadInt(reader, "REMSEQ"),

            RemarkStatusFlag =
                ReadString(reader, "REM_STA_FLAG"),

            RemarkDistributionFlag =
                ReadString(reader, "REM_DIS_FLAG"),

            HistoryFlag =
                ReadString(reader, "HIST_FLAG"),

            UserId =
                ReadString(reader, "USERID_R")
        };
    }

    private static string ReadString(
        SqlDataReader reader,
        string columnName)
    {
        var value = reader[columnName];

        if (value is null || value == DBNull.Value)
            return "";

        if (value is DateTime dateTime)
            return dateTime.ToString(
                "yyyyMMdd",
                CultureInfo.InvariantCulture);

        return Convert
                   .ToString(
                       value,
                       CultureInfo.InvariantCulture)
                   ?.Trim()
               ?? "";
    }

    private static int ReadInt(
        SqlDataReader reader,
        string columnName)
    {
        var value = reader[columnName];

        if (value is null || value == DBNull.Value)
            return 0;

        if (value is int intValue)
            return intValue;

        if (value is short shortValue)
            return shortValue;

        if (value is long longValue)
            return checked((int)longValue);

        if (value is decimal decimalValue)
            return Convert.ToInt32(decimalValue);

        return int.TryParse(
            value.ToString()?.Trim(),
            out var parsed)
                ? parsed
                : 0;
    }

    private static string Normalize(string? value)
    {
        return (value ?? "")
            .Trim()
            .ToUpperInvariant();
    }
}
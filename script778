           IF CURSOR-POSITION >= 00148 AND <= 00158                                                                                                                                                     
              MOVE 1 TO DATE-R-CURSOR.                                                                                                                                                                  
           IF CURSOR-POSITION >= 00490 AND <= 00491                                                                                                                                                     
              MOVE 1 TO SEL1-CURSOR.                                                                                                                                                                    
           IF CURSOR-POSITION >= 00650 AND <= 00651                                                                                                                                                     

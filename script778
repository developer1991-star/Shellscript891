@page
@model PCPM.Pages.D158020Model
@{
    Layout = null;
    ViewData["Title"] = "D158020";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158020</title>

    <link rel="stylesheet" href="~/css/pcpm-terminal.css" />

    <style>
        .security-update-screen {
            max-width: 1000px;
            margin: 0 auto;
        }

        .security-user-row {
            display: grid;
            grid-template-columns: 90px 220px 90px 140px;
            align-items: center;
            column-gap: 10px;
            margin-top: 22px;
        }

        .security-section {
            margin-top: 18px;
        }

        .security-section-title {
            margin-bottom: 12px;
            border-bottom: 1px solid #777;
            padding-bottom: 5px;
        }

        .security-access-grid {
            display: grid;
            grid-template-columns:
                150px 75px
                150px 75px;
            column-gap: 25px;
            row-gap: 12px;
            align-items: center;
        }

        .security-access-grid input[type="text"] {
            width: 45px;
            text-align: center;
        }

        .startup-field {
            width: 55px !important;
        }

        .single-field {
            width: 30px !important;
        }

        .readonly-terminal {
            background-color: lightgray !important;
        }

        .security-summary {
            display: grid;
            grid-template-columns: 150px 75px 150px 75px;
            gap: 12px 25px;
            align-items: center;
            margin-top: 14px;
        }

        .function-keys.security-keys {
            justify-content: flex-start;
            gap: 30px;
        }

        .hidden-submit {
            position: absolute;
            left: -10000px;
            top: -10000px;
            width: 1px;
            height: 1px;
        }

        .security-error {
            min-height: 25px;
            margin-top: 15px;
            color: #b00020;
            font-weight: 700;
        }

        .update-instruction {
            margin-top: 18px;
            text-align: center;
        }
    </style>
</head>

<body>
<div class="pcpm-screen security-update-screen">

    <form method="post"
          id="d158020Form"
          autocomplete="off">

        <button type="submit"
                class="hidden-submit"
                tabindex="-1"
                aria-hidden="true">
        </button>

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Name" />
        <input type="hidden" asp-for="DisplayDate" />
        <input type="hidden" asp-for="ScreenR" />

        <!-- HEADER -->
        <div class="header-grid">

            <div class="field-group">
                <label>ACTION</label>

                <input asp-for="Action"
                       maxlength="3"
                       class="terminal-dynamic-input action readonly-terminal"
                       readonly />
            </div>

            <div class="header-center">
                <div>
                    ARDOT PRE-CONSTRUCTION PROJECT MONITORING
                </div>

                <div class="screen-row">
                    SECURITY ACCESS UPDATE
                </div>
            </div>

            <div class="header-right">
                <div>D158020</div>
                <div class="screen-row">@Model.DisplayDate</div>
            </div>

        </div>

        <div class="screen-row">
            SCREEN&nbsp;&nbsp;&nbsp;&nbsp;020
        </div>

        <div class="separator"></div>

        <!-- USER -->
        <div class="security-user-row">

            <div>NAME</div>
            <div>@Model.Name</div>

            <div>USER ID</div>
            <div>@Model.UserId</div>

        </div>

        <div class="separator"></div>

        <!-- GENERAL SECURITY -->
        <div class="security-section">

            <div class="security-section-title">
                SECURITY ACCESS
            </div>

            <div class="security-summary">

                <label asp-for="Mu">MU</label>

                <input asp-for="Mu"
                       maxlength="1"
                       class="terminal-dynamic-input single-field readonly-terminal"
                       readonly />

                <label asp-for="StartUp">START-UP</label>

                <input asp-for="StartUp"
                       maxlength="3"
                       class="terminal-dynamic-input startup-field" />

                <label asp-for="Ma">MA</label>

                <input asp-for="Ma"
                       maxlength="1"
                       class="terminal-dynamic-input single-field readonly-terminal"
                       readonly />

                <label asp-for="Bi">BI</label>

                <input asp-for="Bi"
                       maxlength="1"
                       class="terminal-dynamic-input single-field" />

            </div>

        </div>

        <!-- FUNCTIONAL AREA ACCESS -->
        <div class="security-section">

            <div class="security-section-title">
                FUNCTIONAL AREA ACCESS
            </div>

            <div class="security-access-grid">

                <label asp-for="Pc">PC</label>
                <input asp-for="Pc"
                       maxlength="2"
                       class="terminal-dynamic-input" />

                <label asp-for="Ve">VE</label>
                <input asp-for="Ve"
                       maxlength="2"
                       class="terminal-dynamic-input" />


                <label asp-for="Ps">PS</label>
                <input asp-for="Ps"
                       maxlength="2"
                       class="terminal-dynamic-input" />

                <label asp-for="Ds">DS</label>
                <input asp-for="Ds"
                       maxlength="2"
                       class="terminal-dynamic-input" />


                <label asp-for="Rr">RR</label>
                <input asp-for="Rr"
                       maxlength="2"
                       class="terminal-dynamic-input" />

                <label asp-for="Rd">RD</label>
                <input asp-for="Rd"
                       maxlength="2"
                       class="terminal-dynamic-input" />


                <label asp-for="Br">BR</label>
                <input asp-for="Br"
                       maxlength="2"
                       class="terminal-dynamic-input" />

                <label asp-for="Tr">TR</label>
                <input asp-for="Tr"
                       maxlength="2"
                       class="terminal-dynamic-input" />


                <label asp-for="Rw">RW</label>
                <input asp-for="Rw"
                       maxlength="2"
                       class="terminal-dynamic-input" />

                <label asp-for="Ut">UT</label>
                <input asp-for="Ut"
                       maxlength="2"
                       class="terminal-dynamic-input" />


                <label asp-for="Gt">GT</label>
                <input asp-for="Gt"
                       maxlength="2"
                       class="terminal-dynamic-input" />

                <label asp-for="Pa">PA</label>
                <input asp-for="Pa"
                       maxlength="2"
                       class="terminal-dynamic-input" />


                <label asp-for="En">EN</label>
                <input asp-for="En"
                       maxlength="2"
                       class="terminal-dynamic-input" />

                @if (Model.ShowRm)
                {
                    <label asp-for="Rm">RM</label>

                    <input asp-for="Rm"
                           maxlength="2"
                           class="terminal-dynamic-input" />
                }

            </div>

        </div>

        @if (Model.ShowEnterUpdate)
        {
            <div class="update-instruction">
                ENTER=UPDATE
            </div>
        }

        <div class="function-keys security-keys">

            @if (Model.ShowF1)
            {
                <button type="submit"
                        asp-page-handler="Help"
                        id="btnF1"
                        class="function-button">
                    F1=HELP
                </button>
            }

            @if (Model.ShowF3)
            {
                <button type="submit"
                        asp-page-handler="Previous"
                        id="btnF3"
                        class="function-button">
                    F3=PREV
                </button>
            }

            <button type="submit"
                    asp-page-handler="Reset"
                    id="btnF6"
                    class="function-button">
                F6=RESET
            </button>

            @if (Model.ShowF12)
            {
                <button type="submit"
                        asp-page-handler="MainMenu"
                        id="btnF12"
                        class="function-button">
                    F12=MAIN
                </button>
            }

        </div>

        <div class="security-error">
            @Model.ErrorMessage
        </div>

    </form>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("d158020Form");

        form.querySelectorAll("input[type='text']:not([readonly])")
            .forEach(function (input) {

                input.addEventListener("input", function () {

                    const start = this.selectionStart;
                    const end = this.selectionEnd;

                    this.value = this.value.toUpperCase();

                    if (start !== null && end !== null) {
                        this.setSelectionRange(start, end);
                    }
                });
            });

        document.addEventListener("keydown", function (event) {

            let button = null;

            switch (event.key) {

                case "F1":
                    button = document.getElementById("btnF1");
                    break;

                case "F3":
                    button = document.getElementById("btnF3");
                    break;

                case "F6":
                    button = document.getElementById("btnF6");
                    break;

                case "F12":
                    button = document.getElementById("btnF12");
                    break;
            }

            if (button) {
                event.preventDefault();
                button.click();
            }
        });
    });
</script>

</body>
</html>



using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158020Model : PageModel
{
    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string ScreenR { get; set; } = "010";

    [BindProperty]
    public string DisplayDate { get; set; } = string.Empty;

    [BindProperty(SupportsGet = true)]
    public string UserId { get; set; } = string.Empty;

    [BindProperty]
    public string Name { get; set; } = string.Empty;


    /*
     * ---------------------------------------------------------
     * Security fields from D158020.aspx.cbl
     * ---------------------------------------------------------
     */

    [BindProperty]
    public string Mu { get; set; } = string.Empty;

    [BindProperty]
    public string StartUp { get; set; } = string.Empty;

    [BindProperty]
    public string Ma { get; set; } = string.Empty;

    [BindProperty]
    public string Bi { get; set; } = string.Empty;

    [BindProperty]
    public string Pc { get; set; } = string.Empty;

    [BindProperty]
    public string Ve { get; set; } = string.Empty;

    [BindProperty]
    public string Ps { get; set; } = string.Empty;

    [BindProperty]
    public string Ds { get; set; } = string.Empty;

    [BindProperty]
    public string Rr { get; set; } = string.Empty;

    [BindProperty]
    public string Rd { get; set; } = string.Empty;

    [BindProperty]
    public string Br { get; set; } = string.Empty;

    [BindProperty]
    public string Tr { get; set; } = string.Empty;

    [BindProperty]
    public string Rw { get; set; } = string.Empty;

    [BindProperty]
    public string Ut { get; set; } = string.Empty;

    [BindProperty]
    public string Gt { get; set; } = string.Empty;

    [BindProperty]
    public string Pa { get; set; } = string.Empty;

    [BindProperty]
    public string En { get; set; } = string.Empty;

    [BindProperty]
    public string Rm { get; set; } = string.Empty;


    /*
     * Legacy attributes allow the business program to hide these.
     *
     * RM starts PSI, therefore hidden.
     * ENTER=UPDATE also starts PSI, therefore hidden.
     */
    public bool ShowRm { get; set; }

    public bool ShowEnterUpdate { get; set; }

    public bool ShowF1 { get; set; } = true;

    public bool ShowF3 { get; set; } = true;

    public bool ShowF12 { get; set; } = true;


    public string ErrorMessage { get; set; } = string.Empty;


    public async Task OnGetAsync()
    {
        DisplayDate = DateTime.Now.ToString("MM/dd/yyyy");

        ScreenR = "010";

        UserId = Normalize(UserId);

        await LoadSecurityAsync();
    }


    /// <summary>
    /// ENTER = UPDATE.
    ///
    /// The wrapper establishes the editable fields, but the actual
    /// security update business logic/database logic is in the main
    /// PCPM COBOL program and was not included.
    /// </summary>
    public async Task<IActionResult> OnPostAsync()
    {
        NormalizeInput();

        if (string.IsNullOrWhiteSpace(UserId))
        {
            ErrorMessage = "USER ID NOT SPECIFIED";
            RestorePresentationState();
            return Page();
        }

        /*
         * ==========================================================
         * SECURITY UPDATE BUSINESS LOGIC GOES HERE
         * ==========================================================
         *
         * Example future architecture:
         *
         * var request = new UpdateSecurityAccessRequest
         * {
         *     UserId = UserId,
         *     StartUp = StartUp,
         *     Bi = Bi,
         *     Pc = Pc,
         *     Ve = Ve,
         *     Ps = Ps,
         *     Ds = Ds,
         *     Rr = Rr,
         *     Rd = Rd,
         *     Br = Br,
         *     Tr = Tr,
         *     Rw = Rw,
         *     Ut = Ut,
         *     Gt = Gt,
         *     Pa = Pa,
         *     En = En
         * };
         *
         * await _securityService.UpdateSecurityAccessAsync(request);
         *
         * Do not invent SQL/table mappings until the business COBOL
         * or database mapping is available.
         */

        await Task.CompletedTask;

        ErrorMessage = "SECURITY UPDATE LOGIC IS NOT YET WIRED";

        RestorePresentationState();

        return Page();
    }


    public IActionResult OnPostHelp()
    {
        return RedirectToPage(
            "/D158999",
            new
            {
                screen = "020"
            });
    }


    public IActionResult OnPostPrevious()
    {
        /*
         * D158010 is the security browse panel that leads into this page.
         */
        return RedirectToPage("/D158010");
    }


    public IActionResult OnPostReset()
    {
        return RedirectToPage(
            "/D158020",
            new
            {
                userId = UserId
            });
    }


    public IActionResult OnPostMainMenu()
    {
        return RedirectToPage("/D158000");
    }


    private async Task LoadSecurityAsync()
    {
        /*
         * ==========================================================
         * REPOSITORY / DATABASE LOAD GOES HERE
         * ==========================================================
         *
         * The WebCOBOL wrapper does not contain the actual database
         * retrieval for the selected user's security record.
         *
         * Future example:
         *
         * var security =
         *     await _securityRepository.GetSecurityAccessAsync(UserId);
         *
         * if (security == null)
         * {
         *     ErrorMessage = "SECURITY RECORD NOT FOUND";
         *     return;
         * }
         *
         * Name = security.Name;
         * Mu = security.Mu;
         * StartUp = security.StartUp;
         * Ma = security.Ma;
         * Bi = security.Bi;
         * Pc = security.Pc;
         * ...
         */

        await Task.CompletedTask;

        RestorePresentationState();
    }


    private void NormalizeInput()
    {
        Action = Normalize(Action);
        ScreenR = Normalize(ScreenR);
        Name = Normalize(Name);
        UserId = Normalize(UserId);

        Mu = Normalize(Mu);
        StartUp = Normalize(StartUp);
        Ma = Normalize(Ma);
        Bi = Normalize(Bi);
        Pc = Normalize(Pc);
        Ve = Normalize(Ve);
        Ps = Normalize(Ps);
        Ds = Normalize(Ds);
        Rr = Normalize(Rr);
        Rd = Normalize(Rd);
        Br = Normalize(Br);
        Tr = Normalize(Tr);
        Rw = Normalize(Rw);
        Ut = Normalize(Ut);
        Gt = Normalize(Gt);
        Pa = Normalize(Pa);
        En = Normalize(En);
        Rm = Normalize(Rm);

        TrimToLengths();
    }


    private void TrimToLengths()
    {
        Action = Limit(Action, 3);
        ScreenR = Limit(ScreenR, 3);
        Name = Limit(Name, 25);
        UserId = Limit(UserId, 7);

        Mu = Limit(Mu, 1);
        StartUp = Limit(StartUp, 3);
        Ma = Limit(Ma, 1);
        Bi = Limit(Bi, 1);

        Pc = Limit(Pc, 2);
        Ve = Limit(Ve, 2);
        Ps = Limit(Ps, 2);
        Ds = Limit(Ds, 2);
        Rr = Limit(Rr, 2);
        Rd = Limit(Rd, 2);
        Br = Limit(Br, 2);
        Tr = Limit(Tr, 2);
        Rw = Limit(Rw, 2);
        Ut = Limit(Ut, 2);
        Gt = Limit(Gt, 2);
        Pa = Limit(Pa, 2);
        En = Limit(En, 2);
        Rm = Limit(Rm, 2);
    }


    private void RestorePresentationState()
    {
        if (string.IsNullOrWhiteSpace(DisplayDate))
        {
            DisplayDate = DateTime.Now.ToString("MM/dd/yyyy");
        }

        /*
         * Initial COBOL attributes:
         *
         * RM        = PSI
         * ENTER-PAN = PSI
         *
         * Therefore they begin invisible.
         */
        ShowRm = false;
        ShowEnterUpdate = false;

        ShowF1 = true;
        ShowF3 = true;
        ShowF12 = true;
    }


    private static string Normalize(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();
    }


    private static string Limit(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        return value.Length <= maxLength
            ? value
            : value[..maxLength];
    }
}
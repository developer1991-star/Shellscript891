            width: 800px;
            height: 610px;
            margin: 0 auto;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
        }

        .legacy-label {
            position: absolute;
            white-space: pre;
        }

        .legacy-input {
            position: absolute;
            box-sizing: border-box;
            height: 24px;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            padding: 1px 3px;
            color: #111;
            background: #fff;
            text-transform: uppercase;

            border-top: 2px solid #808080;
            border-left: 2px solid #808080;
            border-bottom: 2px solid #fff;
            border-right: 2px solid #fff;

            border-radius: 0;
            box-shadow: inset 1px 1px 0 #000;
        }

        .legacy-input:focus {
            background: #ffff00;
            border: 2px solid #111;
            box-shadow: none;
            outline: none;
        }

        .legacy-input.protected {
            background: lightgray;
        }

        .legacy-input.protected:focus {
            background: lightgray;
        }

        .legacy-key {
            position: absolute;
            border: none;
            background: transparent;
            padding: 0;
            margin: 0;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            color: #111;
            white-space: pre;
        }

        .legacy-key:hover {
            text-decoration: underline;
        }

        .legacy-error {
            position: absolute;
            left: 10px;
            top: 575px;
            color: red;
            white-space: pre;
        }
    </style>
</head>


    // =========================================================
    // INITIAL REMARKS
    //
    // Legacy RMK-SCROLL-FWD starts at HIGH VALUES and gets
    // newest 5 remarks.
    // =========================================================

    public async Task<IReadOnlyList<D158302RemarkRecord>>
        GetInitialRemarksAsync(
            string jobNumber,
            string functionalArea,
            string historyFlag,
            CancellationToken cancellationToken = default)
    {
        const string sql = """
            SELECT TOP (5)
                   JOBNO,
                   FUNC_AREA,
                   REMARK_R,
                   LAST_UPDATED,
                   REMTYPE,
                   REMSEQ,
                   REM_STA_FLAG,
                   REM_DIS_FLAG,
                   HIST_FLAG,
                   USERID_R
            FROM [PRECONSTRUCTION].[dbo].[T158_REMARKS]
            WHERE ISNULL(LTRIM(RTRIM(DELFLAG)), '') = ''
              AND LTRIM(RTRIM(HIST_FLAG)) =
                  LTRIM(RTRIM(@HistoryFlag))
              AND LTRIM(RTRIM(JOBNO)) =
                  LTRIM(RTRIM(@JobNumber))
              AND LTRIM(RTRIM(FUNC_AREA)) =
                  LTRIM(RTRIM(@FunctionalArea))
            ORDER BY
                   LAST_UPDATED DESC,
                   REMTYPE DESC,
                   REMSEQ DESC;
            """;

        return await ReadRemarksAsync(
            sql,
            command =>
            {
                command.Parameters.AddWithValue(
                    "@JobNumber",
                    Normalize(jobNumber));

                command.Parameters.AddWithValue(
                    "@FunctionalArea",
                    Normalize(functionalArea));

                command.Parameters.AddWithValue(
                    "@HistoryFlag",
                    Normalize(historyFlag));
            },
            reverseResults: false,
            cancellationToken);
    }

    // =========================================================
    // REMARK SCROLL FORWARD
    //
    // Screen order is newest -> oldest.
    //
    // Legacy tuple:
    // LAST_UPDATED, REMTYPE, REMSEQ < bottom key
    // =========================================================

    public async Task<IReadOnlyList<D158302RemarkRecord>>
        GetRemarksForwardAsync(
            string jobNumber,
            string functionalArea,
            string historyFlag,
            string lastUpdated,
            int remarkType,
            int remarkSequence,
            CancellationToken cancellationToken = default)
    {
        const string sql = """
            SELECT TOP (5)
                   JOBNO,
                   FUNC_AREA,
                   REMARK_R,
                   LAST_UPDATED,
                   REMTYPE,
                   REMSEQ,
                   REM_STA_FLAG,
                   REM_DIS_FLAG,
                   HIST_FLAG,
                   USERID_R
            FROM [PRECONSTRUCTION].[dbo].[T158_REMARKS]
            WHERE ISNULL(LTRIM(RTRIM(DELFLAG)), '') = ''
              AND LTRIM(RTRIM(HIST_FLAG)) =
                  LTRIM(RTRIM(@HistoryFlag))
              AND LTRIM(RTRIM(JOBNO)) =
                  LTRIM(RTRIM(@JobNumber))
              AND LTRIM(RTRIM(FUNC_AREA)) =
                  LTRIM(RTRIM(@FunctionalArea))
              AND
              (
                     LAST_UPDATED < @LastUpdated

                  OR (
                         LAST_UPDATED = @LastUpdated
                     AND REMTYPE < @RemarkType
                     )

                  OR (
                         LAST_UPDATED = @LastUpdated
                     AND REMTYPE = @RemarkType
                     AND REMSEQ < @RemarkSequence
                     )
              )
            ORDER BY
                   LAST_UPDATED DESC,
                   REMTYPE DESC,
                   REMSEQ DESC;
            """;

        return await ReadRemarksAsync(
            sql,
            command =>
            {
                AddRemarkParameters(
                    command,
                    jobNumber,
                    functionalArea,
                    historyFlag,
                    lastUpdated,
                    remarkType,
                    remarkSequence);
            },
            reverseResults: false,
            cancellationToken);
    }

    // =========================================================
    // REMARK SCROLL BACKWARD
    //
    // Database query is ascending just like legacy COBOL.
    // We reverse the five records afterward so the UI continues
    // displaying newest -> oldest.
    // =========================================================


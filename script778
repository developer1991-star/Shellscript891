using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158700Model : PageModel
{
    private const string ScreenName = "D158700";

    // These two keys are only used by this page for Previous navigation.
    // If D158000 already has constants/helpers for these values,
    // use those same constants instead.
    private const string CurrentScreenSessionKey = "PCPM.CurrentScreen";
    private const string PreviousScreenSessionKey = "PCPM.PreviousScreen";

    [BindProperty]
    public string? Action { get; set; }

    [BindProperty]
    public string? Sel1 { get; set; }

    [BindProperty]
    public string? Sel2 { get; set; }

    [BindProperty]
    public string? Sel3 { get; set; }

    [BindProperty]
    public string? Sel4 { get; set; }

    [BindProperty]
    public string? Sel5 { get; set; }

    public string DateText { get; private set; } = string.Empty;

    public string? Message { get; set; }

    public void OnGet()
    {
        SetDate();
        RegisterScreen();
    }

    public IActionResult OnPost()
    {
        SetDate();

        NormalizeFields();

        //
        // Legacy ACTION field.
        //
        // The WebForms wrapper only proves that ACTION is a
        // three-character uppercase field. The business COBOL that
        // validates ACTION was not supplied with D158700.
        //
        // Numeric panel navigation is retained as the normal PCPM
        // direct-navigation convention.
        //
        if (!string.IsNullOrWhiteSpace(Action))
        {
            var actionResult = ProcessAction();

            if (actionResult != null)
            {
                return actionResult;
            }
        }

        var selections = new[]
        {
            Sel1,
            Sel2,
            Sel3,
            Sel4,
            Sel5
        };

        var selectedIndexes = selections
            .Select((value, index) => new
            {
                Value = value,
                Index = index
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Value))
            .ToList();

        if (selectedIndexes.Count == 0)
        {
            Message = "SELECTION NOT SPECIFIED";
            return Page();
        }

        if (selectedIndexes.Count > 1)
        {
            Message = "ONLY ONE SELECTION MAY BE SPECIFIED";
            return Page();
        }

        var selected = selectedIndexes[0];

        if (!string.Equals(
                selected.Value,
                "S",
                StringComparison.OrdinalIgnoreCase))
        {
            Message = "ENTER 'S' IN THE SELECTION FIELD";
            return Page();
        }

        return selected.Index switch
        {
            0 => GoToScreen("D158710"),
            1 => GoToScreen("D158711"),
            2 => GoToScreen("D158712"),
            3 => GoToScreen("D158713"),
            4 => GoToScreen("D158715"),

            _ => Page()
        };
    }

    public IActionResult OnPostHelp()
    {
        SetDate();
        SaveCurrentAsPrevious();

        //
        // D158999 is the generic PCPM help panel.
        // hScreen identifies the requesting panel.
        //
        return RedirectToPage(
            "/D158999",
            new
            {
                hScreen = "700"
            });
    }

    public IActionResult OnPostPrevious()
    {
        var previous =
            HttpContext.Session.GetString(PreviousScreenSessionKey);

        if (!string.IsNullOrWhiteSpace(previous) &&
            previous.StartsWith("D158",
                StringComparison.OrdinalIgnoreCase))
        {
            return RedirectToPage("/" + previous);
        }

        return RedirectToPage("/D158000");
    }

    public IActionResult OnPostReset()
    {
        Action = string.Empty;

        Sel1 = string.Empty;
        Sel2 = string.Empty;
        Sel3 = string.Empty;
        Sel4 = string.Empty;
        Sel5 = string.Empty;

        Message = null;

        SetDate();

        return Page();
    }

    public IActionResult OnPostMain()
    {
        return GoToScreen("D158000");
    }

    private IActionResult? ProcessAction()
    {
        Action = Normalize(Action);

        if (string.IsNullOrWhiteSpace(Action))
        {
            return null;
        }

        //
        // The wrapper recognizes SO, but its actual sign-off business
        // behavior lives outside D158700.aspx.cbl.
        //
        if (Action == "SO")
        {
            Message = "SIGN OFF IS NOT IMPLEMENTED ON THIS MIGRATED PANEL.";
            return Page();
        }

        //
        // Direct panel navigation.
        // Example:
        //     710 -> D158710
        //     500 -> D158500
        //
        if (Action.Length == 3 &&
            int.TryParse(Action, out _))
        {
            return GoToScreen($"D158{Action}");
        }

        Message = "INVALID ACTION";
        return Page();
    }

    private IActionResult GoToScreen(string screen)
    {
        SaveCurrentAsPrevious();

        HttpContext.Session.SetString(
            CurrentScreenSessionKey,
            screen);

        return RedirectToPage("/" + screen);
    }

    private void RegisterScreen()
    {
        var current =
            HttpContext.Session.GetString(CurrentScreenSessionKey);

        if (!string.Equals(
                current,
                ScreenName,
                StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrWhiteSpace(current))
            {
                HttpContext.Session.SetString(
                    PreviousScreenSessionKey,
                    current);
            }

            HttpContext.Session.SetString(
                CurrentScreenSessionKey,
                ScreenName);
        }
    }

    private void SaveCurrentAsPrevious()
    {
        HttpContext.Session.SetString(
            PreviousScreenSessionKey,
            ScreenName);
    }

    private void NormalizeFields()
    {
        Action = Normalize(Action);

        Sel1 = Normalize(Sel1);
        Sel2 = Normalize(Sel2);
        Sel3 = Normalize(Sel3);
        Sel4 = Normalize(Sel4);
        Sel5 = Normalize(Sel5);
    }

    private static string Normalize(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();
    }

    private void SetDate()
    {
        DateText = DateTime.Now.ToString("MM/dd/yyyy");
    }
}

@page
@model PCPM.Pages.D158700Model

@{
    Layout = null;
    ViewData["Title"] = "D158700";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158700</title>

    <link rel="stylesheet" href="~/css/pcpm-terminal.css" />

    <style>
        .browse-menu {
            width: 780px;
        }

        .screen-heading {
            display: grid;
            grid-template-columns: 150px 1fr 140px;
            align-items: center;
        }

        .screen-heading-center {
            text-align: center;
        }

        .screen-heading-right {
            text-align: right;
        }

        .browse-table {
            width: 650px;
            margin: 35px auto 0 auto;
            border-collapse: collapse;
        }

        .browse-table th {
            text-align: left;
            padding-bottom: 22px;
        }

        .browse-table td {
            padding: 14px 5px;
            vertical-align: middle;
        }

        .browse-select {
            width: 28px;
            text-align: center;
            text-transform: uppercase;
        }

        .browse-sel-column {
            width: 55px;
        }

        .browse-opt-column {
            width: 50px;
        }

        .browse-panel-column {
            width: 100px;
            text-align: center;
        }

        .instruction {
            margin-top: 35px;
            text-align: center;
        }

        .enter-submit {
            position: absolute;
            left: -10000px;
            top: -10000px;
        }

        .function-keys {
            margin-top: 55px;
        }
    </style>
</head>

<body>
<div class="pcpm-screen browse-menu">

    <form method="post" id="d158700Form">

        <button type="submit"
                class="enter-submit"
                aria-hidden="true"
                tabindex="-1">
            ENTER
        </button>

        <div class="screen-heading">
            <div>
                ACTION
                <input asp-for="Action"
                       id="Action"
                       maxlength="3"
                       class="terminal-dynamic-input action"
                       autocomplete="off"
                       autofocus />
            </div>

            <div class="screen-heading-center">
                ARDOT PRE-CONSTRUCTION PROJECT MONITORING
            </div>

            <div class="screen-heading-right">
                D158700
            </div>
        </div>

        <div class="screen-heading screen-row">
            <div>
                SCREEN&nbsp;&nbsp;700
            </div>

            <div class="screen-heading-center">
                JOB BROWSE SELECTION MENU
            </div>

            <div class="screen-heading-right">
                @Model.DateText
            </div>
        </div>

        <div class="separator"></div>

        <table class="browse-table">
            <thead>
            <tr>
                <th class="browse-sel-column">SEL</th>
                <th class="browse-opt-column">OPT</th>
                <th>BROWSE OPTION</th>
                <th class="browse-panel-column">PANEL NO.</th>
            </tr>
            </thead>

            <tbody>
            <tr>
                <td>
                    <input asp-for="Sel1"
                           maxlength="1"
                           class="terminal-dynamic-input browse-select"
                           autocomplete="off" />
                </td>
                <td>1.</td>
                <td>JOB NUMBER, JOB SEQUENCE</td>
                <td class="browse-panel-column">710</td>
            </tr>

            <tr>
                <td>
                    <input asp-for="Sel2"
                           maxlength="1"
                           class="terminal-dynamic-input browse-select"
                           autocomplete="off" />
                </td>
                <td>2.</td>
                <td>DISTRICT, COUNTY, ROUTE, SECTION</td>
                <td class="browse-panel-column">711</td>
            </tr>

            <tr>
                <td>
                    <input asp-for="Sel3"
                           maxlength="1"
                           class="terminal-dynamic-input browse-select"
                           autocomplete="off" />
                </td>
                <td>3.</td>
                <td>ROUTE AND SECTION</td>
                <td class="browse-panel-column">712</td>
            </tr>

            <tr>
                <td>
                    <input asp-for="Sel4"
                           maxlength="1"
                           class="terminal-dynamic-input browse-select"
                           autocomplete="off" />
                </td>
                <td>4.</td>
                <td>LET DATE (FISCAL OR CALENDAR YEAR)</td>
                <td class="browse-panel-column">713</td>
            </tr>

            <tr>
                <td>
                    <input asp-for="Sel5"
                           maxlength="1"
                           class="terminal-dynamic-input browse-select"
                           autocomplete="off" />
                </td>
                <td>5.</td>
                <td>COMBINED JOB NUMBER (ALL JOBS)</td>
                <td class="browse-panel-column">715</td>
            </tr>
            </tbody>
        </table>

        <div class="instruction">
            ENTER 'S' IN THE SELECTION FIELD, PRESS ENTER
        </div>

        <div class="function-keys">
            <button type="submit"
                    asp-page-handler="Help"
                    id="pf1"
                    class="function-button">
                F1=HELP
            </button>

            <button type="submit"
                    asp-page-handler="Previous"
                    id="pf3"
                    class="function-button">
                F3=PREVIOUS
            </button>

            <button type="submit"
                    asp-page-handler="Reset"
                    id="pf6"
                    class="function-button">
                F6=RESET
            </button>

            <button type="submit"
                    asp-page-handler="Main"
                    id="pf12"
                    class="function-button">
                F12=MAIN MENU
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="message">
                @Model.Message
            </div>
        }

    </form>
</div>

<script>
    (() => {
        const upperCaseInputs = document.querySelectorAll(
            '#Action, #Sel1, #Sel2, #Sel3, #Sel4, #Sel5'
        );

        upperCaseInputs.forEach(input => {
            input.addEventListener('input', function () {
                const start = this.selectionStart;
                const end = this.selectionEnd;

                this.value = this.value.toUpperCase();

                if (start !== null && end !== null) {
                    this.setSelectionRange(start, end);
                }
            });
        });

        document.addEventListener('keydown', function (event) {
            let buttonId = null;

            switch (event.key) {
                case 'F1':
                    buttonId = 'pf1';
                    break;

                case 'F3':
                    buttonId = 'pf3';
                    break;

                case 'F6':
                    buttonId = 'pf6';
                    break;

                case 'F12':
                    buttonId = 'pf12';
                    break;
            }

            if (buttonId) {
                event.preventDefault();
                document.getElementById(buttonId)?.click();
            }
        });
    })();
</script>

</body>
</html>




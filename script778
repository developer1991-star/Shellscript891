    private void ValidateLegacyNumericFields()
    {
        /*
         * JOBSEQ:
         * numeric, no decimal
         */
        ValidateNumeric(
            nameof(JobSequence),
            JobSequence,
            allowDecimal: false,
            maxWholeDigits: null,
            maxDecimalDigits: 0);

        /*
         * LOG and LEN:
         * up to 9 digits before decimal,
         * up to 2 decimal digits.
         */
        ValidateNumeric(
            nameof(LogMile),
            LogMile,
            allowDecimal: true,
            maxWholeDigits: 9,
            maxDecimalDigits: 2);

        ValidateNumeric(
            nameof(Length),
            Length,
            allowDecimal: true,
            maxWholeDigits: 9,
            maxDecimalDigits: 2);

        /*
         * Federal funding amounts.
         */
        ValidateWholeAmount(
            nameof(FFndAmt1),
            FFndAmt1,
            9);

        ValidateWholeAmount(
            nameof(FFndAmt2),
            FFndAmt2,
            9);

        ValidateWholeAmount(
            nameof(FFndAmt3),
            FFndAmt3,
            9);

        ValidateWholeAmount(
            nameof(FFndTotal),
            FFndTotal,
            null);

        /*
         * State funding amounts.
         */
        ValidateWholeAmount(
            nameof(SFndAmt1),
            SFndAmt1,
            9);

        ValidateWholeAmount(
            nameof(SFndAmt2),
            SFndAmt2,
            9);

        ValidateWholeAmount(
            nameof(SFndAmt3),
            SFndAmt3,
            9);

        ValidateWholeAmount(
            nameof(SFndTotal),
            SFndTotal,
            null);

        /*
         * Other funding amounts.
         */
        ValidateWholeAmount(
            nameof(OFndAmt1),
            OFndAmt1,
            9);

        ValidateWholeAmount(
            nameof(OFndAmt2),
            OFndAmt2,
            9);

        ValidateWholeAmount(
            nameof(OFndAmt3),
            OFndAmt3,
            9);

        ValidateWholeAmount(
            nameof(OFndTotal),
            OFndTotal,
            null);

        /*
         * Funding status is numeric in the supplied COBOL
         * Validation_Rules.
         */
        ValidateWholeAmount(
            nameof(FundingStatus),
            FundingStatus,
            null);

        ValidateWholeAmount(
            nameof(ProgramAmount),
            ProgramAmount,
            null);

        ValidateWholeAmount(
            nameof(HipWork),
            HipWork,
            null);

        /*
         * BIDAMT allows up to 13 whole-number digits
         * and no decimal places.
         */
        ValidateWholeAmount(
            nameof(BidAmount),
            BidAmount,
            13);

        ValidateWholeAmount(
            nameof(FinalConstructionAmount),
            FinalConstructionAmount,
            null);
    }

    private void ValidateWholeAmount(
        string key,
        string? value,
        int? maxDigits)
    {
        ValidateNumeric(
            key,
            value,
            allowDecimal: false,
            maxWholeDigits: maxDigits,
            maxDecimalDigits: 0);
    }

    private void ValidateNumeric(
        string key,
        string? value,
        bool allowDecimal,
        int? maxWholeDigits,
        int maxDecimalDigits)
    {
        var text = NormalizeNumeric(value);

        /*
         * Legacy Check_Numeric_Logic accepts all spaces.
         */
        if (string.IsNullOrWhiteSpace(text))
            return;

        /*
         * Embedded spaces are invalid.
         */
        if (text.Any(char.IsWhiteSpace))
        {
            AddNumericError(key);
            return;
        }

        /*
         * Supplied D158940 code explicitly sets ALLOW-SIGN = N.
         */
        if (text.Contains('+') || text.Contains('-'))
        {
            AddNumericError(key);
            return;
        }

        var decimalCount =
            text.Count(c => c == '.');

        if (!allowDecimal && decimalCount > 0)
        {
            AddNumericError(key);
            return;
        }

        if (decimalCount > 1)
        {
            AddNumericError(key);
            return;
        }

        if (text.Any(c =>
                !char.IsDigit(c) &&
                c != '.'))
        {
            AddNumericError(key);
            return;
        }

        var pieces = text.Split('.');

        var wholePart =
            pieces.Length > 0
                ? pieces[0]
                : string.Empty;

        var decimalPart =
            pieces.Length > 1
                ? pieces[1]
                : string.Empty;

        if (maxWholeDigits.HasValue &&
            wholePart.Length > maxWholeDigits.Value)
        {
            ModelState.AddModelError(
                key,
                $"MAXIMUM {maxWholeDigits.Value} DIGITS.");

            return;
        }

        if (decimalPart.Length > maxDecimalDigits)
        {
            ModelState.AddModelError(
                key,
                $"MAXIMUM {maxDecimalDigits} DECIMAL DIGITS.");

            return;
        }

        if (!decimal.TryParse(
                text,
                NumberStyles.AllowDecimalPoint,
                CultureInfo.InvariantCulture,
                out _))
        {
            AddNumericError(key);
        }
    }

    private static string NormalizeNumeric(string? value)
    {
        /*
         * This matches the COBOL's removal of '$' and ','.
         */
        return (value ?? string.Empty)
            .Trim()
            .Replace("$", string.Empty)
            .Replace(",", string.Empty);
    }

    private void AddNumericError(string key)
    {
        ModelState.AddModelError(
            key,
            "INVALID NUMERIC VALUE.");
    }


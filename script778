    }

    // =========================================================
    // LATEST REMARK
    //
    // IMPORTANT:
    // Legacy LOAD-LAST-RMK uses JOBNO only, NOT current FA.
    // HIST_FLAG = N
    // =========================================================

    public async Task<D158302RemarkRecord?> GetLatestRemarkAsync(
        string jobNumber,
        CancellationToken cancellationToken = default)
    {
        const string sql = """
            SELECT TOP (1)
                   JOBNO,
                   FUNC_AREA,
                   REMARK_R,
                   LAST_UPDATED,
                   REMTYPE,
                   REMSEQ,
                   REM_STA_FLAG,
                   REM_DIS_FLAG,
                   HIST_FLAG,
                   USERID_R
            FROM [PRECONSTRUCTION].[dbo].[T158_REMARKS]
            WHERE ISNULL(LTRIM(RTRIM(DELFLAG)), '') = ''
              AND LTRIM(RTRIM(HIST_FLAG)) = 'N'
              AND LTRIM(RTRIM(JOBNO)) =
                  LTRIM(RTRIM(@JobNumber))
            ORDER BY
                   LAST_UPDATED DESC,
                   REMSEQ DESC,
                   REMTYPE DESC;

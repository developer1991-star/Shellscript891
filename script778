for s in $(gcloud run services list \
  --project=gcp-emp-ep-uat \
  --region=us-central1 \
  --format="value(metadata.name)"); do
  echo "Checking $s"
  gcloud run services describe "$s" \
    --project=gcp-emp-ep-uat \
    --region=us-central1 \
    --format=yaml | grep -i "gcp-emp-ep-uat-nodes"
done
           IF CURSOR-POSITION >= 00810 AND <= 00811                                                                                                                                                     
              MOVE 1 TO SEL3-CURSOR.                                                                                                                                                                    
           IF CURSOR-POSITION >= 00970 AND <= 00971                                                                                                                                                     

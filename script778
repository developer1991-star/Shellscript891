namespace PCPM.Application.D158500;

public sealed class D158500Service : ID158500Service
{
    private readonly ID158500Repository _repository;

    public D158500Service(ID158500Repository repository)
    {
        _repository = repository;
    }

    public async Task<D158500Screen> LoadAsync(
        string? jobNumber,
        CancellationToken cancellationToken = default)
    {
        jobNumber = Normalize(jobNumber);

        // Equivalent to the legacy reset/initial screen:
        // load the functional-area rows even when there is no job yet.
        if (string.IsNullOrWhiteSpace(jobNumber))
        {
            return await BuildResetScreenAsync(cancellationToken);
        }

        var job = await _repository.FindJobAsync(
            jobNumber,
            cancellationToken);

        if (job is null)
        {
            var empty = await BuildResetScreenAsync(cancellationToken);

            empty.JobNumber = jobNumber;
            empty.ErrorMessage = await GetMessageAsync(
                "E00003",
                "NO RECORDS FOUND AT ALL",
                cancellationToken);

            return empty;
        }

        var screen = await BuildJobScreenAsync(
            job,
            cancellationToken);

        // Legacy LOAD-JOBREC retrieves the first job >= the requested job.
        // If it had to move to another job, display the warning.
        if (!string.Equals(
                job.JobNumber.Trim(),
                jobNumber,
                StringComparison.OrdinalIgnoreCase))
        {
            screen.ErrorMessage = await GetMessageAsync(
                "W00003",
                "NEXT JOB RECORD RETURNED",
                cancellationToken);
        }

        return screen;
    }

    public async Task<D158500Screen> ResetAsync(
        CancellationToken cancellationToken = default)
    {
        return await BuildResetScreenAsync(cancellationToken);
    }

    public async Task<D158500Screen> ScrollForwardAsync(
        string jobNumber,
        CancellationToken cancellationToken = default)
    {
        jobNumber = Normalize(jobNumber);

        if (string.IsNullOrWhiteSpace(jobNumber))
            return await ResetAsync(cancellationToken);

        var job = await _repository.FindNextJobAsync(
            jobNumber,
            cancellationToken);

        if (job is null)
        {
            var current = await LoadAsync(
                jobNumber,
                cancellationToken);

            current.ErrorMessage = await GetMessageAsync(
                "U00007",
                "END OF FILE",
                cancellationToken);

            return current;
        }

        return await BuildJobScreenAsync(
            job,
            cancellationToken);
    }

    public async Task<D158500Screen> ScrollBackwardAsync(
        string jobNumber,
        CancellationToken cancellationToken = default)
    {
        jobNumber = Normalize(jobNumber);

        if (string.IsNullOrWhiteSpace(jobNumber))
            return await ResetAsync(cancellationToken);

        var job = await _repository.FindPreviousJobAsync(
            jobNumber,
            cancellationToken);

        if (job is null)
        {
            var current = await LoadAsync(
                jobNumber,
                cancellationToken);

            current.ErrorMessage = await GetMessageAsync(
                "U00006",
                "BEGINNING OF FILE",
                cancellationToken);

            return current;
        }

        return await BuildJobScreenAsync(
            job,
            cancellationToken);
    }

    public async Task<D158500Result> ProcessEnterAsync(
        D158500Input input,
        CancellationToken cancellationToken = default)
    {
        input ??= new D158500Input();

        input.Action = Normalize(input.Action).ToUpperInvariant();
        input.JobNumber = Normalize(input.JobNumber);
        input.SummaryFunction =
            Normalize(input.SummaryFunction).ToUpperInvariant();
        input.RemarkSelection =
            Normalize(input.RemarkSelection).ToUpperInvariant();

        input.Rows ??= new List<D158500RowInput>();

        foreach (var row in input.Rows)
        {
            row.FunctionalArea =
                Normalize(row.FunctionalArea).ToUpperInvariant();

            row.Selection =
                Normalize(row.Selection).ToUpperInvariant();
        }

        //
        // Legacy CHECK-CONFLICT:
        // only one navigation request may be entered at a time.
        //
        var selectionCount = 0;

        if (!string.IsNullOrWhiteSpace(input.Action))
            selectionCount++;

        if (!string.IsNullOrWhiteSpace(input.SummaryFunction))
            selectionCount++;

        if (!string.IsNullOrWhiteSpace(input.RemarkSelection))
            selectionCount++;

        selectionCount += input.Rows.Count(
            x => !string.IsNullOrWhiteSpace(x.Selection));

        if (selectionCount > 1)
        {
            return new D158500Result
            {
                Screen = await CreateErrorScreenAsync(
                    input.JobNumber,
                    "E00016",
                    "NAVIGATION CONFLICT",
                    cancellationToken)
            };
        }

        //
        // ACTION
        //
        if (!string.IsNullOrWhiteSpace(input.Action))
        {
            if (!IsValidAction(input.Action))
            {
                return new D158500Result
                {
                    Screen = await CreateErrorScreenAsync(
                        input.JobNumber,
                        "E00002",
                        "INVALID ACTION CODE",
                        cancellationToken)
                };
            }

            // Numeric ACTION values correspond to panel/screen numbers.
            if (input.Action.All(char.IsDigit))
            {
                return new D158500Result
                {
                    DestinationPage = input.Action
                };
            }

            /*
             * "SO" is explicitly valid in the legacy program.
             *
             * The supplied portion of P158500 shows that it is passed
             * back through W-NEXT, but it does not establish a Razor
             * destination named D158SO.
             *
             * Preserve it as valid without inventing a bogus route.
             */
            if (input.Action == "SO")
            {
                var screen = await LoadAsync(
                    input.JobNumber,
                    cancellationToken);

                screen.ErrorMessage =
                    "SO ACTION REQUIRES LEGACY CALLER ROUTING";

                return new D158500Result
                {
                    Screen = screen
                };
            }
        }

        //
        // SF - Summary Function
        //
        if (!string.IsNullOrWhiteSpace(input.SummaryFunction))
        {
            if (input.SummaryFunction == "S")
            {
                return new D158500Result
                {
                    DestinationPage = "510"
                };
            }

            return new D158500Result
            {
                Screen = await CreateErrorScreenAsync(
                    input.JobNumber,
                    "E00012",
                    "INVALID SELECTION CODE",
                    cancellationToken)
            };
        }

        //
        // SELREM
        //
        if (!string.IsNullOrWhiteSpace(input.RemarkSelection))
        {
            if (input.RemarkSelection == "S")
            {
                return new D158500Result
                {
                    DestinationPage = "550"
                };
            }

            return new D158500Result
            {
                Screen = await CreateErrorScreenAsync(
                    input.JobNumber,
                    "E00012",
                    "INVALID SELECTION CODE",
                    cancellationToken)
            };
        }

        //
        // Functional-area row selection.
        //
        var selectedRow = input.Rows.FirstOrDefault(
            x => !string.IsNullOrWhiteSpace(x.Selection));

        if (selectedRow is not null)
        {
            var route = RouteFunctionalArea(selectedRow);

            if (route.Navigate)
                return route;

            return new D158500Result
            {
                Screen = await CreateErrorScreenAsync(
                    input.JobNumber,
                    "E00012",
                    "INVALID SELECTION CODE",
                    cancellationToken)
            };
        }

        //
        // At this point the page model should already have handled
        // entry of a NEW job number. Therefore no navigation selection
        // means the legacy "SELECTION NOT SPECIFIED" condition.
        //
        return new D158500Result
        {
            Screen = await CreateErrorScreenAsync(
                input.JobNumber,
                "E00004",
                "SELECTION NOT SPECIFIED",
                cancellationToken)
        };
    }

    private async Task<D158500Screen> BuildResetScreenAsync(
        CancellationToken cancellationToken)
    {
        var functionalAreas =
            await _repository.GetFunctionalAreasAsync(
                cancellationToken);

        var screen = new D158500Screen
        {
            ScreenReset = true,
            JobNumber = "",
            JobName = "",
            PcEnd = "",
            VePercent = "N/A",
            LatestRemark = "",
            ErrorMessage = ""
        };

        screen.Rows = BuildDisplayRows(functionalAreas);

        return screen;
    }

    private async Task<D158500Screen> BuildJobScreenAsync(
        JobRecord job,
        CancellationToken cancellationToken)
    {
        var functionalAreas =
            await _repository.GetFunctionalAreasAsync(
                cancellationToken);

        var statusRecords =
            await _repository.GetJobStatusesAsync(
                job.JobNumber,
                cancellationToken);

        var latestRemark =
            await _repository.GetLatestRemarkAsync(
                job.JobNumber,
                cancellationToken);

        var screen = new D158500Screen
        {
            JobNumber = Normalize(job.JobNumber),
            JobName = Normalize(job.JobName),
            PcEnd = "",
            VePercent = "N/A",
            LatestRemark = Normalize(latestRemark?.Remark),
            ScreenReset = false,
            ErrorMessage = "",
            Rows = BuildDisplayRows(functionalAreas)
        };

        if (statusRecords.Count == 0)
        {
            screen.ErrorMessage = await GetMessageAsync(
                "E00021",
                "NO STATUS RECORD FOUND",
                cancellationToken);

            return screen;
        }

        foreach (var status in statusRecords)
        {
            var fa = Normalize(status.FunctionalArea)
                .ToUpperInvariant();

            var faIndex = GetFunctionalAreaIndex(fa);

            if (faIndex == 0)
            {
                screen.ErrorMessage = await GetMessageAsync(
                    "E00020",
                    "INVALID FA ON STATUS RECORD",
                    cancellationToken);

                continue;
            }

            //
            // Legacy special fields:
            //
            // PC = functional area #12
            // VE = functional area #13
            //
            if (fa == "PC")
            {
                screen.PcEnd = Normalize(status.EndDate);
                continue;
            }

            if (fa == "VE")
            {
                screen.VePercent =
                    string.IsNullOrWhiteSpace(status.Percent)
                        ? "N/A"
                        : Normalize(status.Percent);

                continue;
            }

            var row = screen.Rows.FirstOrDefault(
                x => string.Equals(
                    x.FunctionalArea,
                    fa,
                    StringComparison.OrdinalIgnoreCase));

            if (row is null)
                continue;

            row.StartDate = Normalize(status.StartDate);
            row.ProjectedEndDate =
                Normalize(status.ProjectedEndDate);
            row.EndDate = Normalize(status.EndDate);
            row.Status = Normalize(status.Status);

            row.Percent =
                string.IsNullOrWhiteSpace(status.Percent)
                    ? "N/A"
                    : Normalize(status.Percent);
        }

        return screen;
    }

    private static List<D158500Row> BuildDisplayRows(
        IReadOnlyList<FunctionalAreaRecord> functionalAreas)
    {
        /*
         * The legacy screen displays the first 11 functional areas
         * as selectable rows.
         *
         * PC and VE are displayed separately as summary fields.
         */
        return functionalAreas
            .Where(x =>
                GetFunctionalAreaIndex(x.FunctionalArea)
                    is >= 1 and <= 11)
            .OrderBy(x => x.Sequence)
            .Select(x => new D158500Row
            {
                FunctionalArea =
                    Normalize(x.FunctionalArea).ToUpperInvariant(),

                Description = Normalize(x.Description),

                Percent = "N/A"
            })
            .ToList();
    }

    private async Task<D158500Screen> CreateErrorScreenAsync(
        string? jobNumber,
        string messageId,
        string fallback,
        CancellationToken cancellationToken)
    {
        var screen = await LoadAsync(
            jobNumber,
            cancellationToken);

        screen.ErrorMessage = await GetMessageAsync(
            messageId,
            fallback,
            cancellationToken);

        return screen;
    }

    private async Task<string> GetMessageAsync(
        string messageId,
        string fallback,
        CancellationToken cancellationToken)
    {
        try
        {
            var message = await _repository.GetMessageAsync(
                messageId,
                cancellationToken);

            return string.IsNullOrWhiteSpace(message)
                ? fallback
                : message.Trim();
        }
        catch (NotImplementedException)
        {
            // Allows the page/business layer to be developed before
            // the legacy message repository has been completed.
            return fallback;
        }
    }

    private static D158500Result RouteFunctionalArea(
        D158500RowInput row)
    {
        var selection = Normalize(row.Selection)
            .ToUpperInvariant();

        var fa = Normalize(row.FunctionalArea)
            .ToUpperInvariant();

        return selection switch
        {
            "S" or "I" => new D158500Result
            {
                DestinationPage = "302",
                FunctionalArea = fa
            },

            "U" => new D158500Result
            {
                DestinationPage = "202",
                FunctionalArea = fa
            },

            _ => new D158500Result()
        };
    }

    private static int GetFunctionalAreaIndex(string? fa)
    {
        return Normalize(fa).ToUpperInvariant() switch
        {
            "BR" => 1,
            "DS" => 2,
            "EN" => 3,
            "GT" => 4,
            "PS" => 5,
            "PA" => 6,
            "RR" => 7,
            "RW" => 8,
            "RD" => 9,
            "TR" => 10,
            "UT" => 11,
            "PC" => 12,
            "VE" => 13,
            _ => 0
        };
    }

    private static bool IsValidAction(string? action)
    {
        action = Normalize(action).ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(action))
            return true;

        return action == "SO" ||
               action.All(char.IsDigit);
    }

    private static string Normalize(string? value)
    {
        return value?.Trim() ?? "";
    }
}







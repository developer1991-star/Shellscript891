using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158950Model : PageModel
{
    [BindProperty]
    public string Command { get; set; } = string.Empty;

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string History { get; set; } = "N";

    [BindProperty]
    public List<D158950RemarkRow> Rows { get; set; } = new();

    public string JobNumber { get; set; } = string.Empty;
    public string JobName { get; set; } = string.Empty;
    public string DateText { get; set; } = string.Empty;
    public string ErrorMessage { get; set; } = string.Empty;

    public void OnGet()
    {
        SetCurrentScreen();

        DateText = DateTime.Now.ToString("MM/dd/yyyy");

        JobNumber =
            HttpContext.Session.GetString("JobNumber") ?? string.Empty;

        JobName =
            HttpContext.Session.GetString("JobName") ?? string.Empty;

        BuildRows();
    }

    public IActionResult OnPost()
    {
        DateText = DateTime.Now.ToString("MM/dd/yyyy");

        JobNumber =
            HttpContext.Session.GetString("JobNumber") ?? string.Empty;

        JobName =
            HttpContext.Session.GetString("JobName") ?? string.Empty;

        EnsureRows();

        Action = Upper(Action);
        History = Upper(History);

        foreach (var row in Rows)
            row.Selection = Upper(row.Selection);

        switch (Upper(Command))
        {
            case "F1":
                return RedirectToPage(
                    "/D158999",
                    new { screen = "950" });

            case "F3":
                return PreviousPage();

            case "F6":
                Action = string.Empty;
                History = "N";

                foreach (var row in Rows)
                    row.Selection = string.Empty;

                ModelState.Clear();
                return Page();

            case "F12":
                return RedirectToPage("/D158000");

            case "F4":
                ErrorMessage =
                    "SCROLL BACKWARD LOGIC WILL BE CONNECTED TO THE REMARK SERVICE.";
                return Page();

            case "F5":
                ErrorMessage =
                    "SCROLL FORWARD LOGIC WILL BE CONNECTED TO THE REMARK SERVICE.";
                return Page();

            case "F7":
                ErrorMessage =
                    "BACKWARD BROWSE WILL BE CONNECTED TO THE REMARK SERVICE.";
                return Page();

            case "F8":
                ErrorMessage =
                    "FORWARD BROWSE WILL BE CONNECTED TO THE REMARK SERVICE.";
                return Page();
        }

        if (History != "Y" && History != "N")
        {
            ErrorMessage = "HISTORY MUST BE Y OR N.";
            return Page();
        }

        var selectedRows =
            Rows.Where(x =>
                    !string.IsNullOrWhiteSpace(x.Selection))
                .ToList();

        if (!string.IsNullOrWhiteSpace(Action) &&
            selectedRows.Count > 0)
        {
            ErrorMessage = "NAVIGATION CONFLICT.";
            return Page();
        }

        if (selectedRows.Count > 1)
        {
            ErrorMessage = "SELECT ONLY ONE REMARK.";
            return Page();
        }

        if (selectedRows.Count == 1)
        {
            var row = selectedRows[0];

            if (row.Selection is not ("A" or "D" or "U"))
            {
                ErrorMessage =
                    "ENTER 'A' 'D' OR 'U' IN THE SELECTION FIELD.";

                return Page();
            }

            /*
             * The supplied D158950 ASPX.CBL contains WebForms/PCIM
             * screen plumbing but not the underlying business COBOL
             * which determines the target screens.
             *
             * Wire the actual A/D/U remark routing here when that
             * business program is available.
             */

            ErrorMessage =
                $"REMARK {row.Selection} PROCESSING HAS NOT YET BEEN WIRED.";

            return Page();
        }

        return Page();
    }

    private void BuildRows()
    {
        Rows = Enumerable
            .Range(0, 13)
            .Select(_ => new D158950RemarkRow())
            .ToList();

        /*
         * Replace with repository/service call.
         *
         * Example:
         *
         * var remarks =
         *     await _remarkService.GetRemarksAsync(
         *         JobNumber,
         *         History == "Y");
         *
         * Rows = remarks.Take(13)...
         */
    }

    private void EnsureRows()
    {
        Rows ??= new List<D158950RemarkRow>();

        while (Rows.Count < 13)
            Rows.Add(new D158950RemarkRow());

        if (Rows.Count > 13)
            Rows = Rows.Take(13).ToList();
    }

    private static string Upper(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();
    }

    private void SetCurrentScreen()
    {
        var current =
            HttpContext.Session.GetString("CurrentScreen");

        if (!string.IsNullOrWhiteSpace(current) &&
            !string.Equals(
                current,
                "D158950",
                StringComparison.OrdinalIgnoreCase))
        {
            HttpContext.Session.SetString(
                "PreviousScreen",
                current);
        }

        HttpContext.Session.SetString(
            "CurrentScreen",
            "D158950");
    }

    private IActionResult PreviousPage()
    {
        var previous =
            HttpContext.Session.GetString("PreviousScreen");

        if (string.IsNullOrWhiteSpace(previous))
            return RedirectToPage("/D158000");

        return RedirectToPage(
            "/" + previous.Trim().TrimStart('/'));
    }
}

public class D158950RemarkRow
{
    public string Selection { get; set; } = string.Empty;

    public string Remark { get; set; } = string.Empty;

    public string LastUpdated { get; set; } = string.Empty;

    public string FunctionalArea { get; set; } = string.Empty;

    public string RemarkType { get; set; } = string.Empty;

    public string UserId { get; set; } = string.Empty;
}






@page
@model PCPM.Pages.D158950Model

@{
    Layout = null;
    ViewData["Title"] = "D158950";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158950</title>

    <link rel="stylesheet"
          href="~/css/pcpm-terminal.css"
          asp-append-version="true" />

    <style>
        .remarks-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-top: 8px;
        }

        .remarks-table th,
        .remarks-table td {
            padding: 3px 5px;
            height: 25px;
            vertical-align: middle;
            text-align: left;
            white-space: nowrap;
        }

        .remarks-table .sel {
            width: 45px;
        }

        .remarks-table .remark {
            width: 500px;
        }

        .remarks-table .date {
            width: 85px;
        }

        .remarks-table .fa {
            width: 40px;
        }

        .remarks-table .type {
            width: 45px;
        }

        .remarks-table .user {
            width: 80px;
        }

        .history-row {
            margin-top: 10px;
            margin-bottom: 5px;
        }

        .prompt-row {
            margin-top: 10px;
            white-space: pre;
        }
    </style>
</head>

<body>

<div class="pcpm-screen">

    <form method="post" id="pcpmForm">

        <input type="hidden" asp-for="Command" />

        <div class="header-grid">

            <div>
                <div class="field-group">
                    <span>ACTION</span>

                    <input asp-for="Action"
                           maxlength="3"
                           class="terminal-dynamic-input action"
                           autocomplete="off"
                           autofocus />
                </div>

                <div class="screen-row">
                    SCREEN&nbsp;&nbsp;&nbsp;950
                </div>
            </div>

            <div class="header-center">
                <div>ARDOT PCPM&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(PROJECT STATUS MODULE)</div>
                <div>DETAILED REMARKS BROWSE BY DATE</div>
            </div>

            <div class="header-right">
                <div>D158950</div>
                <div>@Model.DateText</div>
            </div>

        </div>

        <div class="separator"></div>

        <div class="input-row">

            <div class="field-group">
                <span>JOB NUMBER</span>

                <input value="@Model.JobNumber"
                       readonly
                       class="terminal-dynamic-input job-number"
                       style="background-color:lightgray;" />
            </div>

            <div class="field-group">
                <span>NAME</span>
                <span>@Model.JobName</span>
            </div>

        </div>

        <div class="history-row field-group">
            <span>HISTORY:</span>

            <input asp-for="History"
                   maxlength="1"
                   class="terminal-dynamic-input selection-box"
                   autocomplete="off" />
        </div>

        <span asp-validation-for="History"
              class="validation-message"></span>

        <table class="remarks-table">

            <thead>
                <tr>
                    <th class="sel">SEL</th>
                    <th class="remark">CONSOLIDATED REMARKS</th>
                    <th class="date">DATE</th>
                    <th class="fa">FA</th>
                    <th class="type">TP</th>
                    <th class="user">USER</th>
                </tr>
            </thead>

            <tbody>

                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    <tr>

                        <td>
                            <input asp-for="Rows[i].Selection"
                                   maxlength="1"
                                   class="terminal-dynamic-input selection-box"
                                   autocomplete="off" />

                            <span asp-validation-for="Rows[i].Selection"
                                  class="validation-message"></span>
                        </td>

                        <td>
                            @Model.Rows[i].Remark
                            <input type="hidden" asp-for="Rows[i].Remark" />
                        </td>

                        <td>
                            @Model.Rows[i].LastUpdated
                            <input type="hidden" asp-for="Rows[i].LastUpdated" />
                        </td>

                        <td>
                            @Model.Rows[i].FunctionalArea
                            <input type="hidden" asp-for="Rows[i].FunctionalArea" />
                        </td>

                        <td>
                            @Model.Rows[i].RemarkType
                            <input type="hidden" asp-for="Rows[i].RemarkType" />
                        </td>

                        <td>
                            @Model.Rows[i].UserId
                            <input type="hidden" asp-for="Rows[i].UserId" />
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div class="prompt-row">
            ENTER 'A' 'D' OR 'U' IN THE SELECTION FIELD TO ACCESS THE DESIRED FUNCTION
        </div>

        <div class="function-keys">

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F1')">
                F1=HELP
            </button>

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F3')">
                F3=PREV
            </button>

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F4')">
                F4=SCRLB
            </button>

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F5')">
                F5=SCRLF
            </button>

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F6')">
                F6=RESET
            </button>

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F7')">
                F7=BKWRD
            </button>

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F8')">
                F8=FRWRD
            </button>

            <button type="submit"
                    class="function-button"
                    onclick="setCommand('F12')">
                F12=MAIN
            </button>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="message">
                @Model.ErrorMessage
            </div>
        }

    </form>

</div>

<script>
    function setCommand(command) {
        document.getElementById("Command").value = command;
    }

    document.addEventListener("input", function (event) {
        if (event.target.tagName === "INPUT" &&
            event.target.type === "text") {

            event.target.value =
                event.target.value.toUpperCase();
        }
    });

    document.addEventListener("keydown", function (event) {

        const supported = [
            "F1", "F3", "F4", "F5",
            "F6", "F7", "F8", "F12"
        ];

        if (!supported.includes(event.key))
            return;

        event.preventDefault();

        document.getElementById("Command").value = event.key;
        document.getElementById("pcpmForm").submit();
    });
</script>

</body>
</html>
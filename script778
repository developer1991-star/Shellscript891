
import csv
import time

from google.cloud import firestore
from google.cloud import storage
from google.api_core.exceptions import (
    Aborted,
    DeadlineExceeded,
    InternalServerError,
    ResourceExhausted,
    ServiceUnavailable,
)

# ============================================================
# CONFIG
# ============================================================

# -------- GCS source file --------
GCS_BUCKET = "emp-ep-gcs-seas-uat"
GCS_BLOB = "working/IDH_20260908165115.txt"

# Project that owns / can access the bucket.
GCS_PROJECT_ID = "gcp-emp-ep-uat"

# -------- Firestore target --------
# Change this if the Employees collection is in a different project.
FIRESTORE_PROJECT_ID = "gcp-emp-ep-dev"
COLLECTION_NAME = "Employees"

# Incoming file format.
DELIMITER = "^"
HAS_HEADER = False

# Input-file column positions (0-based).
EMPLOYEE_ID_INDEX = 0

# Change these two indexes to the locations of the two incoming values.
COLUMN_A_INDEX = 1
COLUMN_B_INDEX = 2

# Change these to the exact Firestore field names to update.
COLUMN_A_FIELD = "COLUMN_A_FIELD_NAME"
COLUMN_B_FIELD = "COLUMN_B_FIELD_NAME"

# Firestore batch writes must remain below 500 operations.
BATCH_SIZE = 450

# GCS streaming read chunk. The 356 MB file is streamed instead of
# downloaded completely into memory.
GCS_CHUNK_SIZE = 8 * 1024 * 1024  # 8 MB

MAX_RETRIES = 8
BASE_RETRY_SECONDS = 2

RETRYABLE_EXCEPTIONS = (
    Aborted,
    DeadlineExceeded,
    InternalServerError,
    ResourceExhausted,
    ServiceUnavailable,
)


# ============================================================
# CLIENTS
# ============================================================

db = firestore.Client(project=FIRESTORE_PROJECT_ID)
employees = db.collection(COLLECTION_NAME)

storage_client = storage.Client(project=GCS_PROJECT_ID)
bucket = storage_client.bucket(GCS_BUCKET)
blob = bucket.blob(GCS_BLOB, chunk_size=GCS_CHUNK_SIZE)


# ============================================================
# HELPERS
# ============================================================

def retry(operation_name, fn):
    """Retry transient Google Cloud failures with exponential backoff."""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            return fn()
        except RETRYABLE_EXCEPTIONS as exc:
            if attempt == MAX_RETRIES:
                raise

            wait_seconds = min(
                60,
                BASE_RETRY_SECONDS * (2 ** (attempt - 1)),
            )

            print(
                f"WARNING: {operation_name} failed "
                f"({type(exc).__name__}). "
                f"Retrying in {wait_seconds}s..."
            )
            time.sleep(wait_seconds)


def read_records():
    """
    Stream the source file directly from GCS.

    Only these three values are read from each row:
      - employee ID
      - Column A
      - Column B

    The entire 356 MB object is NOT loaded into memory.
    """
    required_index = max(
        EMPLOYEE_ID_INDEX,
        COLUMN_A_INDEX,
        COLUMN_B_INDEX,
    )

    print(f"Opening gs://{GCS_BUCKET}/{GCS_BLOB}")

    # blob.open() performs a streaming/ranged read from Cloud Storage.
    with blob.open(
        "rt",
        encoding="utf-8-sig",
        newline="",
    ) as source:
        reader = csv.reader(source, delimiter=DELIMITER)

        if HAS_HEADER:
            next(reader, None)

        first_data_line = 2 if HAS_HEADER else 1

        for line_number, row in enumerate(
            reader,
            start=first_data_line,
        ):
            if not row:
                continue

            if len(row) <= required_index:
                print(
                    f"WARNING: Skipping line {line_number}; "
                    f"expected at least {required_index + 1} columns."
                )
                continue

            employee_id = row[EMPLOYEE_ID_INDEX].strip()

            if not employee_id:
                continue

            # Skip trailer records from the IDH file.
            if employee_id.startswith("TRL"):
                continue

            if "/" in employee_id:
                print(
                    f"WARNING: Skipping invalid employeeID "
                    f"on line {line_number}: {employee_id}"
                )
                continue

            yield (
                employee_id,
                row[COLUMN_A_INDEX],
                row[COLUMN_B_INDEX],
            )


def chunked(records, size):
    chunk = []

    for record in records:
        chunk.append(record)

        if len(chunk) == size:
            yield chunk
            chunk = []

    if chunk:
        yield chunk


def process_batch(records, missing_employee_ids):
    """
    If employee exists:
        update ONLY COLUMN_A_FIELD and COLUMN_B_FIELD.

    If employee does not exist:
        make no Firestore change and remember the employee ID.
    """

    # If an employee occurs more than once in one input chunk,
    # the last occurrence in that chunk wins.
    records_by_employee = {
        employee_id: (column_a, column_b)
        for employee_id, column_a, column_b in records
    }

    refs = {
        employee_id: employees.document(employee_id)
        for employee_id in records_by_employee
    }

    snapshots = retry(
        "employee lookup",
        lambda: list(db.get_all(list(refs.values()))),
    )

    existing_employee_ids = {
        snapshot.id
        for snapshot in snapshots
        if snapshot.exists
    }

    batch = db.batch()
    updates_in_batch = 0

    for employee_id, (column_a, column_b) in records_by_employee.items():
        if employee_id not in existing_employee_ids:
            missing_employee_ids.append(employee_id)
            continue

        batch.update(
            refs[employee_id],
            {
                COLUMN_A_FIELD: column_a,
                COLUMN_B_FIELD: column_b,
            },
        )
        updates_in_batch += 1

    if updates_in_batch:
        retry("batch update", batch.commit)

    return updates_in_batch


# ============================================================
# MAIN
# ============================================================

def main():
    if (
        COLUMN_A_FIELD == "COLUMN_A_FIELD_NAME"
        or COLUMN_B_FIELD == "COLUMN_B_FIELD_NAME"
    ):
        raise ValueError(
            "Set COLUMN_A_FIELD and COLUMN_B_FIELD "
            "to the exact Firestore field names before running."
        )

    processed = 0
    updated = 0
    missing_employee_ids = []
    batch_number = 0

    print(f"GCS source: gs://{GCS_BUCKET}/{GCS_BLOB}")
    print(f"Firestore project: {FIRESTORE_PROJECT_ID}")
    print(f"Collection: {COLLECTION_NAME}")
    print(
        f"Updating existing employees only: "
        f"{COLUMN_A_FIELD}, {COLUMN_B_FIELD}"
    )
    print()

    for records in chunked(read_records(), BATCH_SIZE):
        batch_number += 1

        batch_updated = process_batch(
            records,
            missing_employee_ids,
        )

        processed += len(records)
        updated += batch_updated

        print(
            f"[Batch {batch_number}] "
            f"processed={processed:,} | "
            f"updated={updated:,} | "
            f"not_found={len(missing_employee_ids):,}"
        )

    # Print each missing employee once at the end.
    unique_missing_ids = list(dict.fromkeys(missing_employee_ids))

    print()
    print("=" * 70)
    print("COMPLETED")
    print("=" * 70)
    print(f"Processed: {processed:,}")
    print(f"Updated:   {updated:,}")
    print(f"Not found: {len(unique_missing_ids):,}")
    print()

    print("EMPLOYEE IDs NOT FOUND")
    print("-" * 70)

    if unique_missing_ids:
        for employee_id in unique_missing_ids:
            print(employee_id)
    else:
        print("None")

    print("-" * 70)


if __name__ == "__main__":
    main()
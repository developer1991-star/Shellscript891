           IF CURSOR-POSITION >= 01130 AND <= 01131                                                                                                                                                     
              MOVE 1 TO SEL5-CURSOR.                                                                                                                                                                    
           IF CURSOR-POSITION >= 01681 AND <= 01689                                                                                                                                                     
              MOVE 1 TO PF1-CURSOR.                                                                                                                                                                     
           IF CURSOR-POSITION >= 01690 AND <= 01702                                                                                                                                                     

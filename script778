@page
@model PCPM.Pages.D158920Model

@{
    Layout = null;
    ViewData["Title"] = "D158920";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158920</title>

    <style>
        body {
            margin: 0;
            padding: 30px;
            background: #F2F3FF;
            color: #111;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
        }

        .screen {
            max-width: 1000px;
            margin: 0 auto;
        }

        .header {
            display: grid;
            grid-template-columns: 180px 1fr 150px;
            align-items: start;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        .line {
            margin: 14px 0;
            border-top: 2px solid #555;
        }

        .criteria {
            display: grid;
            grid-template-columns:
                100px 35px 170px
                100px 130px
                120px 35px;
            gap: 8px;
            align-items: center;
            margin: 20px 0;
        }

        input {
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            padding: 3px 5px;
            text-transform: uppercase;
            box-sizing: border-box;
        }

        input:focus {
            background: yellow;
            outline: none;
        }

        .readonly {
            background: LightGray;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th, td {
            text-align: left;
            padding: 7px 4px;
            white-space: nowrap;
        }

        .select {
            width: 25px;
        }

        .prompt {
            margin: 20px 0 14px;
            text-align: center;
        }

        .keys {
            border-top: 2px solid #555;
            padding-top: 12px;
            display: flex;
            justify-content: space-between;
        }

        .pf {
            background: transparent;
            border: 0;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .error {
            color: red;
            margin-top: 15px;
        }
    </style>
</head>

<body>
<form method="post" id="legacyForm">
    @Html.AntiForgeryToken()

    <div class="screen">
        <div class="header">
            <div>
                ACTION
                <input name="Action"
                       value="@Model.Action"
                       maxlength="3"
                       style="width:42px;" />
            </div>

            <div class="center">
                ARDOT PCPM (PROJECT STATUS MODULE)<br />
                <strong>JOB STATUS BROWSE PANEL</strong>
            </div>

            <div class="right">
                D158920<br />
                @Model.DateText
            </div>
        </div>

        <div class="line"></div>

        <div class="criteria">
            <span>STATUS</span>

            <input name="WorkingStatus"
                   value="@Model.WorkingStatus"
                   maxlength="2"
                   readonly
                   class="readonly"
                   style="width:35px;" />

            <span>@Model.StatusTranslation</span>

            <span>JOB NO</span>

            <input name="WorkingJobNumber"
                   value="@Model.WorkingJobNumber"
                   maxlength="10"
                   readonly
                   class="readonly" />

            <span>JOB SEQ</span>

            <input name="WorkingJobSequence"
                   value="@Model.WorkingJobSequence"
                   maxlength="2"
                   readonly
                   class="readonly"
                   style="width:35px;" />
        </div>

        <div class="line"></div>

        <table>
            <thead>
            <tr>
                <th style="width:40px;">SEL</th>
                <th style="width:95px;">JOB NO</th>
                <th style="width:45px;">SEQ</th>
                <th style="width:45px;">ST</th>
                <th style="width:45px;">DIST</th>
                <th style="width:40px;">CO</th>
                <th style="width:50px;">RTE</th>
                <th style="width:50px;">SEC</th>
                <th>JOB NAME</th>
            </tr>
            </thead>

            <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                <tr>
                    <td>
                        <input name="Rows[@i].Selection"
                               value="@Model.Rows[i].Selection"
                               maxlength="1"
                               class="select" />
                    </td>

                    <td>@Model.Rows[i].JobNumber</td>
                    <td>@Model.Rows[i].JobSequence</td>
                    <td>@Model.Rows[i].Status</td>
                    <td>@Model.Rows[i].District</td>
                    <td>@Model.Rows[i].County</td>
                    <td>@Model.Rows[i].Route</td>
                    <td>@Model.Rows[i].Section</td>
                    <td>@Model.Rows[i].JobName</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="prompt">
            ENTER 'A' 'S' 'I' 'D' OR 'U' IN THE SELECTION FIELD, PRESS ENTER
        </div>

        <div class="keys">
            <button class="pf" name="command" value="F1">F1=HELP</button>
            <button class="pf" name="command" value="F3">F3=PREVIOUS</button>
            <button class="pf" name="command" value="F6">F6=RESET</button>
            <button class="pf" name="command" value="F7">F7=BACKWARD</button>
            <button class="pf" name="command" value="F8">F8=FORWARD</button>
            <button class="pf" name="command" value="F12">F12=MAIN MENU</button>
        </div>

        <div class="error">
            @Model.ErrorMessage
        </div>
    </div>
</form>
</body>
</html>




using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158920Model : PageModel
{
    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string WorkingStatus { get; set; } = string.Empty;

    [BindProperty]
    public string WorkingJobNumber { get; set; } = string.Empty;

    [BindProperty]
    public string WorkingJobSequence { get; set; } = string.Empty;

    [BindProperty]
    public List<JobStatusRow> Rows { get; set; } = CreateRows();

    public string DateText { get; set; } = string.Empty;

    public string StatusTranslation { get; set; } = string.Empty;

    public string ErrorMessage { get; set; } = string.Empty;

    public async Task OnGetAsync(
        string? status = null,
        string? jobNo = null,
        string? jobSeq = null)
    {
        DateText = DateTime.Today.ToString("MM/dd/yyyy");

        WorkingStatus = Normalize(status, 2);
        WorkingJobNumber = Normalize(jobNo, 10);
        WorkingJobSequence = Normalize(jobSeq, 2);

        EnsureRows();

        await LoadRowsAsync();
    }

    public async Task<IActionResult> OnPostAsync(string? command)
    {
        Action = Normalize(Action, 3);
        WorkingStatus = NormalizeStatus(WorkingStatus);
        WorkingJobNumber = Normalize(WorkingJobNumber, 10);
        WorkingJobSequence = Normalize(WorkingJobSequence, 2);

        EnsureRows();

        foreach (var row in Rows)
            row.Selection = Normalize(row.Selection, 1);

        await LoadRowsAsync();

        switch (command?.ToUpperInvariant())
        {
            case "F6":
                foreach (var row in Rows)
                    row.Selection = string.Empty;

                ErrorMessage = string.Empty;
                return Page();

            case "F7":
                ErrorMessage =
                    "TODO: implement D158920 backward browse from main COBOL.";
                return Page();

            case "F8":
                ErrorMessage =
                    "TODO: implement D158920 forward browse from main COBOL.";
                return Page();

            case "F1":
                ErrorMessage =
                    "TODO: wire D158920 help processing.";
                return Page();

            case "F3":
                return PreviousOrMain();

            case "F12":
                return RedirectToPage("/D158000");
        }

        /*
         * Main business COBOL must define:
         *
         * - A/S/I/D/U routing
         * - status filter behavior
         * - browse starting key
         * - F7/F8 paging keys
         * - authorization
         * - error messages
         */

        return Page();
    }

    private async Task LoadRowsAsync()
    {
        /*
         * Authoritative wrapper fields:
         *
         * WSTATUS   X(2)
         * STS-TRN   X(15)
         * WJOBNO    X(10)
         * WJOBSEQ   X(2)
         *
         * Ten occurrences:
         * SELECT-R  X(1)
         * JOBNO     X(10)
         * JOBSEQ    X(2)
         * STATUS-R  X(2)
         * DIST      X(2)
         * CO        X(2)
         * RTE       X(3)
         * SEC       X(3)
         * JOBNAM    X(45)
         *
         * TODO: retrieve through Application service.
         */

        EnsureRows();

        await Task.CompletedTask;
    }

    private IActionResult PreviousOrMain()
    {
        var referer = Request.Headers.Referer.ToString();

        if (Uri.TryCreate(referer, UriKind.Absolute, out var uri) &&
            string.Equals(
                uri.Authority,
                Request.Host.Value,
                StringComparison.OrdinalIgnoreCase))
        {
            return LocalRedirect(uri.PathAndQuery);
        }

        return RedirectToPage("/D158000");
    }

    private void EnsureRows()
    {
        Rows ??= new List<JobStatusRow>();

        while (Rows.Count < 10)
            Rows.Add(new JobStatusRow());

        if (Rows.Count > 10)
            Rows = Rows.Take(10).ToList();
    }

    private static List<JobStatusRow> CreateRows()
    {
        return Enumerable.Range(0, 10)
            .Select(_ => new JobStatusRow())
            .ToList();
    }

    private static string NormalizeStatus(string? value)
    {
        var status = Normalize(value, 2);

        if (string.IsNullOrWhiteSpace(status))
            return string.Empty;

        if (int.TryParse(status, out var number))
            return number.ToString("00");

        return status;
    }

    private static string Normalize(string? value, int maxLength)
    {
        var result = (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        return result.Length <= maxLength
            ? result
            : result[..maxLength];
    }

    public sealed class JobStatusRow
    {
        public string Selection { get; set; } = string.Empty;
        public string JobNumber { get; set; } = string.Empty;
        public string JobSequence { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string District { get; set; } = string.Empty;
        public string County { get; set; } = string.Empty;
        public string Route { get; set; } = string.Empty;
        public string Section { get; set; } = string.Empty;
        public string JobName { get; set; } = string.Empty;
    }
}

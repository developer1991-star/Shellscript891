"""Bulk sync Firestore Employees from PROD to UAT and DEV.

What this does:
- Reads every document from the PROD Employees collection.
- Upserts/replaces the same document ID in UAT and DEV.
- Uses Firestore BulkWriter for parallelized writes.
- Flushes/checkpoints progress every 20,000 source documents.
- Prints percentage, throughput and ETA.

Important:
- This mirrors document contents for matching document IDs, but it DOES NOT delete
  documents that exist only in UAT/DEV.
- This syncs the configured collection only; document subcollections are not copied.
"""

from __future__ import annotations

import os
import time
from typing import Dict, Iterator

from google.cloud import firestore
from google.cloud.firestore_v1.field_path import FieldPath


# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
SOURCE_PROJECT = "gcp-emp-ep-prod"
SOURCE_DATABASE = "(default)"
SOURCE_COLLECTION = "Employees"

# I could see gcp-emp-ep-dev in the screenshots, but not a distinct UAT project ID.
# Set UAT_PROJECT in your environment or replace the placeholder below.
UAT_PROJECT = os.getenv("UAT_PROJECT", "REPLACE_WITH_UAT_PROJECT_ID")
DEV_PROJECT = os.getenv("DEV_PROJECT", "gcp-emp-ep-dev")

UAT_DATABASE = "(default)"
DEV_DATABASE = "(default)"
UAT_COLLECTION = "Employees"
DEV_COLLECTION = "Employees"

# Your requested application-level batch/checkpoint size.
LOGICAL_BATCH_SIZE = 20_000

# Number of source documents read per Firestore query page.
# This is intentionally smaller than LOGICAL_BATCH_SIZE so we do not hold 20k
# full documents in memory at once.
READ_PAGE_SIZE = 1_000

TARGETS = {
    "UAT": {
        "project": UAT_PROJECT,
        "database": UAT_DATABASE,
        "collection": UAT_COLLECTION,
    },
    "DEV": {
        "project": DEV_PROJECT,
        "database": DEV_DATABASE,
        "collection": DEV_COLLECTION,
    },
}


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def validate_config() -> None:
    if UAT_PROJECT == "REPLACE_WITH_UAT_PROJECT_ID":
        raise ValueError(
            "Set UAT_PROJECT to the real UAT GCP project ID, either in this file "
            "or as an environment variable."
        )

    for name, cfg in TARGETS.items():
        if cfg["project"] == SOURCE_PROJECT:
            raise ValueError(f"{name} project must not be the PROD source project.")


def make_client(project: str, database: str) -> firestore.Client:
    return firestore.Client(project=project, database=database)


def get_document_count(collection_ref) -> int:
    """Return the number of documents using Firestore's COUNT aggregation."""
    results = collection_ref.count(alias="total").get()
    if not results:
        return 0
    return int(results[0][0].value)


def iter_documents(collection_ref) -> Iterator:
    """Page through the entire collection ordered by document ID."""
    last_snapshot = None

    while True:
        query = (
            collection_ref
            .order_by(FieldPath.document_id())
            .limit(READ_PAGE_SIZE)
        )

        if last_snapshot is not None:
            query = query.start_after(last_snapshot)

        page = list(query.stream())
        if not page:
            return

        for snapshot in page:
            yield snapshot

        last_snapshot = page[-1]

        if len(page) < READ_PAGE_SIZE:
            return


def format_duration(seconds: float) -> str:
    if seconds == float("inf"):
        return "unknown"

    seconds = max(0, int(seconds))
    hours, remainder = divmod(seconds, 3600)
    minutes, seconds = divmod(remainder, 60)

    if hours:
        return f"{hours}h {minutes}m {seconds}s"
    if minutes:
        return f"{minutes}m {seconds}s"
    return f"{seconds}s"


def print_progress(
    processed: int,
    total: int,
    started_at: float,
    logical_batch_number: int,
    target_count: int,
) -> None:
    elapsed = max(time.monotonic() - started_at, 0.001)
    docs_per_second = processed / elapsed

    if total > 0:
        percentage = min(100.0, (processed / total) * 100.0)
        remaining = max(total - processed, 0)
        eta = remaining / docs_per_second if docs_per_second > 0 else float("inf")
    else:
        percentage = 100.0
        eta = 0

    completed_target_writes = processed * target_count

    print(
        f"[batch {logical_batch_number:,}] "
        f"{processed:,}/{total:,} docs | "
        f"{percentage:6.2f}% | "
        f"{docs_per_second:,.1f} source docs/s | "
        f"{completed_target_writes:,} target writes completed | "
        f"ETA {format_duration(eta)}",
        flush=True,
    )


# -----------------------------------------------------------------------------
# Sync
# -----------------------------------------------------------------------------
def sync_collection() -> None:
    validate_config()

    print("Creating Firestore clients...")
    source_db = make_client(SOURCE_PROJECT, SOURCE_DATABASE)
    source_collection = source_db.collection(SOURCE_COLLECTION)

    target_clients: Dict[str, firestore.Client] = {}
    target_collections = {}
    writers = {}

    for name, cfg in TARGETS.items():
        client = make_client(cfg["project"], cfg["database"])
        target_clients[name] = client
        target_collections[name] = client.collection(cfg["collection"])
        writers[name] = client.bulk_writer()

    print(
        f"Source: {SOURCE_PROJECT}/{SOURCE_DATABASE}/{SOURCE_COLLECTION}\n"
        + "\n".join(
            f"Target {name}: {cfg['project']}/{cfg['database']}/{cfg['collection']}"
            for name, cfg in TARGETS.items()
        )
    )

    print("Counting PROD documents...")
    total = get_document_count(source_collection)
    print(f"PROD documents to sync: {total:,}")

    if total == 0:
        print("Nothing to sync.")
        return

    started_at = time.monotonic()
    processed = 0
    docs_since_flush = 0
    logical_batch_number = 0
    last_document_id = None

    try:
        for snapshot in iter_documents(source_collection):
            data = snapshot.to_dict() or {}
            document_id = snapshot.id
            last_document_id = document_id

            # Queue the same document to every configured lower environment.
            # merge=False means the target document is replaced with PROD's fields.
            for name, target_collection in target_collections.items():
                target_ref = target_collection.document(document_id)
                writers[name].set(target_ref, data, merge=False)

            processed += 1
            docs_since_flush += 1

            # 20,000 is the application-level batch/checkpoint. BulkWriter itself
            # safely breaks those writes into smaller parallel Firestore requests.
            if docs_since_flush >= LOGICAL_BATCH_SIZE:
                logical_batch_number += 1

                # flush() blocks until all queued writes for that writer are complete,
                # so the percentage printed below represents completed work.
                for writer in writers.values():
                    writer.flush()

                print_progress(
                    processed=processed,
                    total=total,
                    started_at=started_at,
                    logical_batch_number=logical_batch_number,
                    target_count=len(TARGETS),
                )

                print(f"Checkpoint document ID: {last_document_id}", flush=True)
                docs_since_flush = 0

        # Final partial logical batch.
        if docs_since_flush > 0:
            logical_batch_number += 1
            for writer in writers.values():
                writer.flush()

            print_progress(
                processed=processed,
                total=total,
                started_at=started_at,
                logical_batch_number=logical_batch_number,
                target_count=len(TARGETS),
            )

        elapsed = time.monotonic() - started_at
        print(
            "\nSync completed successfully.\n"
            f"Source documents synced: {processed:,}\n"
            f"Total target writes: {processed * len(TARGETS):,}\n"
            f"Elapsed: {format_duration(elapsed)}"
        )

    finally:
        # close() waits for any remaining pooled operations and then shuts down.
        for writer in writers.values():
            writer.close()


if __name__ == "__main__":
    sync_collection()

private static int GetFunctionalAreaIndex(string? fa)
{
    return fa?.Trim().ToUpperInvariant() switch
    {
        "BR" => 1,
        "DS" => 2,
        "EN" => 3,
        "GT" => 4,
        "PS" => 5,
        "PA" => 6,
        "RR" => 7,
        "RW" => 8,
        "RD" => 9,
        "TR" => 10,
        "UT" => 11,
        "PC" => 12,
        "VE" => 13,
        _ => 0
    };
}

private static bool IsValidAction(string? action)
{
    if (string.IsNullOrWhiteSpace(action))
        return true;

    action = action.Trim().ToUpperInvariant();

    return action == "SO" ||
           action.All(char.IsDigit);
}



///////////////////////



private static D158500Result RouteFunctionalArea(
    D158500RowInput row)
{
    var selection = row.Selection
        .Trim()
        .ToUpperInvariant();

    return selection switch
    {
        "S" or "I" => new D158500Result
        {
            DestinationPage = "302",
            FunctionalArea = row.FunctionalArea
        },

        "U" => new D158500Result
        {
            DestinationPage = "202",
            FunctionalArea = row.FunctionalArea
        },

        _ => new D158500Result()
    };
}










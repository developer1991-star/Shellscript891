- bash: |
    set -euo pipefail

    CREATED_REVISION="$(
      gcloud run services describe "$(CloudRunDrService)" \
        --project="$(GcpProject)" \
        --region="$(GcpDrRegion)" \
        --format='value(status.latestCreatedRevisionName)'
    )"

    echo "Created DR revision: ${CREATED_REVISION}"

    READY_REVISION=""

    for i in {1..30}; do
      READY_REVISION="$(
        gcloud run services describe "$(CloudRunDrService)" \
          --project="$(GcpProject)" \
          --region="$(GcpDrRegion)" \
          --format='value(status.latestReadyRevisionName)'
      )"

      echo "Created revision: ${CREATED_REVISION}"
      echo "Ready revision:   ${READY_REVISION}"

      if [ "${CREATED_REVISION}" = "${READY_REVISION}" ]; then
        echo "DR candidate is ready: ${CREATED_REVISION}"
        echo "##vso[task.setvariable variable=DrCandidateRevision]${CREATED_REVISION}"
        exit 0
      fi

      echo "Waiting for ${CREATED_REVISION} to become ready..."
      sleep 5
    done

    echo "##vso[task.logissue type=error]Revision ${CREATED_REVISION} did not become ready"
    exit 1
  displayName: Verify PROD DR candidate revision

 - bash: |
    set -euo pipefail

    DR_REVISION="$(DrCandidateRevision)"

    echo "Promoting verified DR revision: ${DR_REVISION}"

    gcloud run services update-traffic "$(CloudRunDrService)" \
      --project="$(GcpProject)" \
      --region="$(GcpDrRegion)" \
      --to-revisions="${DR_REVISION}=100" \
      --quiet

    echo "DR traffic successfully moved to ${DR_REVISION}"
  displayName: Promote PROD DR revision to 100% traffic








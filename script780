# 1. Export dev indexes
firebase firestore:indexes --project gcp-cti-ucs-dev > firestore.indexes.json

# 2. Minimal firebase.json so deploy knows where the file is
echo '{"firestore":{"indexes":"firestore.indexes.json"}}' > firebase.json

# 3. Deploy to UAT
firebase deploy --only firestore:indexes --project <UAT_PROJECT_ID>
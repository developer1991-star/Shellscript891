cat > inspect_prod_key.py <<'PY'
import binascii
import pgpy
from google.cloud import secretmanager

project_id = "gcp-emp-ep-prod"
secret_id = "emp-ep-secret-key"

client = secretmanager.SecretManagerServiceClient()

name = f"projects/{project_id}/secrets/{secret_id}/versions/latest"
response = client.access_secret_version(request={"name": name})

secret_value = response.payload.data.decode("utf-8")
secret_value = binascii.a2b_base64(secret_value)

key, _ = pgpy.PGPKey.from_blob(secret_value)

print("PRIMARY KEY ALGORITHM:", key.key_algorithm)

for subkey_id, subkey in key.subkeys.items():
    print("SUBKEY:", subkey_id, "ALGORITHM:", subkey.key_algorithm)
PY
import firebase_admin
from firebase_admin import credentials, firestore

# Initialize Firebase
cred = credentials.Certificate("serviceAccountKey.json")
firebase_admin.initialize_app(cred)

db = firestore.client()

# Employee collection
employee_ref = db.collection("Employee")

for doc in employee_ref.stream():
    data = doc.to_dict()

    fields_to_add = {}

    # Add only if missing
    if "Field A" not in data:
        fields_to_add["Field A"] = ""

    if "Field B" not in data:
        fields_to_add["Field B"] = ""

    # Update only when at least one field is missing
    if fields_to_add:
        doc.reference.update(fields_to_add)
        print(f"Updated Employee document: {doc.id} -> {fields_to_add}")
    else:
        print(f"Skipped Employee document: {doc.id}")

print("Finished updating Employee collection.")
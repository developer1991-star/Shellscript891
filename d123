@page
@model PCPM.Pages.D158302Model

@{
    Layout = null;
    ViewData["Title"] = "D158302";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>D158302</title>

    <link rel="stylesheet"
          href="~/css/pcpm-terminal.css"
          asp-append-version="true" />

    <style>
        /*
         * Screen 302 specific layout only.
         * Colors, fonts, inputs, buttons, screen background, etc.
         * come from pcpm-terminal.css.
         */

        .d158302-job-row {
            display: grid;
            grid-template-columns:
                auto 12ch
                auto 4ch
                1fr
                auto 4ch;
            column-gap: 1.25rem;
            align-items: center;
            margin-top: 0.75rem;
        }

        .d158302-date-heading {
            text-align: center;
            margin-top: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .d158302-status-header,
        .d158302-status-row {
            display: grid;
            grid-template-columns:
                20ch
                11ch
                11ch
                11ch
                12ch
                8ch;
            align-items: center;
        }

        .d158302-status-header {
            margin-bottom: 0.25rem;
        }

        .d158302-status-row {
            min-height: 1.6rem;
        }

        .d158302-history-row {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-top: 0.5rem;
        }

        .d158302-remarks-title {
            text-align: center;
            margin-top: 1rem;
            margin-bottom: 0.5rem;
        }

        .d158302-remark-header,
        .d158302-remark-row,
        .d158302-latest-row {
            display: grid;
            grid-template-columns:
                4ch
                52ch
                12ch
                4ch
                4ch
                4ch;
            column-gap: 0.5rem;
            align-items: center;
        }

        .d158302-remark-header {
            margin-bottom: 0.25rem;
        }

        .d158302-remark-row {
            min-height: 1.75rem;
        }

        .d158302-remark-text {
            white-space: nowrap;
            overflow: hidden;
        }

        .d158302-instruction {
            margin-top: 0.75rem;
            text-align: center;
            white-space: nowrap;
        }

        .d158302-latest-heading {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
        }

        .d158302-selection-space {
            display: inline-block;
            width: 2ch;
        }

        .d158302-center {
            text-align: center;
        }

        .d158302-job-input {
            width: 11ch;
        }

        .d158302-fa-input {
            width: 3ch;
        }

        .d158302-history-input {
            width: 2ch;
            text-align: center;
        }

        .d158302-selection-input {
            width: 2ch;
            text-align: center;
        }
    </style>
</head>

<body>

    <div class="pcpm-screen">

        <form method="post"
              asp-page="/D158302"
              id="pcpmForm"
              class="pcpm-form">

            <!-- =========================================================
                 HEADER
                 ========================================================= -->

            <div class="pcpm-header-row">

                <div class="pcpm-header-left">

                    ACTION

                    <input asp-for="Action"
                           class="pcpm-input pcpm-input-3"
                           maxlength="3"
                           autocomplete="off"
                           oninput="this.value = this.value.toUpperCase();"
                           autofocus />

                </div>


                <div class="pcpm-header-center">
                    ARDOT PRE-CONSTRUCTION PROJECT MONITORING
                </div>


                <div class="pcpm-header-right">
                    D158302
                </div>

            </div>


            <div class="pcpm-header-row">

                <div class="pcpm-header-left">
                    SCREEN&nbsp;&nbsp;302
                </div>


                <div class="pcpm-header-center">
                    INQUIRY FUNCTIONAL AREA STATUS
                </div>


                <div class="pcpm-header-right">
                    @Model.DisplayDate
                </div>

            </div>


            <div class="pcpm-separator"></div>


            <!-- =========================================================
                 JOB / FUNCTIONAL AREA
                 ========================================================= -->

            <div class="d158302-job-row">

                <span>JOB NUMBER</span>

                <input asp-for="JobNumber"
                       id="jobNumberInput"
                       class="pcpm-input d158302-job-input"
                       maxlength="10"
                       autocomplete="off"
                       oninput="this.value = this.value.toUpperCase();"
                       readonly="@(Model.Screen?.ScreenReset == true ? null : "readonly")" />


                <span>FA</span>

                <input asp-for="FunctionalArea"
                       id="functionalAreaInput"
                       class="pcpm-input d158302-fa-input"
                       maxlength="2"
                       autocomplete="off"
                       oninput="this.value = this.value.toUpperCase();"
                       readonly="@(Model.Screen?.ScreenReset == true ? null : "readonly")" />


                <span>
                    @Model.Screen.FunctionalAreaDescription
                </span>


                <span>STATUS:</span>

                <span>
                    @Model.Screen.Status
                </span>

            </div>


            <!-- =========================================================
                 STATUS / DATES
                 ========================================================= -->

            <div class="d158302-date-heading">
                ------------------DATES--------------------
            </div>


            <div class="d158302-status-header">

                <span>PERCENT COMPLETE</span>

                <span class="d158302-center">
                    START
                </span>

                <span class="d158302-center">
                    PROJ COM
                </span>

                <span class="d158302-center">
                    COMPLETE
                </span>

                <span class="d158302-center">
                    UPDATED
                </span>

                <span class="d158302-center">
                    USR
                </span>

            </div>


            <div class="d158302-status-row">

                <span>
                    @Model.Screen.Percent
                </span>

                <span class="d158302-center">
                    @Model.Screen.StartDate
                </span>

                <span class="d158302-center">
                    @Model.Screen.ProjectedEndDate
                </span>

                <span class="d158302-center">
                    @Model.Screen.EndDate
                </span>

                <span class="d158302-center">
                    @Model.Screen.LastUpdated
                </span>

                <span class="d158302-center">
                    @Model.Screen.UserId
                </span>

            </div>


            <!-- =========================================================
                 HISTORY
                 ========================================================= -->

            <div class="d158302-history-row">

                <span>HISTORY:</span>

                <input asp-for="History"
                       id="historyInput"
                       class="pcpm-input pcpm-input-1 d158302-history-input"
                       maxlength="1"
                       autocomplete="off"
                       oninput="this.value = this.value.toUpperCase();" />

            </div>


            <!-- =========================================================
                 REMARKS WORK AREA
                 ========================================================= -->

            <div class="d158302-remarks-title">
                REMARKS WORK AREA
            </div>


            <div class="d158302-remark-header">

                <span>SEL</span>

                <span class="d158302-center">
                    REMARKS:
                </span>

                <span class="d158302-center">
                    DATE
                </span>

                <span class="d158302-center">
                    TP
                </span>

                <span class="d158302-center">
                    SF
                </span>

                <span class="d158302-center">
                    DF
                </span>

            </div>


            <!-- =========================================================
                 FIVE REMARK ROWS
                 ========================================================= -->

            @for (var i = 0; i < 5; i++)
            {
                var hasRemark =
                    Model.Screen.Remarks != null &&
                    i < Model.Screen.Remarks.Count;

                var selectionValue =
                    Model.Selections != null &&
                    i < Model.Selections.Count
                        ? Model.Selections[i]
                        : "";

                <div class="d158302-remark-row">

                    @if (hasRemark &&
                         Model.Screen.Remarks[i].CanSelect)
                    {
                        <input name="Selections[@i]"
                               value="@selectionValue"
                               maxlength="1"
                               autocomplete="off"
                               class="pcpm-input pcpm-input-1 selection-field d158302-selection-input"
                               oninput="this.value = this.value.toUpperCase();" />
                    }
                    else
                    {
                        /*
                         * Preserve all five list positions for model binding,
                         * but do not draw a disabled white textbox.
                         */
                        <input type="hidden"
                               name="Selections[@i]"
                               value="@selectionValue" />

                        <span class="d158302-selection-space"></span>
                    }


                    @if (hasRemark)
                    {
                        <span class="d158302-remark-text">
                            @Model.Screen.Remarks[i].Remark
                        </span>

                        <span class="d158302-center">
                            @Model.Screen.Remarks[i].LastUpdated
                        </span>

                        <span class="d158302-center">
                            @Model.Screen.Remarks[i].RemarkType
                        </span>

                        <span class="d158302-center">
                            @Model.Screen.Remarks[i].StatusFlag
                        </span>

                        <span class="d158302-center">
                            @Model.Screen.Remarks[i].DeleteFlag
                        </span>
                    }
                    else
                    {
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    }

                </div>
            }


            <!-- =========================================================
                 INSTRUCTION
                 ========================================================= -->

            <div class="d158302-instruction">
                ENTER 'A' 'D' OR 'U' IN THE SELECTION FIELD TO ACCESS THE DESIRED FUNCTION
            </div>


            <!-- =========================================================
                 LATEST REMARK
                 ========================================================= -->

            <div class="d158302-latest-heading">

                <span>
                    LATEST REMARK MADE BY
                </span>

                <span>
                    @Model.Screen.LatestRemarkFunctionalArea
                </span>

                <span>
                    @Model.Screen.LatestRemarkUserId
                </span>

            </div>


            <div class="d158302-latest-row">

                @if (Model.Screen.LatestRemarkCanSelect)
                {
                    <input asp-for="LatestSelection"
                           class="pcpm-input pcpm-input-1 selection-field d158302-selection-input"
                           maxlength="1"
                           autocomplete="off"
                           oninput="this.value = this.value.toUpperCase();" />
                }
                else
                {
                    <input type="hidden"
                           asp-for="LatestSelection" />

                    <span class="d158302-selection-space"></span>
                }


                <span class="d158302-remark-text">
                    @Model.Screen.LatestRemark
                </span>


                <span class="d158302-center">
                    @Model.Screen.LatestRemarkLastUpdated
                </span>


                <span class="d158302-center">
                    @Model.Screen.LatestRemarkType
                </span>


                <span class="d158302-center">
                    @Model.Screen.LatestRemarkStatusFlag
                </span>


                <span class="d158302-center">
                    @Model.Screen.LatestRemarkDeleteFlag
                </span>

            </div>


            <div class="pcpm-separator"></div>


            <!-- =========================================================
                 FUNCTION KEYS
                 ========================================================= -->

            <div class="pcpm-function-keys">

                <button type="submit"
                        asp-page-handler="Help"
                        id="helpButton"
                        class="pcpm-function-button">
                    F1=HELP
                </button>


                <button type="submit"
                        asp-page-handler="Previous"
                        id="previousButton"
                        class="pcpm-function-button">
                    F3=PREV
                </button>


                <button type="submit"
                        asp-page-handler="ScrollLeft"
                        id="scrollLeftButton"
                        class="pcpm-function-button">
                    F4=SCRLB
                </button>


                <button type="submit"
                        asp-page-handler="ScrollRight"
                        id="scrollRightButton"
                        class="pcpm-function-button">
                    F5=SCRLF
                </button>


                <button type="submit"
                        asp-page-handler="Reset"
                        id="resetButton"
                        class="pcpm-function-button">
                    F6=RESET
                </button>


                <button type="submit"
                        asp-page-handler="Backward"
                        id="backwardButton"
                        class="pcpm-function-button">
                    F7=BKWRD
                </button>


                <button type="submit"
                        asp-page-handler="Forward"
                        id="forwardButton"
                        class="pcpm-function-button">
                    F8=FRWRD
                </button>


                <button type="submit"
                        asp-page-handler="MainMenu"
                        id="mainMenuButton"
                        class="pcpm-function-button">
                    F12=MAIN
                </button>

            </div>


            <!-- =========================================================
                 ERROR / INFORMATION MESSAGE
                 ========================================================= -->

            <div class="pcpm-error">
                @Model.ErrorMessage
            </div>


            <!-- =========================================================
                 ENTER
                 ========================================================= -->

            <button type="submit"
                    id="enterButton"
                    class="pcpm-hidden-submit">
            </button>

        </form>

    </div>


    <script>
        (() => {

            /*
             * Uppercase the legacy terminal-entry fields.
             */
            document.querySelectorAll(
                ".selection-field, .pcpm-input"
            ).forEach(input => {

                input.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value.toUpperCase();

                    });

            });


            /*
             * Physical PF keys / Enter.
             */
            document.addEventListener(
                "keydown",
                function (event) {

                    let id = null;


                    switch (event.key) {

                        case "Enter":
                            id = "enterButton";
                            break;

                        case "F1":
                            id = "helpButton";
                            break;

                        case "F3":
                            id = "previousButton";
                            break;

                        case "F4":
                            id = "scrollLeftButton";
                            break;

                        case "F5":
                            id = "scrollRightButton";
                            break;

                        case "F6":
                            id = "resetButton";
                            break;

                        case "F7":
                            id = "backwardButton";
                            break;

                        case "F8":
                            id = "forwardButton";
                            break;

                        case "F12":
                            id = "mainMenuButton";
                            break;
                    }


                    if (!id)
                        return;


                    event.preventDefault();


                    const button =
                        document.getElementById(id);


                    if (button)
                        button.click();

                });


            /*
             * Legacy F6 behavior:
             * after Reset, JOB NUMBER and FA become editable.
             * Put focus back on JOB NUMBER.
             */
            const jobNumber =
                document.getElementById(
                    "jobNumberInput");


            if (jobNumber &&
                !jobNumber.hasAttribute("readonly")) {

                jobNumber.focus();

            }

        })();
    </script>

</body>
</html>
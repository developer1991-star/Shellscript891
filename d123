namespace PCPM.Session;

public static class PcpmSessionKeys
{
    public const string SessionId =
        "PCPM.SessionId";

    public const string UserId =
        "PCPM.UserId";

    public const string CurrentScreen =
        "PCPM.CurrentScreen";

    public const string PreviousScreen =
        "PCPM.PreviousScreen";

    public const string JobNumber =
        "PCPM.JobNumber";

    public const string FunctionalArea =
        "PCPM.FunctionalArea";

    public const string JobSequence =
        "PCPM.JobSequence";
}





var builder =
    WebApplication.CreateBuilder(args);

builder.Services.AddRazorPages();


// --------------------------------------------------
// D158000 application processing
// --------------------------------------------------

builder.Services.AddScoped<
    ID158000Service,
    D158000Service>();


// --------------------------------------------------
// PCPM security
// --------------------------------------------------

builder.Services.AddScoped<
    IPcpmSecurityService,
    PcpmSecurityService>();

builder.Services.AddScoped<
    IPcpmSecurityRepository>(serviceProvider =>
    {
        var connectionString =
            builder.Configuration
                .GetConnectionString(
                    "PcpmDatabase");

        if (string.IsNullOrWhiteSpace(
                connectionString))
        {
            throw new InvalidOperationException(
                "PCPM database connection string " +
                "was not configured.");
        }

        return new PcpmSecurityRepository(
            connectionString);
    });


// --------------------------------------------------
// PCPM session
// --------------------------------------------------

builder.Services.AddDistributedMemoryCache();

builder.Services.AddSession(options =>
{
    options.IdleTimeout =
        TimeSpan.FromMinutes(30);

    options.Cookie.Name =
        ".PCPM.Session";

    options.Cookie.HttpOnly = true;

    options.Cookie.IsEssential = true;

    options.Cookie.SameSite =
        SameSiteMode.Lax;

    options.Cookie.SecurePolicy =
        CookieSecurePolicy.Always;
});





using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PCPM.Application.D158000;
using PCPM.Application.Security;
using PCPM.Session;

private readonly ID158000Service _service;
private readonly IPcpmSecurityService _securityService;

public D158000Model(
    ID158000Service service,
    IPcpmSecurityService securityService)
{
    _service = service;
    _securityService = securityService;
}





public async Task<IActionResult> OnGetAsync()
{
    var userId =
        User.Identity?.Name;

    if (string.IsNullOrWhiteSpace(userId))
    {
        //
        // Once organization authentication is configured,
        // this will send the user through the organization's
        // login mechanism.
        //
        return Challenge();
    }

    var hasAccess =
        await _securityService.CanAccessPcpmAsync(
            userId,
            HttpContext.RequestAborted);

    if (!hasAccess)
    {
        return Forbid();
    }

    InitializePcpmSession(userId);

    return Page();
}


private void InitializePcpmSession(
    string userId)
{
    var session = HttpContext.Session;

    //
    // Create our PCPM business/session ID
    // only once.
    //
    if (string.IsNullOrWhiteSpace(
            session.GetString(
                PcpmSessionKeys.SessionId)))
    {
        session.SetString(
            PcpmSessionKeys.SessionId,
            Guid.NewGuid().ToString("N"));
    }

    session.SetString(
        PcpmSessionKeys.UserId,
        userId);

    session.SetString(
        PcpmSessionKeys.CurrentScreen,
        "D158000");
}





var result =
    await _service.ProcessAsync(
        request);

if (!result.Success)
{
    ErrorMessage =
        result.ErrorMessage;

    return Page();
}


// Save PCPM context
var session =
    HttpContext.Session;

session.SetString(
    PcpmSessionKeys.PreviousScreen,
    "D158000");

session.SetString(
    PcpmSessionKeys.CurrentScreen,
    result.NextScreen!);

if (!string.IsNullOrWhiteSpace(
        result.JobNumber))
{
    session.SetString(
        PcpmSessionKeys.JobNumber,
        result.JobNumber);
}

if (!string.IsNullOrWhiteSpace(
        result.FA))
{
    session.SetString(
        PcpmSessionKeys.FunctionalArea,
        result.FA);
}

if (!string.IsNullOrWhiteSpace(
        result.JobSequence))
{
    session.SetString(
        PcpmSessionKeys.JobSequence,
        result.JobSequence);
}


// Navigate
return RedirectToPage(
    $"/{result.NextScreen}");









using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PCPM.Application.D158000;

namespace PCPM.Pages;

public class D158000Model : PageModel
{
    private readonly ID158000Service _service;

    public D158000Model(ID158000Service service)
    {
        _service = service;
    }

    [BindProperty]
    public string? Action { get; set; }

    [BindProperty]
    public string? JobNumber { get; set; }

    [BindProperty]
    public string? FA { get; set; }

    [BindProperty]
    public string? JobSequence { get; set; }

    [BindProperty]
    public string? Selection1 { get; set; }

    [BindProperty]
    public string? Selection2 { get; set; }

    [BindProperty]
    public string? Selection3 { get; set; }

    [BindProperty]
    public string? Selection4 { get; set; }

    [BindProperty]
    public string? Selection5 { get; set; }

    [BindProperty]
    public string? Selection6 { get; set; }

    public string? ErrorMessage { get; set; }

    public string DisplayDate =>
        DateTime.Now.ToString("MM/dd/yyyy");

    public void OnGet()
    {
    }

    // Main ENTER/Submit
    public async Task<IActionResult> OnPostAsync()
    {
        var request = new D158000Request
        {
            Action = Action,
            JobNumber = JobNumber,
            FA = FA,
            JobSequence = JobSequence,

            Selection1 = Selection1,
            Selection2 = Selection2,
            Selection3 = Selection3,
            Selection4 = Selection4,
            Selection5 = Selection5,
            Selection6 = Selection6
        };

        var result =
            await _service.ProcessAsync(request);

        if (!result.Success)
        {
            ErrorMessage = result.ErrorMessage;
            return Page();
        }

        // Temporary until destination pages exist
        ErrorMessage =
            $"Navigation accepted. Next screen: {result.NextScreen}";

        return Page();

        // Later:
        // return RedirectToPage($"/{result.NextScreen}");
    }

    // F1
    public IActionResult OnPostHelp()
    {
        ErrorMessage =
            "ENTER 'S' NEXT TO ONE MENU OPTION AND PRESS ENTER.";

        return Page();
    }

    // F3
    public IActionResult OnPostPrevious()
    {
        ErrorMessage = "NO PREVIOUS SCREEN.";

        return Page();
    }

    // F6
    public IActionResult OnPostReset()
    {
        return RedirectToPage("/D158000");
    }
}
@page
@model PCPM.Pages.D158302Model

@{
    Layout = null;
    ViewData["Title"] = "D158302";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158302</title>

    <link rel="stylesheet"
          href="~/css/pcpm-terminal.css" />

    <style>
        body {
            background-color: #F2F3FF;
            font-family: "Courier New", Courier, monospace;
            font-weight: bold;
        }

        .d158302-screen {
            position: relative;
            width: 820px;
            height: 620px;
            margin: 0 auto;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: bold;
            white-space: pre;
        }

        .d158302-field {
            position: absolute;
        }

        .d158302-input {
            position: absolute;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: bold;
            padding: 2px 3px;
            box-sizing: border-box;
            text-transform: uppercase;
        }

        .d158302-readonly {
            background-color: LightGray;
        }

        .d158302-selection {
            width: 24px;
            text-align: center;
        }

        .d158302-function-button {
            position: absolute;
            border: none;
            background: transparent;
            padding: 0;
            margin: 0;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            color: #111;
        }

            .d158302-function-button:hover {
                text-decoration: underline;
            }

        .d158302-error {
            position: absolute;
            left: 10px;
            top: 575px;
            color: red;
            white-space: pre;
        }

        .hidden-selection {
            visibility: hidden;
        }
    </style>
</head>

<body>

    <form method="post"
          id="d158302Form">

        <div class="d158302-screen">

            <!-- ============================================================
                 HEADER
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:10px; top:25px;">
                ACTION
            </span>

            <input name="Action"
                   id="Action"
                   value="@Model.Action"
                   maxlength="3"
                   autocomplete="off"
                   autofocus
                   class="d158302-input"
                   style="left:90px; top:25px; width:34px;"
                   oninput="this.value=this.value.toUpperCase();" />

            <span class="d158302-field"
                  style="left:200px; top:25px;">
                ARDOT PRE-CONSTRUCTION PROJECT MONITORING
            </span>

            <span class="d158302-field"
                  style="left:710px; top:25px;">
                D158302
            </span>

            <span class="d158302-field"
                  style="left:10px; top:50px;">
                SCREEN
            </span>

            <span class="d158302-field"
                  style="left:90px; top:50px;">
                302
            </span>

            <span class="d158302-field"
                  style="left:250px; top:50px;">
                INQUIRY FUNCTIONAL AREA STATUS
            </span>

            <span class="d158302-field"
                  style="left:680px; top:50px;">
                @Model.DisplayDate
            </span>

            <span class="d158302-field"
                  style="left:10px; top:75px;">
                =============================================================================
            </span>


            <!-- ============================================================
                 JOB / FUNCTIONAL AREA
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:10px; top:100px;">
                JOB NUMBER
            </span>

            <input name="JobNumber"
                   id="JobNumber"
                   value="@Model.JobNumber"
                   maxlength="10"
                   readonly
                   class="d158302-input d158302-readonly"
                   style="left:130px; top:100px; width:90px;" />

            <span class="d158302-field"
                  style="left:290px; top:100px;">
                FA
            </span>

            <input name="FunctionalArea"
                   id="FunctionalArea"
                   value="@Model.FunctionalArea"
                   maxlength="2"
                   readonly
                   class="d158302-input d158302-readonly"
                   style="left:330px; top:100px; width:32px;" />

            <span class="d158302-field"
                  style="left:390px; top:100px;">
                @Model.Screen.FunctionalAreaDescription
            </span>

            <span class="d158302-field"
                  style="left:670px; top:100px;">
                STATUS:
            </span>

            <span class="d158302-field"
                  style="left:760px; top:100px;">
                @Model.Screen.Status
            </span>


            <!-- ============================================================
                 STATUS DATES
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:270px; top:125px;">
                ------------------DATES--------------------
            </span>

            <span class="d158302-field"
                  style="left:10px; top:150px;">
                PERCENT COMPLETE
            </span>

            <span class="d158302-field"
                  style="left:190px; top:150px;">
                @Model.Screen.Percent
            </span>

            <span class="d158302-field"
                  style="left:280px; top:150px;">
                START
            </span>

            <span class="d158302-field"
                  style="left:380px; top:150px;">
                PROJ COM
            </span>

            <span class="d158302-field"
                  style="left:490px; top:150px;">
                COMPLETE
            </span>

            <span class="d158302-field"
                  style="left:620px; top:150px;">
                UPDATED
            </span>

            <span class="d158302-field"
                  style="left:730px; top:150px;">
                USR
            </span>

            <span class="d158302-field"
                  style="left:270px; top:175px;">
                @Model.Screen.StartDate
            </span>

            <span class="d158302-field"
                  style="left:380px; top:175px;">
                @Model.Screen.ProjectedEndDate
            </span>

            <span class="d158302-field"
                  style="left:490px; top:175px;">
                @Model.Screen.EndDate
            </span>

            <span class="d158302-field"
                  style="left:600px; top:175px;">
                @Model.Screen.LastUpdated
            </span>

            <span class="d158302-field"
                  style="left:710px; top:175px;">
                @Model.Screen.UserId
            </span>


            <!-- ============================================================
                 HISTORY
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:10px; top:200px;">
                HISTORY:
            </span>

            <input name="History"
                   id="History"
                   value="@Model.History"
                   maxlength="1"
                   autocomplete="off"
                   class="d158302-input"
                   style="left:110px; top:200px; width:26px;"
                   oninput="this.value=this.value.toUpperCase();" />


            <!-- ============================================================
                 REMARK WORK AREA
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:300px; top:225px;">
                REMARKS WORK AREA
            </span>

            <span class="d158302-field"
                  style="left:10px; top:250px;">
                SEL
            </span>

            <span class="d158302-field"
                  style="left:140px; top:250px;">
                REMARKS:
            </span>

            <span class="d158302-field"
                  style="left:600px; top:250px;">
                DATE
            </span>

            <span class="d158302-field"
                  style="left:690px; top:250px;">
                TP
            </span>

            <span class="d158302-field"
                  style="left:720px; top:250px;">
                SF
            </span>

            <span class="d158302-field"
                  style="left:760px; top:250px;">
                DF
            </span>


            @for (var i = 0; i < Model.Screen.Remarks.Count; i++)
            {
                var row = Model.Screen.Remarks[i];
                var top = 275 + (i * 25);

                if (row.CanSelect)
                {
                    <input name="Selections[@i]"
                           value="@Model.Selections[i]"
                           maxlength="1"
                           autocomplete="off"
                           class="d158302-input d158302-selection"
                           style="left:20px; top:@(top)px;"
                           oninput="this.value=this.value.toUpperCase();" />
                }
                else
                {
                    <input type="hidden"
                           name="Selections[@i]"
                           value="@Model.Selections[i]" />

                    <input value=""
                           disabled
                           class="d158302-input d158302-selection hidden-selection"
                           style="left:20px; top:@(top)px;" />
                }

                <span class="d158302-field"
                      style="left:50px; top:@(top)px;">
                    @row.Remark
                </span>

                <span class="d158302-field"
                      style="left:570px; top:@(top)px;">
                    @row.LastUpdated
                </span>

                <span class="d158302-field"
                      style="left:680px; top:@(top)px;">
                    @row.RemarkType
                </span>

                <span class="d158302-field"
                      style="left:720px; top:@(top)px;">
                    @row.StatusFlag
                </span>

                <span class="d158302-field"
                      style="left:760px; top:@(top)px;">
                    @row.DeleteFlag
                </span>
            }


            <!-- ============================================================
                 INSTRUCTION
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:20px; top:400px;">
                ENTER 'A' 'D' OR 'U' IN THE SELECTION FIELD TO ACCESS THE DESIRED FUNCTION
            </span>


            <!-- ============================================================
                 LATEST REMARK
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:150px; top:450px;">
                LATEST REMARK MADE BY
            </span>

            <span class="d158302-field"
                  style="left:380px; top:450px;">
                @Model.Screen.LatestRemarkFunctionalArea
            </span>

            <span class="d158302-field"
                  style="left:420px; top:450px;">
                @Model.Screen.LatestRemarkUserId
            </span>


            @if (Model.Screen.LatestRemarkCanSelect)
            {
                <input name="LatestSelection"
                       value="@Model.LatestSelection"
                       maxlength="1"
                       autocomplete="off"
                       class="d158302-input d158302-selection"
                       style="left:20px; top:500px;"
                       oninput="this.value=this.value.toUpperCase();" />
            }
            else
            {
                <input type="hidden"
                       name="LatestSelection"
                       value="@Model.LatestSelection" />

                <input value=""
                       disabled
                       class="d158302-input d158302-selection hidden-selection"
                       style="left:20px; top:500px;" />
            }

            <span class="d158302-field"
                  style="left:50px; top:500px;">
                @Model.Screen.LatestRemark
            </span>

            <span class="d158302-field"
                  style="left:570px; top:500px;">
                @Model.Screen.LatestRemarkLastUpdated
            </span>

            <span class="d158302-field"
                  style="left:680px; top:500px;">
                @Model.Screen.LatestRemarkType
            </span>

            <span class="d158302-field"
                  style="left:720px; top:500px;">
                @Model.Screen.LatestRemarkStatusFlag
            </span>

            <span class="d158302-field"
                  style="left:770px; top:500px;">
                @Model.Screen.LatestRemarkDeleteFlag
            </span>


            <!-- ============================================================
                 SEPARATOR
                 ============================================================ -->

            <span class="d158302-field"
                  style="left:10px; top:525px;">
                -----------------------------------------------------------------------------
            </span>


            <!-- ============================================================
                 FUNCTION KEYS
                 ============================================================ -->

            <button type="submit"
                    asp-page-handler="Help"
                    id="helpButton"
                    class="d158302-function-button"
                    style="left:10px; top:550px;">
                F1=HELP
            </button>

            <button type="submit"
                    asp-page-handler="Previous"
                    id="previousButton"
                    class="d158302-function-button"
                    style="left:100px; top:550px;">
                F3=PREV
            </button>

            <button type="submit"
                    asp-page-handler="ScrollLeft"
                    id="scrollLeftButton"
                    class="d158302-function-button"
                    style="left:190px; top:550px;">
                F4=SCRLB
            </button>

            <button type="submit"
                    asp-page-handler="ScrollRight"
                    id="scrollRightButton"
                    class="d158302-function-button"
                    style="left:290px; top:550px;">
                F5=SCRLF
            </button>

            <button type="submit"
                    asp-page-handler="Reset"
                    id="resetButton"
                    class="d158302-function-button"
                    style="left:390px; top:550px;">
                F6=RESET
            </button>

            <button type="submit"
                    asp-page-handler="Backward"
                    id="backwardButton"
                    class="d158302-function-button"
                    style="left:490px; top:550px;">
                F7=BKWRD
            </button>

            <button type="submit"
                    asp-page-handler="Forward"
                    id="forwardButton"
                    class="d158302-function-button"
                    style="left:590px; top:550px;">
                F8=FRWRD
            </button>

            <button type="submit"
                    asp-page-handler="MainMenu"
                    id="mainMenuButton"
                    class="d158302-function-button"
                    style="left:690px; top:550px;">
                F12=MAIN
            </button>


            <!-- ============================================================
                 ERROR MESSAGE
                 ============================================================ -->
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <span class="d158302-error">
                    @Model.ErrorMessage
                </span>
            }

        </div>

    </form>


    <script>
        document.addEventListener("keydown", function (event) {

            let button = null;

            switch (event.key) {
                case "F1":
                    button = document.getElementById("helpButton");
                    break;

                case "F3":
                    button = document.getElementById("previousButton");
                    break;

                case "F4":
                    button = document.getElementById("scrollLeftButton");
                    break;

                case "F5":
                    button = document.getElementById("scrollRightButton");
                    break;

                case "F6":
                    button = document.getElementById("resetButton");
                    break;

                case "F7":
                    button = document.getElementById("backwardButton");
                    break;

                case "F8":
                    button = document.getElementById("forwardButton");
                    break;

                case "F12":
                    button = document.getElementById("mainMenuButton");
                    break;
            }

            if (button) {
                event.preventDefault();
                button.click();
            }
        });
    </script>

</body>
</html>

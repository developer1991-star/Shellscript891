public Task<D158302Screen> ResetAsync(
    CancellationToken cancellationToken = default)
{
    cancellationToken.ThrowIfCancellationRequested();

    var screen = new D158302Screen
    {
        History = "N",
        HistoryHold = "N",

        ScreenReset = true,

        JobNumberEditable = true,
        FunctionalAreaEditable = true
    };

    return Task.FromResult(screen);
}


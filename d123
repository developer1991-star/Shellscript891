 public string GetOrCreate(string userId)

    {

        var sessionId =

            Session.GetString(PcpmSessionKeys.SessionId);

        if (!string.IsNullOrWhiteSpace(sessionId))

        {

            return sessionId;

        }

        Clear();

        sessionId = RandomNumberGenerator

            .GetInt32(1, 1_000_000)

            .ToString("D6", CultureInfo.InvariantCulture);

        Session.SetString(

            PcpmSessionKeys.SessionId,

            sessionId);

        Session.SetString(

            PcpmSessionKeys.UserId,

            userId);

        return sessionId;

    }

 
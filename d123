namespace PCPM.Web.Session;

public interface IPcpmSessionService
{
    string GetOrCreate(string userId);

    string? GetSessionNumber();

    string? GetUserId();

    void SetCurrentScreen(string screenName);

    string? GetCurrentScreen();

    void Clear();
}


using System.Globalization;
using System.Security.Cryptography;

namespace PCPM.Web.Session;

public sealed class PcpmSessionService : IPcpmSessionService
{
    private readonly IHttpContextAccessor _httpContextAccessor;

    public PcpmSessionService(
        IHttpContextAccessor httpContextAccessor)
    {
        _httpContextAccessor = httpContextAccessor;
    }

    private ISession Session =>
        _httpContextAccessor.HttpContext?.Session
        ?? throw new InvalidOperationException(
            "HTTP session is not available.");

    public string GetOrCreate(string userId)
    {
        var sessionNumber =
            Session.GetString(PcpmSessionKeys.SessionNumber);

        var existingUserId =
            Session.GetString(PcpmSessionKeys.UserId);

        if (!string.IsNullOrWhiteSpace(sessionNumber) &&
            string.Equals(
                existingUserId,
                userId,
                StringComparison.OrdinalIgnoreCase))
        {
            return sessionNumber;
        }

        Clear();

        sessionNumber =
            RandomNumberGenerator
                .GetInt32(1, 1_000_000)
                .ToString("D6", CultureInfo.InvariantCulture);

        Session.SetString(
            PcpmSessionKeys.SessionNumber,
            sessionNumber);

        Session.SetString(
            PcpmSessionKeys.UserId,
            userId);

        Session.SetString(
            PcpmSessionKeys.CreatedUtc,
            DateTimeOffset.UtcNow.ToString(
                "O",
                CultureInfo.InvariantCulture));

        return sessionNumber;
    }

    public string? GetSessionNumber()
    {
        return Session.GetString(
            PcpmSessionKeys.SessionNumber);
    }

    public string? GetUserId()
    {
        return Session.GetString(
            PcpmSessionKeys.UserId);
    }

    public void SetCurrentScreen(string screenName)
    {
        Session.SetString(
            PcpmSessionKeys.CurrentScreen,
            screenName);
    }

    public string? GetCurrentScreen()
    {
        return Session.GetString(
            PcpmSessionKeys.CurrentScreen);
    }

    public void Clear()
    {
        Session.Remove(PcpmSessionKeys.SessionNumber);
        Session.Remove(PcpmSessionKeys.UserId);
        Session.Remove(PcpmSessionKeys.CreatedUtc);
        Session.Remove(PcpmSessionKeys.CurrentScreen);
    }
}

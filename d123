                 set S_JOBNO::ReadOnly to False                                                                                                                                                         
                 set S_JOBNO::BackColor to type System.Drawing.Color::White                                                                                                                             
              END-IF                                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT JOBNO-ATTR TALLYING UCT-COUNT FOR ALL "P"                                                                                                                                         
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_JOBNO::ReadOnly to True                                                                                                                                                          
                 set S_JOBNO::BackColor to type System.Drawing.Color::LightGray                                                                                                                         
              END-IF                                                                                                                                                                                    
              IF JOBNO-ATTR(1:3) = "UAH"                                                                                                                                                                
                 set S_JOBNO::BorderColor to type System.Drawing.Color::Red                                                                                                                             
                 set S_JOBNO::BorderStyle to type System.Web.UI.WebControls.BorderStyle::Solid                                                                                                          
              ELSE                                                                                                                                                                                      
                 set S_JOBNO::BorderColor to type System.Drawing.Color::White                                                                                                                           
                 set S_JOBNO::BorderStyle to type System.Web.UI.WebControls.BorderStyle::NotSet                                                                                                         
              END-IF                                                                                                                                                                                    
           END-IF.                                                                                                                                                                                      
           IF FA-ATTR NOT = SPACES                                                                                                                                                                      
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT FA-ATTR TALLYING UCT-COUNT FOR ALL "U"                                                                                                                                            
              INSPECT FA-ATTR TALLYING UCT-COUNT FOR ALL "C"                                                                                                                                            
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_FA::ReadOnly to False                                                                                                                                                            
                 set S_FA::BackColor to type System.Drawing.Color::White                                                                                                                                
              END-IF                                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT FA-ATTR TALLYING UCT-COUNT FOR ALL "P"                                                                                                                                            
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_FA::ReadOnly to True                                                                                                                                                             
                 set S_FA::BackColor to type System.Drawing.Color::LightGray                                                                                                                            
              END-IF                                                                                                                                                                                    
              IF FA-ATTR(1:3) = "UAH"                                                                                                                                                                   
                 set S_FA::BorderColor to type System.Drawing.Color::Red                                                                                                                                
                 set S_FA::BorderStyle to type System.Web.UI.WebControls.BorderStyle::Solid                                                                                                             
              ELSE                                                                                                                                                                                      
                 set S_FA::BorderColor to type System.Drawing.Color::White                                                                                                                              
                 set S_FA::BorderStyle to type System.Web.UI.WebControls.BorderStyle::NotSet                                                                                                            
              END-IF                                                                                                                                                                                    
           END-IF.                                                                                                                                                                                      
           IF SEL1-ATTR NOT = SPACES                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT SEL1-ATTR TALLYING UCT-COUNT FOR ALL "U"                                                                                                                                          
              INSPECT SEL1-ATTR TALLYING UCT-COUNT FOR ALL "C"                                                                                                                                          
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_SEL1::ReadOnly to False                                                                                                                                                          
                 set S_SEL1::BackColor to type System.Drawing.Color::White                                                                                                                              
              END-IF                                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT SEL1-ATTR TALLYING UCT-COUNT FOR ALL "P"                                                                                                                                          
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_SEL1::ReadOnly to True                                                                                                                                                           
                 set S_SEL1::BackColor to type System.Drawing.Color::LightGray                                                                                                                          
              END-IF                                                                                                                                                                                    
              IF SEL1-ATTR(1:3) = "UAH"                                                                                                                                                                 
                 set S_SEL1::BorderColor to type System.Drawing.Color::Red                                                                                                                              
                 set S_SEL1::BorderStyle to type System.Web.UI.WebControls.BorderStyle::Solid                                                                                                           

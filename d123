@page
@model PCPM.Pages.D158802Model
@{
    Layout = null;
    ViewData["Title"] = "D158802";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>D158802</title>
    <link rel="stylesheet" href="/css/pcpm-terminal.css" />

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #F2F3FF;
            color: #111;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
        }

        .legacy-screen {
            position: relative;
            width: 820px;
            height: 620px;
            margin: 0 auto;
            font-family: "Courier New", Courier, monospace;
            font-weight: 700;
        }

        .legacy-label {
            position: absolute;
            white-space: pre;
            line-height: 20px;
        }

        .legacy-input {
            position: absolute;
            box-sizing: border-box;
            height: 22px;
            padding: 1px 2px;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            color: #111;
            background: white;
            border: 1px solid #666;
            border-radius: 0;
        }

        .legacy-input:focus {
            outline: none;
            background: #ffff00;
        }

        .legacy-input[readonly] {
            background: LightGray;
        }

        .pf-button {
            position: absolute;
            border: none;
            background: transparent;
            padding: 0;
            margin: 0;
            font-family: "Courier New", Courier, monospace;
            font-size: 16px;
            font-weight: 700;
            color: #111;
            cursor: pointer;
            white-space: pre;
        }

        .pf-button:hover,
        .pf-button:focus {
            text-decoration: underline;
        }

        .default-submit {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }

        .error-message {
            position: absolute;
            left: 10px;
            top: 575px;
            width: 790px;
            color: red;
            white-space: pre-wrap;
        }

        .offline-message {
            position: absolute;
            left: 20px;
            top: 1px;
            color: red;
        }
    </style>
</head>

<body>
<form method="post"
      action="/D158802?fa=@Uri.EscapeDataString(Model.Wfa ?? string.Empty)">

    @Html.AntiForgeryToken()

    <div class="legacy-screen">

        <button type="submit"
                name="Command"
                value="ENTER"
                class="default-submit"
                tabindex="-1">
        </button>

        <input type="hidden"
               name="SelectedRowIndex"
               value="@Model.SelectedRowIndex" />

        @* -----------------------------------------------------------------
           HEADER
           ----------------------------------------------------------------- *@

        <span class="legacy-label" style="left:10px; top:25px;">ACTION</span>

        <input class="legacy-input"
               id="Action"
               name="Action"
               value="@Model.Action"
               maxlength="3"
               style="left:90px; top:25px; width:24px;"
               tabindex="1"
               autofocus />

        <span class="legacy-label"
              style="left:190px; top:25px;">ARDOT PRE-CONSTRUCTION PROJECT MONITORING</span>

        <span class="legacy-label"
              style="left:710px; top:25px;">D158802</span>

        <span class="legacy-label"
              style="left:10px; top:50px;">SCREEN</span>

        <span class="legacy-label"
              style="left:90px; top:50px;">802</span>

        <span class="legacy-label"
              style="left:260px; top:50px;">UPDATE STANDARD REMARKS PANEL</span>

        <span class="legacy-label"
              style="left:680px; top:50px;">@Model.DateText</span>

        <span class="legacy-label"
              style="left:10px; top:75px;">=============================================================================</span>

        @* -----------------------------------------------------------------
           CONTEXT
           ----------------------------------------------------------------- *@

        <span class="legacy-label"
              style="left:10px; top:100px;">FUNCTIONAL AREA</span>

        <input class="legacy-input"
               value="@Model.Wfa"
               maxlength="2"
               readonly
               style="left:180px; top:100px; width:16px;"
               tabindex="2" />

        <span class="legacy-label"
              style="left:220px; top:100px;">@Model.WfaTranslation</span>

        <span class="legacy-label"
              style="left:620px; top:100px;">USER ID</span>

        <span class="legacy-label"
              style="left:710px; top:100px;">@Model.UserId</span>

        <span class="legacy-label"
              style="left:10px; top:125px;">-----------------------------------------------------------------------------</span>

        @* -----------------------------------------------------------------
           STANDARD REMARKS
           ----------------------------------------------------------------- *@

        <span class="legacy-label"
              style="left:270px; top:150px;">STANDARDIZED REMARKS</span>

        <span class="legacy-label"
              style="left:90px; top:175px;">SEL</span>

        <span class="legacy-label"
              style="left:170px; top:175px;">FA</span>

        <span class="legacy-label"
              style="left:210px; top:175px;">TYPE</span>

        <span class="legacy-label"
              style="left:460px; top:175px;">REMARK</span>

        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var top = 200 + (i * 25);
            var tabIndex = 3 + i;

            <input class="legacy-input"
                   id="Selection_@i"
                   name="Selections[@i]"
                   value="@Model.Selections[i]"
                   maxlength="1"
                   style="@($"left:100px; top:{top}px; width:8px;")"
                   tabindex="@tabIndex" />

            <span class="legacy-label"
                  style="@($"left:170px; top:{top}px;")">@Model.Rows[i].FunctionalArea</span>

            <span class="legacy-label"
                  style="@($"left:220px; top:{top}px;")">@Model.Rows[i].RemarkType</span>

            <span class="legacy-label"
                  style="@($"left:280px; top:{top}px;")">@Model.Rows[i].Remark</span>
        }

        @* -----------------------------------------------------------------
           UPDATE WORK AREA
           ----------------------------------------------------------------- *@

        <span class="legacy-label"
              style="left:100px; top:475px;">ENTER 'U' IN SEL, MODIFY REMARK, PRESS ENTER</span>

        <span class="legacy-label"
              style="left:10px; top:500px;">UPD STD REMARK</span>

        <span class="legacy-label"
              style="left:170px; top:500px;">@Model.WorkFunctionalArea</span>

        <span class="legacy-label"
              style="left:220px; top:500px;">@Model.WorkRemarkType</span>

        @if (Model.IsEditMode)
        {
            <input class="legacy-input"
                   id="WRemark"
                   name="WRemark"
                   value="@Model.WRemark"
                   maxlength="50"
                   style="left:280px; top:500px; width:400px;"
                   tabindex="14" />
        }
        else
        {
            <input class="legacy-input"
                   id="WRemark"
                   name="WRemark"
                   value="@Model.WRemark"
                   maxlength="50"
                   readonly
                   style="left:280px; top:500px; width:400px;"
                   tabindex="14" />
        }

        <span class="legacy-label"
              style="left:10px; top:525px;">-----------------------------------------------------------------------------</span>

        @* -----------------------------------------------------------------
           FUNCTION KEYS
           ----------------------------------------------------------------- *@

        <button type="submit"
                name="Command"
                value="PF1"
                data-command="PF1"
                class="pf-button"
                style="left:10px; top:550px;"> F1=HELP</button>

        <button type="submit"
                name="Command"
                value="PF3"
                data-command="PF3"
                class="pf-button"
                style="left:100px; top:550px;"> F3=PREV</button>

        <button type="submit"
                name="Command"
                value="PF4"
                data-command="PF4"
                class="pf-button"
                style="left:190px; top:550px;"> F4=SCRLB</button>

        <button type="submit"
                name="Command"
                value="PF5"
                data-command="PF5"
                class="pf-button"
                style="left:290px; top:550px;"> F5=SCRLF</button>

        <button type="submit"
                name="Command"
                value="PF6"
                data-command="PF6"
                class="pf-button"
                style="left:390px; top:550px;"> F6=RESET</button>

        <button type="submit"
                name="Command"
                value="PF12"
                data-command="PF12"
                class="pf-button"
                style="left:490px; top:550px;"> F12=MAIN</button>

        @*
            Legacy initial ENTER attribute = PSI, so it starts hidden.
            It becomes useful here after a remark has been selected.
        *@
        @if (Model.ShowEnterKey)
        {
            <button type="submit"
                    name="Command"
                    value="ENTER"
                    data-command="ENTER"
                    class="pf-button"
                    style="left:590px; top:550px;">ENTER=ACCEPT</button>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.OfflineMessage))
        {
            <div class="offline-message">@Model.OfflineMessage</div>
        }
    </div>
</form>

<script>
    (() => {
        const action = document.getElementById("Action");
        const remark = document.getElementById("WRemark");

        function upperCaseElement(element) {
            if (element && typeof element.value === "string") {
                element.value = element.value.toUpperCase();
            }
        }

        document.addEventListener("input", event => {
            const target = event.target;

            if (target instanceof HTMLInputElement) {
                if (target.id === "Action" ||
                    target.id === "WRemark" ||
                    target.id.startsWith("Selection_")) {
                    upperCaseElement(target);
                }
            }
        });

        document.addEventListener("keydown", event => {
            const map = {
                "F1": "PF1",
                "F3": "PF3",
                "F4": "PF4",
                "F5": "PF5",
                "F6": "PF6",
                "F12": "PF12"
            };

            const command = map[event.key];

            if (command) {
                event.preventDefault();

                const button =
                    document.querySelector(`[data-command="${command}"]`);

                if (button) {
                    button.click();
                }

                return;
            }

            if (event.key === "Enter" &&
                event.target instanceof HTMLInputElement) {

                event.preventDefault();

                const form = event.target.form;

                if (form) {
                    const hiddenSubmit =
                        form.querySelector(
                            'button[name="Command"][value="ENTER"]'
                        );

                    if (hiddenSubmit) {
                        hiddenSubmit.click();
                    }
                }
            }
        });

        if (@Model.IsEditMode.ToString().ToLowerInvariant()) {
            remark?.focus();
            remark?.select();
        }
        else {
            action?.focus();
        }
    })();
</script>
</body>
</html>



using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158802Model : PageModel
{
    private const int RowCount = 11;

    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public List<string> Selections { get; set; } =
        Enumerable.Repeat(string.Empty, RowCount).ToList();

    [BindProperty]
    public string WRemark { get; set; } = string.Empty;

    [BindProperty]
    public int? SelectedRowIndex { get; set; }

    [BindProperty]
    public string Command { get; set; } = string.Empty;

    public string DateText { get; private set; } = "00/00/0000";

    public string Wfa { get; private set; } = string.Empty;

    public string WfaTranslation { get; private set; } = string.Empty;

    public string UserId { get; private set; } = string.Empty;

    public string WorkFunctionalArea { get; private set; } = string.Empty;

    public string WorkRemarkType { get; private set; } = string.Empty;

    public string ErrorMessage { get; private set; } = string.Empty;

    public string OfflineMessage { get; private set; } = string.Empty;

    public List<StandardRemarkRow> Rows { get; private set; } = [];

    public bool IsEditMode =>
        SelectedRowIndex is >= 0 and < RowCount;

    /*
     * D158802 legacy ENTER field starts with PSI, meaning hidden.
     * We expose it once the screen enters the working-update state.
     *
     * This state transition is inferred from the wrapper/UI because
     * the main business COBOL has not been supplied.
     */
    public bool ShowEnterKey => IsEditMode;

    public async Task OnGetAsync(string? fa)
    {
        InitializeContext(fa);

        EnsureSelectionCount();

        await LoadScreenDataAsync();
    }

    public async Task<IActionResult> OnPostAsync(string? fa)
    {
        InitializeContext(fa);

        NormalizeInput();

        EnsureSelectionCount();

        /*
         * Always reload display-only values from the trusted server-side
         * source before processing posted selections.
         *
         * The actual repository/service call belongs here once the
         * D158802 business COBOL/data source is available.
         */
        await LoadScreenDataAsync();

        switch (Command)
        {
            case "PF1":
                /*
                 * TODO:
                 * Main COBOL is required to confirm exact help handling.
                 */
                ErrorMessage =
                    "D158802 HELP ROUTE HAS NOT YET BEEN WIRED.";
                return Page();

            case "PF3":
                /*
                 * PROVISIONAL:
                 * D158800 is the Standard Remark Maintenance menu that
                 * launches D158802.
                 */
                return RedirectToPage("/D158800", new
                {
                    fa = Wfa
                });

            case "PF4":
                /*
                 * TODO:
                 * Main COBOL required for exact SCRLB semantics.
                 */
                ErrorMessage =
                    "D158802 SCRLB BUSINESS LOGIC HAS NOT YET BEEN WIRED.";
                return Page();

            case "PF5":
                /*
                 * TODO:
                 * Main COBOL required for exact SCRLF semantics.
                 */
                ErrorMessage =
                    "D158802 SCRLF BUSINESS LOGIC HAS NOT YET BEEN WIRED.";
                return Page();

            case "PF6":
                ResetScreen();
                await LoadScreenDataAsync();
                return Page();

            case "PF12":
                /*
                 * PROVISIONAL:
                 * F12=MAIN follows the existing PCPM main-menu convention.
                 */
                return RedirectToPage("/D158000");

            case "ENTER":
            case "":
                return await ProcessEnterAsync();

            default:
                /*
                 * The wrapper establishes ACTION as X(3), uppercase,
                 * but does not contain authoritative Action business rules.
                 */
                ErrorMessage =
                    $"ACTION '{Action}' IS NOT YET WIRED FOR D158802.";
                return Page();
        }
    }

    private async Task<IActionResult> ProcessEnterAsync()
    {
        if (IsEditMode)
        {
            return await ProcessRemarkUpdateAsync();
        }

        var selectedIndexes = Selections
            .Select((value, index) => new
            {
                Value = Normalize(value, 1),
                Index = index
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Value))
            .ToList();

        if (selectedIndexes.Count == 0)
        {
            ErrorMessage =
                "ENTER 'U' IN ONE SELECTION FIELD.";
            return Page();
        }

        if (selectedIndexes.Count > 1)
        {
            ErrorMessage =
                "ONLY ONE STANDARD REMARK MAY BE SELECTED.";
            return Page();
        }

        var selected = selectedIndexes[0];

        if (selected.Value != "U")
        {
            ErrorMessage =
                "ENTER 'U' IN SEL TO UPDATE THE STANDARD REMARK.";
            return Page();
        }

        if (selected.Index < 0 ||
            selected.Index >= Rows.Count)
        {
            ErrorMessage =
                "INVALID STANDARD REMARK SELECTION.";
            return Page();
        }

        var row = Rows[selected.Index];

        SelectedRowIndex = selected.Index;

        WorkFunctionalArea = row.FunctionalArea;
        WorkRemarkType = row.RemarkType;
        WRemark = row.Remark;

        Selections =
            Enumerable.Repeat(string.Empty, RowCount).ToList();

        return Page();
    }

    private async Task<IActionResult> ProcessRemarkUpdateAsync()
    {
        if (SelectedRowIndex is not int index ||
            index < 0 ||
            index >= Rows.Count)
        {
            ResetWorkingRow();

            ErrorMessage =
                "STANDARD REMARK SELECTION IS NO LONGER VALID.";

            return Page();
        }

        WRemark = Normalize(WRemark, 50);

        if (string.IsNullOrWhiteSpace(WRemark))
        {
            ErrorMessage =
                "STANDARD REMARK MAY NOT BE BLANK.";

            RestoreWorkingRow(index);
            return Page();
        }

        var row = Rows[index];

        /*
         * IMPORTANT:
         * Do not report a successful database update until the
         * actual D158802 Application/Infrastructure implementation
         * is connected.
         */
        var updated = await UpdateStandardRemarkAsync(
            row.FunctionalArea,
            row.RemarkType,
            WRemark);

        if (!updated)
        {
            RestoreWorkingRow(index);

            ErrorMessage =
                "D158802 UPDATE SERVICE HAS NOT YET BEEN WIRED.";

            return Page();
        }

        ResetWorkingRow();

        await LoadScreenDataAsync();

        return Page();
    }

    private void RestoreWorkingRow(int index)
    {
        if (index < 0 || index >= Rows.Count)
        {
            return;
        }

        WorkFunctionalArea = Rows[index].FunctionalArea;
        WorkRemarkType = Rows[index].RemarkType;
    }

    private void ResetScreen()
    {
        Action = string.Empty;

        Selections =
            Enumerable.Repeat(string.Empty, RowCount).ToList();

        ResetWorkingRow();

        ErrorMessage = string.Empty;
    }

    private void ResetWorkingRow()
    {
        SelectedRowIndex = null;
        WorkFunctionalArea = string.Empty;
        WorkRemarkType = string.Empty;
        WRemark = string.Empty;
    }

    private void InitializeContext(string? fa)
    {
        /*
         * D158800 currently passes Functional Area into the standard
         * remark screens.
         *
         * Once the exact IPcpmSessionService API from D158000 is reused
         * here, replace this query-string fallback with the authoritative
         * session value.
         */
        Wfa = Normalize(fa, 2);

        UserId = GetLegacyUserId();

        DateText = DateTime.Today.ToString("MM/dd/yyyy");
    }

    private void NormalizeInput()
    {
        Action = Normalize(Action, 3);

        Command = Normalize(Command, 10);

        WRemark = Normalize(WRemark, 50);

        for (var i = 0; i < Selections.Count; i++)
        {
            Selections[i] = Normalize(
                Selections[i],
                1);
        }
    }

    private void EnsureSelectionCount()
    {
        Selections ??= [];

        while (Selections.Count < RowCount)
        {
            Selections.Add(string.Empty);
        }

        if (Selections.Count > RowCount)
        {
            Selections =
                Selections.Take(RowCount).ToList();
        }
    }

    private async Task LoadScreenDataAsync()
    {
        /*
         * TODO BUSINESS/DATA INTEGRATION
         *
         * The ASPX + wrapper prove that this screen displays
         * 11 rows containing:
         *
         *   FA       X(2)
         *   REMTYPE  X(3)
         *   STDREM   X(50)
         *
         * We do NOT yet have the main COBOL that identifies the
         * authoritative database view/table, sort order or filtering.
         *
         * Replace this method with an Application service/repository
         * call. SQL itself belongs in PCPM.Infrastructure.
         */

        await Task.CompletedTask;

        WfaTranslation ??= string.Empty;

        Rows = Enumerable.Range(0, RowCount)
            .Select(_ => new StandardRemarkRow())
            .ToList();

        /*
         * Example future shape:
         *
         * var result =
         *     await _standardRemarkService
         *         .GetUpdateRowsAsync(Wfa);
         *
         * WfaTranslation = result.FunctionalAreaDescription;
         * Rows = result.Rows
         *     .Take(RowCount)
         *     .Select(x => new StandardRemarkRow
         *     {
         *         FunctionalArea = x.FunctionalArea,
         *         RemarkType = FormatRemarkType(x.RemarkType),
         *         Remark = x.Remark
         *     })
         *     .ToList();
         */
    }

    private Task<bool> UpdateStandardRemarkAsync(
        string functionalArea,
        string remarkType,
        string remark)
    {
        /*
         * TODO BUSINESS/DATA INTEGRATION
         *
         * Do not invent the physical table or UPDATE statement.
         *
         * Main business COBOL is still required to establish:
         * - key fields
         * - authorization
         * - concurrency rules
         * - valid state transitions
         * - exact error messages
         * - physical DB update
         */

        return Task.FromResult(false);
    }

    private string GetLegacyUserId()
    {
        var name =
            User?.Identity?.Name ?? string.Empty;

        var slash =
            name.LastIndexOf('\\');

        if (slash >= 0 &&
            slash < name.Length - 1)
        {
            name = name[(slash + 1)..];
        }

        return Normalize(name, 7);
    }

    private static string Normalize(
        string? value,
        int maxLength)
    {
        var result =
            (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        if (result.Length > maxLength)
        {
            result = result[..maxLength];
        }

        return result;
    }

    public sealed class StandardRemarkRow
    {
        public string FunctionalArea { get; set; } = string.Empty;

        public string RemarkType { get; set; } = string.Empty;

        public string Remark { get; set; } = string.Empty;
    }
}
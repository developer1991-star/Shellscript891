using Microsoft.AspNetCore.Http;
using PCPM.Session;
using System.Globalization;
using System.Security.Cryptography;

namespace PCPM.Web.Session;

public class PcpmSessionService : IPcpmSessionService
{
    private readonly IHttpContextAccessor _httpContextAccessor;

    public PcpmSessionService(IHttpContextAccessor httpContextAccessor)
    {
        _httpContextAccessor = httpContextAccessor;
    }

    private ISession Session
    {
        get
        {
            var session = _httpContextAccessor.HttpContext?.Session;

            if (session == null)
            {
                throw new InvalidOperationException(
                    "HTTP session is not available.");
            }

            return session;
        }
    }

    // -------------------------------------------------
    // CREATE PCPM SESSION
    // -------------------------------------------------
    public string CreateSession(string userId)
    {
        Clear();

        var sessionId =
            RandomNumberGenerator
                .GetInt32(1, 1_000_000)
                .ToString(
                    "D6",
                    CultureInfo.InvariantCulture);

        Session.SetString(
            PcpmSessionKeys.SessionId,
            sessionId);

        Session.SetString(
            PcpmSessionKeys.UserId,
            userId);

        return sessionId;
    }

    // -------------------------------------------------
    // SESSION ID
    // -------------------------------------------------
    public string? GetSessionId()
    {
        return Session.GetString(
            PcpmSessionKeys.SessionId);
    }

    // -------------------------------------------------
    // USER ID
    // -------------------------------------------------
    public string? GetUserId()
    {
        return Session.GetString(
            PcpmSessionKeys.UserId);
    }

    // -------------------------------------------------
    // CURRENT SCREEN
    // -------------------------------------------------
    public void SetCurrentScreen(string screen)
    {
        Session.SetString(
            PcpmSessionKeys.CurrentScreen,
            screen);
    }

    public string? GetCurrentScreen()
    {
        return Session.GetString(
            PcpmSessionKeys.CurrentScreen);
    }

    // -------------------------------------------------
    // PREVIOUS SCREEN
    // -------------------------------------------------
    public void SetPreviousScreen(string screen)
    {
        Session.SetString(
            PcpmSessionKeys.PreviousScreen,
            screen);
    }

    public string? GetPreviousScreen()
    {
        return Session.GetString(
            PcpmSessionKeys.PreviousScreen);
    }

    // -------------------------------------------------
    // JOB NUMBER
    // -------------------------------------------------
    public void SetJobNumber(string jobNumber)
    {
        Session.SetString(
            PcpmSessionKeys.JobNumber,
            jobNumber);
    }

    public string? GetJobNumber()
    {
        return Session.GetString(
            PcpmSessionKeys.JobNumber);
    }

    // -------------------------------------------------
    // FUNCTIONAL AREA
    // -------------------------------------------------
    public void SetFunctionalArea(string functionalArea)
    {
        Session.SetString(
            PcpmSessionKeys.FunctionalArea,
            functionalArea);
    }

    public string? GetFunctionalArea()
    {
        return Session.GetString(
            PcpmSessionKeys.FunctionalArea);
    }

    // -------------------------------------------------
    // JOB SEQUENCE
    // -------------------------------------------------
    public void SetJobSequence(string jobSequence)
    {
        Session.SetString(
            PcpmSessionKeys.JobSequence,
            jobSequence);
    }

    public string? GetJobSequence()
    {
        return Session.GetString(
            PcpmSessionKeys.JobSequence);
    }

    // -------------------------------------------------
    // CLEAR SESSION
    // -------------------------------------------------
    public void Clear()
    {
        Session.Clear();
    }
}
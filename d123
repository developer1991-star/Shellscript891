<script>
    const pcpmForm = document.getElementById("pcpmForm");

    // Legacy PCPM behavior:
    // Pressing ENTER in any text field performs the normal POST.
    pcpmForm.addEventListener("keydown", function (event) {

        if (event.key === "Enter" &&
            event.target.matches('input[type="text"]')) {

            event.preventDefault();

            // Submit the form WITHOUT a named Razor handler.
            // This calls OnPostAsync().
            pcpmForm.requestSubmit();
        }
    });

    // Convert entered values to uppercase.
    document.addEventListener("input", function (event) {

        if (event.target.tagName === "INPUT" &&
            event.target.type === "text") {

            event.target.value =
                event.target.value.toUpperCase();
        }
    });

    // Preserve legacy function-key behavior.
    document.addEventListener("keydown", function (event) {

        if (event.key === "F1") {
            event.preventDefault();

            document.querySelector(
                'button[formaction*="Help"]'
            )?.click();
        }

        if (event.key === "F3") {
            event.preventDefault();

            document.querySelector(
                'button[formaction*="Previous"]'
            )?.click();
        }

        if (event.key === "F6") {
            event.preventDefault();

            document.querySelector(
                'button[formaction*="Reset"]'
            )?.click();
        }
    });
</script>
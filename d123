public async Task<D158500Result> LoadJobSummaryAsync(
    string jobNumber,
    CancellationToken cancellationToken = default)
{
    var jobRecord = await LoadJobRecordAsync(
        jobNumber,
        cancellationToken);

    if (jobRecord == null)
    {
        return D158500Result.Fail("NO RECORDS FOUND AT ALL");
    }

    var result = D158500Result.Ok(
        nextScreen: "D158500",
        jobNumber: jobRecord.JobNumber);

    result.Rows = new List<D158500StatusRow>();

    // Later we will populate:
    // result.Rows
    // result.Remark
    // result.LastUpdated

    return result;
}


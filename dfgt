public async Task<IReadOnlyList<FunctionalAreaRecord>>
    GetFunctionalAreasAsync(
        CancellationToken cancellationToken = default)
{
    const string sql = """
        SELECT
            FUNC_AREA,
            FUNC_AREA_DESC,
            SEQ
        FROM dbo.YOUR_FUNCTIONAL_AREA_TABLE_OR_VIEW
        ORDER BY SEQ ASC;
        """;

    await using var connection = CreateConnection();
    await connection.OpenAsync(cancellationToken);

    await using var command = connection.CreateCommand();
    command.CommandText = sql;

    await using var reader =
        await command.ExecuteReaderAsync(cancellationToken);

    var records = new List<FunctionalAreaRecord>();

    while (await reader.ReadAsync(cancellationToken))
    {
        records.Add(new FunctionalAreaRecord
        {
            FunctionalArea =
                Convert.ToString(reader["FUNC_AREA"])?.Trim()
                ?? string.Empty,

            Description =
                Convert.ToString(reader["FUNC_AREA_DESC"])?.Trim()
                ?? string.Empty,

            Sequence =
                reader["SEQ"] == DBNull.Value
                    ? 0
                    : Convert.ToInt32(reader["SEQ"])
        });
    }

    return records;
}





public async Task<IReadOnlyList<JobStatusRecord>>
    GetJobStatusesAsync(
        string jobNumber,
        CancellationToken cancellationToken = default)
{
    const string sql = """
        SELECT
            JOBNO,
            FUNC_AREA,
            FA_START_DATE,
            FA_PROJ_END,
            FA_END,
            FA_PERCENT,
            FA_STATUS
        FROM dbo.YOUR_JOB_STATUS_TABLE_OR_VIEW
        WHERE JOBNO = @JobNumber
          AND STATUS = '01'
          AND LTRIM(RTRIM(ISNULL(DELFLAG, ''))) = ''
        ORDER BY FUNC_AREA;
        """;

    await using var connection = CreateConnection();
    await connection.OpenAsync(cancellationToken);

    await using var command = connection.CreateCommand();
    command.CommandText = sql;

    command.Parameters.Add(
        "@JobNumber",
        SqlDbType.VarChar,
        10).Value = jobNumber.Trim();

    await using var reader =
        await command.ExecuteReaderAsync(cancellationToken);

    var records = new List<JobStatusRecord>();

    while (await reader.ReadAsync(cancellationToken))
    {
        records.Add(new JobStatusRecord
        {
            JobNumber =
                Convert.ToString(reader["JOBNO"])?.Trim()
                ?? string.Empty,

            FunctionalArea =
                Convert.ToString(reader["FUNC_AREA"])?.Trim()
                ?? string.Empty,

            StartDate =
                Convert.ToString(reader["FA_START_DATE"])?.Trim()
                ?? string.Empty,

            ProjectedEndDate =
                Convert.ToString(reader["FA_PROJ_END"])?.Trim()
                ?? string.Empty,

            EndDate =
                Convert.ToString(reader["FA_END"])?.Trim()
                ?? string.Empty,

            Percent =
                Convert.ToString(reader["FA_PERCENT"])?.Trim()
                ?? string.Empty,

            Status =
                Convert.ToString(reader["FA_STATUS"])?.Trim()
                ?? string.Empty
        });
    }

    return records;
}





private static void ApplyStatusRecord(
    D158500Screen screen,
    JobStatusRecord status)
{
    var index = GetFunctionalAreaIndex(status.FunctionalArea);

    if (index == 0)
    {
        // Legacy equivalent:
        // E00020 - INVALID FA ON STATUS RECORD
        screen.ErrorMessage = "INVALID FA ON STATUS RECORD";
        return;
    }

    // PC is special in the legacy D158500 program.
    if (index == 12)
    {
        screen.PcEnd = FormatMonthYear(status.EndDate);
        return;
    }

    // VE is also special.
    if (index == 13)
    {
        screen.VePercent =
            string.IsNullOrWhiteSpace(status.Percent)
                ? "N/A"
                : status.Percent.Trim();

        return;
    }

    var row = screen.Rows
        .FirstOrDefault(x =>
            string.Equals(
                x.FunctionalArea,
                status.FunctionalArea,
                StringComparison.OrdinalIgnoreCase));

    if (row == null)
        return;

    row.StartDate = FormatMonthYear(status.StartDate);
    row.ProjectedEndDate =
        FormatMonthYear(status.ProjectedEndDate);
    row.EndDate = FormatMonthYear(status.EndDate);

    row.Percent =
        string.IsNullOrWhiteSpace(status.Percent)
            ? "N/A"
            : status.Percent.Trim();

    row.Status = status.Status?.Trim() ?? "";
}



private static string FormatMonthYear(string? value)
{
    if (string.IsNullOrWhiteSpace(value))
        return "";

    value = value.Trim();

    if (DateTime.TryParse(value, out var date))
    {
        return date.ToString("MM/yyyy");
    }

    // Preserve legacy/database value when it cannot
    // safely be interpreted as a DateTime.
    return value;
}
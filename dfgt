using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;

namespace PCPM.Pages;

public class D158930Model : PageModel
{
    [BindProperty]
    public string Action { get; set; } = string.Empty;

    [BindProperty]
    public string JobNumber { get; set; } = string.Empty;

    [BindProperty]
    public string JobSequence { get; set; } = string.Empty;

    [BindProperty]
    public string RemarkSelection { get; set; } = string.Empty;

    public string DateText { get; set; } = string.Empty;

    public string ErrorMessage { get; set; } = string.Empty;

    public string OfflineMessage { get; set; } = string.Empty;

    public bool ShowSelectionCode { get; set; } = true;

    public bool ShowSelectionCodeDescription { get; set; } = true;

    public ProjectStatusView Data { get; set; } = new();

    public async Task OnGetAsync(
        string? jobNo = null,
        string? jobSeq = null)
    {
        DateText = DateTime.Today.ToString("MM/dd/yyyy");

        JobNumber = Normalize(jobNo, 10);
        JobSequence = Normalize(jobSeq, 2);

        await LoadProjectAsync();
    }

    public async Task<IActionResult> OnPostAsync(string? command)
    {
        Action = Normalize(Action, 3);
        JobNumber = Normalize(JobNumber, 10);
        JobSequence = Normalize(JobSequence, 2);
        RemarkSelection = Normalize(RemarkSelection, 1);

        /*
         * Reload all display-only values from a trusted service.
         * Do not trust hidden copies of the project information.
         */
        await LoadProjectAsync();

        switch (command?.ToUpperInvariant())
        {
            case "F6":
                Action = string.Empty;
                RemarkSelection = string.Empty;
                ErrorMessage = string.Empty;
                return Page();

            case "F12":
                return RedirectToPage("/D158000");

            case "F3":
                return PreviousOrMain();

            case "F1":
                ErrorMessage =
                    "TODO: wire D158930 help routing.";
                return Page();

            case "F4":
                ErrorMessage =
                    "TODO: implement D158930 SCRLB from main business COBOL.";
                return Page();

            case "F5":
                ErrorMessage =
                    "TODO: implement D158930 SCRLF from main business COBOL.";
                return Page();

            case "F7":
                ErrorMessage =
                    "TODO: implement D158930 BKWRD from main business COBOL.";
                return Page();

            case "F8":
                ErrorMessage =
                    "TODO: implement D158930 FRWRD from main business COBOL.";
                return Page();
        }

        if (!string.IsNullOrWhiteSpace(RemarkSelection))
        {
            if (RemarkSelection != "S")
            {
                ErrorMessage = "ENTER 'S' TO SEE REMARKS";
                return Page();
            }

            /*
             * TODO:
             * Main business COBOL must establish the exact destination for
             * REM-SEL='S'. Do not hard-code D158950/D158945/etc. here until
             * that routing is confirmed.
             */
        }

        return Page();
    }

    private async Task LoadProjectAsync()
    {
        /*
         * TODO:
         * Replace this method with an Application service.
         *
         * Example only:
         *
         * var result =
         *     await _projectStatusService.GetInquiryAsync(
         *         JobNumber,
         *         JobSequence,
         *         cancellationToken);
         *
         * Data = Map(result);
         *
         * IMPORTANT:
         * Do not create SQL in this PageModel.
         * Physical table/view access belongs in PCPM.Infrastructure.
         *
         * Formatting preserved by the legacy wrapper includes:
         *
         * LOG / LEN:
         *     ZZZ9.99
         *
         * individual funding:
         *     ZZZ,ZZZ,ZZ9
         *
         * funding totals:
         *     Z,ZZZ,ZZZ,ZZ9
         *
         * programmed amount:
         *     ZZ,ZZZ,ZZZ,ZZ9
         *
         * BIDAMT / FIN-CONST-AMT:
         *     Z,ZZZ,ZZZ,ZZZ,ZZ9
         *
         * JOBSEQ / TYPWRK / HIPWK:
         *     Z9
         */

        await Task.CompletedTask;
    }

    private IActionResult PreviousOrMain()
    {
        var referer = Request.Headers.Referer.ToString();

        if (Uri.TryCreate(referer, UriKind.Absolute, out var uri) &&
            string.Equals(
                uri.Authority,
                Request.Host.Value,
                StringComparison.OrdinalIgnoreCase))
        {
            return LocalRedirect(uri.PathAndQuery);
        }

        return RedirectToPage("/D158000");
    }

    private static string Normalize(string? value, int maxLength)
    {
        var result = (value ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        return result.Length <= maxLength
            ? result
            : result[..maxLength];
    }


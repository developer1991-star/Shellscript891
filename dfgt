                    MOVE ALL ZEROES TO FIN-CONST-AMT                                                                                                                                                    
                  ELSE                                                                                                                                                                                  
                    set FIN-CONST-AMT to type Convert::ToDecimal(I-FIN-CONST-AMT)                                                                                                                       
                  END-IF                                                                                                                                                                                
               catch ex                                                                                                                                                                                 
                  MOVE I-FIN-CONST-AMT TO FIN-CONST-AMT(1:)                                                                                                                                             
               end-try                                                                                                                                                                                  
           ELSE                                                                                                                                                                                         
               MOVE I-FIN-CONST-AMT TO FIN-CONST-AMT(1:).                                                                                                                                               
           MOVE I-PF1 TO PF1                                                                                                                                                                            
           MOVE I-PF3 TO PF3                                                                                                                                                                            
           MOVE I-PF4 TO PF4                                                                                                                                                                            
           MOVE I-PF5 TO PF5                                                                                                                                                                            
           MOVE I-PF6 TO PF6                                                                                                                                                                            
           MOVE I-PF7 TO PF7                                                                                                                                                                            
           MOVE I-PF8 TO PF8                                                                                                                                                                            
           MOVE I-PF12 TO PF12                                                                                                                                                                          
           MOVE I-ERR-MSG TO ERR-MSG                                                                                                                                                                    
           MOVE D158940-REC    TO PCIM-FILE-DATA.                                                                                                                                                       
       end method Input_To_Pcim_Data.                                                                                                                                                                   
                                                                                                                                                                                                        

#!/usr/bin/env python3

import base64
import json
from datetime import date, datetime
from pathlib import Path

from google.cloud import firestore
from google.cloud.firestore_v1.field_path import FieldPath


# ============================================================
# CONFIGURATION
# ============================================================

PROJECT_ID = "YOUR_PROJECT_ID"

COLLECTION_NAME = "Employees"

OUTPUT_FILE_NAME = "employees_export.json"

PAGE_SIZE = 5000


# ============================================================
# CONVERT FIRESTORE VALUES TO JSON
# ============================================================

def json_converter(value):

    # Firestore Timestamp / Python datetime
    if isinstance(value, (datetime, date)):
        return value.isoformat()

    # Firestore GeoPoint
    if hasattr(value, "latitude") and hasattr(value, "longitude"):
        return {
            "latitude": value.latitude,
            "longitude": value.longitude
        }

    # Firestore DocumentReference
    if hasattr(value, "path"):
        return value.path

    # Bytes
    if isinstance(value, bytes):
        return base64.b64encode(value).decode("utf-8")

    return str(value)


# ============================================================
# MAIN
# ============================================================

def main():

    output_path = (
        Path.home()
        / OUTPUT_FILE_NAME
    )

    db = firestore.Client(
        project=PROJECT_ID
    )

    employees = db.collection(
        COLLECTION_NAME
    )


    # --------------------------------------------------------
    # Get total document count for percentage
    # --------------------------------------------------------

    print()
    print("Export job is running...")
    print()

    count_result = employees.count(
        alias="total"
    ).get()

    total = count_result[0][0].value

    print(
        f"Total records: {total:,}"
    )

    print()


    exported = 0

    last_document = None

    first_record = True


    # --------------------------------------------------------
    # Create / replace JSON file
    # --------------------------------------------------------

    with open(
        output_path,
        "w",
        encoding="utf-8"
    ) as output_file:

        # Start JSON array
        output_file.write("[\n")


        while True:

            # ------------------------------------------------
            # Read next page ordered by Firestore document ID
            # ------------------------------------------------

            query = (
                employees
                .order_by(
                    FieldPath.document_id()
                )
                .limit(
                    PAGE_SIZE
                )
            )


            if last_document is not None:

                query = query.start_after(
                    last_document
                )


            documents = list(
                query.stream(
                    timeout=120
                )
            )


            # No more documents
            if not documents:
                break


            # ------------------------------------------------
            # Write each Firestore document directly to JSON
            # ------------------------------------------------

            for document in documents:

                data = document.to_dict()

                # Include Firestore document ID as well
                data["_firestoreDocumentId"] = (
                    document.id
                )


                if not first_record:
                    output_file.write(",\n")

                json.dump(
                    data,
                    output_file,
                    default=json_converter,
                    ensure_ascii=False,
                    separators=(",", ":")
                )

                first_record = False

                exported += 1


            # ------------------------------------------------
            # Save last document for next page
            # ------------------------------------------------

            last_document = (
                documents[-1]
            )


            # Write data to disk after each page
            output_file.flush()


            # ------------------------------------------------
            # Progress
            # ------------------------------------------------

            percentage = (
                exported / total
            ) * 100 if total else 100


            print(
                f"\rProgress: "
                f"{percentage:6.2f}% "
                f"({exported:,}/{total:,})",
                end="",
                flush=True
            )


        # Close JSON array
        output_file.write("\n]\n")


    print()
    print()
    print("=" * 60)
    print("EXPORT COMPLETE")
    print("=" * 60)

    print(
        f"Records exported : "
        f"{exported:,}"
    )

    print(
        f"JSON file        : "
        f"{output_path}"
    )

    print("=" * 60)


# ============================================================
# START
# ============================================================

if __name__ == "__main__":
    main()
public async Task<RemarkRecord?> GetLatestRemarkAsync(
    string jobNumber,
    CancellationToken cancellationToken = default)
{
    const string sql = """
        SELECT TOP (1)
            [REMARK],
            [LAST-UPDATED],
            [REMSEQ]
        FROM [V158-RMK104R0]
        WHERE ISNULL([DELFLAG], '') = ''
          AND [HIST-FLAG] = 'N'
          AND [JOBNO] = @JobNumber
        ORDER BY
            [LAST-UPDATED] DESC,
            [REMSEQ] DESC;
        """;

    await using var connection =
        new SqlConnection(_connectionString);

    await connection.OpenAsync(cancellationToken);

    await using var command =
        new SqlCommand(sql, connection);

    command.Parameters.Add(
        "@JobNumber",
        SqlDbType.VarChar,
        10).Value = jobNumber.Trim();

    await using var reader =
        await command.ExecuteReaderAsync(cancellationToken);

    if (!await reader.ReadAsync(cancellationToken))
    {
        return null;
    }

    var remark = new RemarkRecord
    {
        Remark = GetString(reader, "REMARK"),
        RemarkSequence = GetString(reader, "REMSEQ"),
        LastUpdated = FormatLegacyDate(
            reader["LAST-UPDATED"])
    };

    return remark;
}


private static string GetString(
    SqlDataReader reader,
    string columnName)
{
    var value = reader[columnName];

    if (value == DBNull.Value)
    {
        return string.Empty;
    }

    return Convert.ToString(value)?.Trim() ?? string.Empty;
}

private static string FormatLegacyDate(object value)
{
    if (value == DBNull.Value || value is null)
    {
        return string.Empty;
    }

    if (value is DateTime dateTime)
    {
        return dateTime.ToString("MM/dd/yyyy");
    }

    if (value is DateOnly dateOnly)
    {
        return dateOnly.ToString("MM/dd/yyyy");
    }

    var text = Convert.ToString(value)?.Trim();

    if (string.IsNullOrWhiteSpace(text))
    {
        return string.Empty;
    }

    if (DateTime.TryParse(text, out var parsedDate))
    {
        return parsedDate.ToString("MM/dd/yyyy");
    }

    // Preserve the original value if this DB column
    // uses a legacy/non-standard date representation.
    return text;
}



public async Task<string?> GetMessageAsync(
    string messageId,
    CancellationToken cancellationToken = default)
{
    const string sql = """
        SELECT TOP (1)
            [MESSAGE-TEXT]
        FROM [V158-MSG104R0]
        WHERE [MESSAGE-KEY] = @MessageId
        ORDER BY [MESSAGE-KEY];
        """;

    await using var connection =
        new SqlConnection(_connectionString);

    await connection.OpenAsync(cancellationToken);

    await using var command =
        new SqlCommand(sql, connection);

    command.Parameters.Add(
        "@MessageId",
        SqlDbType.VarChar,
        10).Value = messageId.Trim();

    var result =
        await command.ExecuteScalarAsync(cancellationToken);

    if (result is null || result == DBNull.Value)
    {
        // This matches the fallback behavior seen
        // in the legacy D158500 COBOL.
        return "APPLICATION ERROR / CALL COMPUTER SERVICES";
    }

    return Convert.ToString(result)?.Trim();
}


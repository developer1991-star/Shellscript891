- bash: |
    set -euo pipefail

    TAGS_URL="$(System.CollectionUri)$(System.TeamProject)/_apis/build/builds/$(Build.BuildId)/tags?api-version=7.1"

    echo "Reading build tags for build $(Build.BuildId)..."

    RESPONSE="$(curl --silent --show-error --fail \
      --header "Authorization: Bearer ${SYSTEM_ACCESSTOKEN}" \
      "${TAGS_URL}")"

    printf '%s' "${RESPONSE}" | python3 -c '
    import json
    import sys

    response = json.load(sys.stdin)

    if isinstance(response, list):
        tags = response
    elif isinstance(response, dict):
        tags = response.get("value", [])
    else:
        tags = []

    print("Available build tags:")

    if not tags:
        print("  No build tags returned.")
    else:
        for index, tag in enumerate(tags, start=1):
            print(f"  {index}. {tag}")
    '

    echo "##vso[task.logissue type=warning]Build tags were printed for investigation. Deployment will be skipped for this run."
    echo "##vso[task.setvariable variable=EnterpriseImageTag]"
    echo "##vso[task.setvariable variable=SkipDeployment]true"
  displayName: Print enterprise build tags
  env:
    SYSTEM_ACCESSTOKEN: $(System.AccessToken)
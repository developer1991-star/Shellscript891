- bash: |
    set -euo pipefail

    TAGS_URL="$(System.CollectionUri)$(System.TeamProject)/_apis/build/builds/$(Build.BuildId)/tags?api-version=7.1"

    echo "Reading build tags for build $(Build.BuildId)..."

    RESPONSE="$(curl --silent --show-error --fail \
      --header "Authorization: Bearer ${SYSTEM_ACCESSTOKEN}" \
      "${TAGS_URL}")"

    ENTERPRISE_IMAGE_TAG="$(printf '%s' "${RESPONSE}" | python3 -c '
    import json
    import sys

    response = json.load(sys.stdin)

    if isinstance(response, list):
        tags = response
    elif isinstance(response, dict):
        tags = response.get("value", [])
    else:
        tags = []

    values = {}

    for tag in tags:
        if not isinstance(tag, str):
            continue

        key, separator, value = tag.partition("=")

        if separator:
            values[key.strip().lower()] = value.strip()

    version = values.get("version", "")
    short_commit_id = values.get("short_commit_id", "")

    if version and short_commit_id:
        print(f"{version}-{short_commit_id}")
    ')"

    if [ -z "${ENTERPRISE_IMAGE_TAG}" ]; then
      echo "##vso[task.logissue type=warning]The version or short_commit_id build tag was not found. Deployment will be skipped."
      echo "##vso[task.setvariable variable=EnterpriseImageTag]"
      echo "##vso[task.setvariable variable=SkipDeployment]true"
      exit 0
    fi

    echo "Enterprise image tag: ${ENTERPRISE_IMAGE_TAG}"
    echo "##vso[task.setvariable variable=EnterpriseImageTag]${ENTERPRISE_IMAGE_TAG}"
    echo "##vso[task.setvariable variable=SkipDeployment]false"
  displayName: Resolve enterprise image tag
  env:
    SYSTEM_ACCESSTOKEN: $(System.AccessToken)
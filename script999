- stage: Deploy_UAT
  displayName: Deploy IDH to UAT
  dependsOn: Deploy_Dev
  condition: succeeded('Deploy_Dev')

  variables:
    # UAT Google Cloud configuration
    GcpProject: gcp-emp-ep-uat
    GcpRegion: us-central1

    # Service account used by the pipeline to authenticate to UAT
    GcpDeploymentServiceAccount: >-
      emp-ep-cicd-img-transf@gcp-emp-ep-uat.iam.gserviceaccount.com

    # Source image in Lucius/JFrog.
    # Do not include the image tag here.
    SourceImage: >-
      lucius.ups.com/upsers-docker-dev-virtual/ent-upsers-etl-idhextract

    # UAT Google Artifact Registry.
    # Do not include the image tag here.
    UatRegistryHost: us-central1-docker.pkg.dev
    TargetImage: >-
      us-central1-docker.pkg.dev/gcp-emp-ep-uat/seas-artifact-registry/upsers-cloudrun-etl-idh

    # Existing UAT Cloud Run service
    CloudRunService: upsers-cloudrun-etl-idh-uat

  jobs:
    - deployment: DeployCloudRunUAT
      displayName: Transfer image and deploy IDH to UAT
      environment: upsers-idh-uat

      pool:
        name: EPE_AgentPool
        demands:
          - dynamic_agent_9
          - agent_env -equals prod

      strategy:
        runOnce:
          deploy:
            steps:
              - checkout: none

              # Replace this secure-file value with the exact name
              # configured in Azure DevOps Library > Secure files.
              - task: DownloadSecureFile@1
                name: gcpUatKey
                displayName: Download UAT GCP authentication file
                inputs:
                  secureFile: gcp-emp-ep-uat-cicd-key.json

              # Use the same Lucius secure file used by the Dev deployment.
              - task: DownloadSecureFile@1
                name: luciusConfigUat
                displayName: Download Lucius authentication file
                inputs:
                  secureFile: lucius-auth.json

              - bash: |
                  set -euo pipefail

                  echo "Authenticating deployment service account:"
                  echo "$(GcpDeploymentServiceAccount)"

                  gcloud auth activate-service-account \
                    "$(GcpDeploymentServiceAccount)" \
                    --key-file="$(gcpUatKey.secureFilePath)"

                  gcloud config set project "$(GcpProject)"
                displayName: Authenticate to UAT Google Cloud

              - bash: |
                  set -euo pipefail

                  gcloud auth configure-docker \
                    "$(UatRegistryHost)" \
                    --quiet
                displayName: Configure UAT Artifact Registry authentication

              - bash: |
                  set -euo pipefail

                  IMAGE_TAG="$(EnterpriseImageTag)"

                  if [ -z "${IMAGE_TAG}" ]; then
                    echo "##vso[task.logissue type=warning]No enterprise image tag was available. UAT deployment will be skipped."
                    echo "##vso[task.setvariable variable=SkipUatDeployment]true"
                    exit 0
                  fi

                  SOURCE="$(SourceImage):${IMAGE_TAG}"
                  TARGET="$(TargetImage):${IMAGE_TAG}"

                  echo "UAT image tag: ${IMAGE_TAG}"
                  echo "Lucius source: ${SOURCE}"
                  echo "UAT GAR target: ${TARGET}"

                  LUCIUS_AUTH_FILE="$(Agent.TempDirectory)/lucius-auth-uat.json"

                  cp "$(luciusConfigUat.secureFilePath)" \
                    "${LUCIUS_AUTH_FILE}"

                  chmod 600 "${LUCIUS_AUTH_FILE}"

                  echo "Validating Lucius credentials..."

                  podman login \
                    --authfile "${LUCIUS_AUTH_FILE}" \
                    --get-login \
                    lucius.ups.com

                  echo "Pulling image from Lucius..."

                  podman pull \
                    --authfile "${LUCIUS_AUTH_FILE}" \
                    "${SOURCE}"

                  echo "Tagging image for UAT Artifact Registry..."

                  podman tag \
                    "${SOURCE}" \
                    "${TARGET}"

                  echo "Pushing image to UAT Artifact Registry..."

                  podman push "${TARGET}"

                  echo "##vso[task.setvariable variable=UatDeployedImage]${TARGET}"
                  echo "##vso[task.setvariable variable=SkipUatDeployment]false"
                displayName: Transfer image from Lucius to UAT GAR

              - bash: |
                  set -euo pipefail

                  echo "Deploying UAT image:"
                  echo "$(UatDeployedImage)"

                  gcloud run deploy "$(CloudRunService)" \
                    --project="$(GcpProject)" \
                    --region="$(GcpRegion)" \
                    --image="$(UatDeployedImage)" \
                    --platform=managed \
                    --no-traffic \
                    --tag=candidate \
                    --quiet
                displayName: Deploy UAT candidate Cloud Run revision
                condition: and(
                  succeeded(),
                  ne(variables['SkipUatDeployment'], 'true')
                )

              - bash: |
                  set -euo pipefail

                  READY_REVISION="$(
                    gcloud run services describe "$(CloudRunService)" \
                      --project="$(GcpProject)" \
                      --region="$(GcpRegion)" \
                      --format="value(status.latestReadyRevisionName)"
                  )"

                  if [ -z "${READY_REVISION}" ]; then
                    echo "##vso[task.logissue type=error]No ready UAT Cloud Run revision was found."
                    exit 1
                  fi

                  echo "UAT candidate revision is ready: ${READY_REVISION}"
                displayName: Verify UAT candidate revision
                condition: and(
                  succeeded(),
                  ne(variables['SkipUatDeployment'], 'true')
                )

              - bash: |
                  echo "UAT deployment was skipped because no valid enterprise image tag was available."
                displayName: UAT deployment skipped
                condition: eq(
                  variables['SkipUatDeployment'],
                  'true'
                )
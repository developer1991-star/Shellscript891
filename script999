@Configuration
public class SwaggerConfig {

    @Bean
    public OpenAPI seasOpenAPI() {
        return new OpenAPI()
                .info(new Info()
                        .title("Seas API")
                        .description("Seas API reference for UPS")
                        .version("1.0")
                        .contact(new Contact()
                                .name("UPSers")
                                .email("3377468@ups.com")
                                .url("https://upsers.com/")));
    }
}
- bash: |
    set -euo pipefail

    READY_REVISION="$(
      gcloud run services describe "$(CloudRunService)" \
        --project="$(GcpProject)" \
        --region="$(GcpRegion)" \
        --format='value(status.latestReadyRevisionName)'
    )"

    echo "Promoting revision: ${READY_REVISION}"

    gcloud run services update-traffic "$(CloudRunService)" \
      --project="$(GcpProject)" \
      --region="$(GcpRegion)" \
      --to-revisions="${READY_REVISION}=100" \
      --quiet

    echo "Traffic successfully moved to ${READY_REVISION}"
  displayName: Promote DEV revision to 100% traffic
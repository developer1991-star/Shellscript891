 stages:
  - stage: Prepare
    displayName: Generate image tag

    jobs:
      - job: GenerateImageTag
        displayName: Generate application image tag

        steps:
          - checkout: self

          - bash: |
              set -euo pipefail

              APP_VERSION="$(tr -d '\r\n ' < VERSION.txt)"
              COMMIT_ID="${BUILD_SOURCEVERSION:0:9}"
              IMAGE_TAG="${APP_VERSION}-${COMMIT_ID}"

              echo "App version: ${APP_VERSION}"
              echo "Commit ID: ${COMMIT_ID}"
              echo "Image tag: ${IMAGE_TAG}"

              echo "##vso[task.setvariable variable=ImageTag;isOutput=true]${IMAGE_TAG}"
            name: SetImageTag
            displayName: Create image tag
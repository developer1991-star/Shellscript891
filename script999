stages:
  - stage: Deploy_Dev
    displayName: Deploy UPSers API to Dev

    variables:
      GcpProject: gcp-emp-ep-dev
      GcpRegion: us-east4

      GcpDeploymentServiceAccount: >-
        emp-ep-cicd-img-transf@gcp-emp-ep-dev.iam.gserviceaccount.com

      SourceImage: >-
        lucius.ups.com/upsers-docker-dev-virtual/ent-upsers-api

      TargetImage: >-
        us-east4-docker.pkg.dev/gcp-emp-ep-dev/seas-artifact-registry/upsers-cloudrun-api

      CloudRunService: upsers-cloudrun-api-dev

    jobs:
      - deployment: DeployCloudRunDev
        displayName: Transfer image and deploy UPSers API to Dev

        environment: upsers-api-dev

        pool:
          name: EPE_AgentPool
          demands:
            - dynamic_agent_9
            - agent_env -equals prod

        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: none

                # ---------------------------------------------------------
                # Resolve exact image tag produced by Enterprise CI
                # ---------------------------------------------------------
                - bash: |
                    set -euo pipefail

                    TAGS_URL="$(System.CollectionUri)$(System.TeamProject)/_apis/build/builds/$(Build.BuildId)/tags?api-version=7.1"

                    echo "Reading build tags for build $(Build.BuildId)..."

                    RESPONSE="$(curl --silent --show-error --fail \
                      --header "Authorization: Bearer ${SYSTEM_ACCESSTOKEN}" \
                      "${TAGS_URL}")"

                    ENTERPRISE_IMAGE_TAG="$(printf '%s' "${RESPONSE}" | python3 -c '
                    import json
                    import sys

                    response = json.load(sys.stdin)

                    if isinstance(response, list):
                        tags = response
                    elif isinstance(response, dict):
                        tags = response.get("value", [])
                    else:
                        tags = []

                    values = {}

                    for tag in tags:
                        if not isinstance(tag, str):
                            continue

                        key, separator, value = tag.partition("=")

                        if separator:
                            values[key.strip().lower()] = value.strip()

                    version = values.get("version", "")
                    short_commit_id = values.get("short_commit_id", "")

                    if version and short_commit_id:
                        print(f"{version}-{short_commit_id}")
                    ')"

                    if [ -z "${ENTERPRISE_IMAGE_TAG}" ]; then
                      echo "##vso[task.logissue type=error]Could not determine enterprise image tag."
                      exit 1
                    fi

                    echo "Enterprise image tag: ${ENTERPRISE_IMAGE_TAG}"

                    echo "##vso[task.setvariable variable=EnterpriseImageTag]${ENTERPRISE_IMAGE_TAG}"

                  displayName: Resolve enterprise image tag
                  env:
                    SYSTEM_ACCESSTOKEN: $(System.AccessToken)


                # ---------------------------------------------------------
                # Validate image tag
                # ---------------------------------------------------------
                - bash: |
                    set -euo pipefail

                    IMAGE_TAG="$(EnterpriseImageTag)"

                    if [ -z "${IMAGE_TAG}" ]; then
                      echo "##vso[task.logissue type=error]Enterprise image tag is empty."
                      exit 1
                    fi

                    echo "Using image tag: ${IMAGE_TAG}"

                  displayName: Validate image tag


                # ---------------------------------------------------------
                # GCP authentication
                # ---------------------------------------------------------
                - task: DownloadSecureFile@1
                  name: gcpKey
                  displayName: Download GCP authentication file
                  inputs:
                    secureFile: gcp-emp-ep-dev-cd-key.json


                # ---------------------------------------------------------
                # Lucius/JFrog authentication
                # ---------------------------------------------------------
                - task: DownloadSecureFile@1
                  name: luciusConfig
                  displayName: Download Lucius authentication file
                  inputs:
                    secureFile: lucius-config.json


                # ---------------------------------------------------------
                # Authenticate to GCP
                # ---------------------------------------------------------
                - bash: |
                    set -euo pipefail

                    echo "Authenticating GCP deployment service account..."

                    gcloud auth activate-service-account \
                      "$(GcpDeploymentServiceAccount)" \
                      --key-file="$(gcpKey.secureFilePath)" \
                      --project="$(GcpProject)"

                    gcloud config set project "$(GcpProject)"

                    echo "Authenticated GCP account:"
                    gcloud auth list \
                      --filter=status:ACTIVE \
                      --format="value(account)"

                  displayName: Authenticate to Google Cloud


                # ---------------------------------------------------------
                # Configure GAR authentication
                # ---------------------------------------------------------
                - bash: |
                    set -euo pipefail

                    gcloud auth configure-docker \
                      us-east4-docker.pkg.dev \
                      --quiet

                  displayName: Configure Google Artifact Registry authentication


                # ---------------------------------------------------------
                # Transfer exact CI image from Lucius to GAR
                # ---------------------------------------------------------
                - bash: |
                    set -euo pipefail

                    IMAGE_TAG="$(EnterpriseImageTag)"

                    SOURCE="$(SourceImage):${IMAGE_TAG}"
                    TARGET="$(TargetImage):${IMAGE_TAG}"

                    LUCIUS_AUTH_FILE="$(Agent.TempDirectory)/lucius-auth.json"

                    cp "$(luciusConfig.secureFilePath)" "${LUCIUS_AUTH_FILE}"
                    chmod 600 "${LUCIUS_AUTH_FILE}"

                    echo "Validating Lucius credentials..."

                    podman login \
                      --authfile "${LUCIUS_AUTH_FILE}" \
                      --get-login \
                      lucius.ups.com

                    echo "Pulling source image:"
                    echo "${SOURCE}"

                    podman pull \
                      --authfile "${LUCIUS_AUTH_FILE}" \
                      "${SOURCE}"

                    echo "Tagging image for Google Artifact Registry..."

                    podman tag \
                      "${SOURCE}" \
                      "${TARGET}"

                    echo "Pushing image to Google Artifact Registry..."

                    podman push "${TARGET}"

                    echo "Transferred image:"
                    echo "${TARGET}"

                    echo "##vso[task.setvariable variable=DeployedImage]${TARGET}"

                  displayName: Transfer image from Lucius to Dev GAR


                # ---------------------------------------------------------
                # Deploy candidate revision to existing Cloud Run service
                # ---------------------------------------------------------
                - bash: |
                    set -euo pipefail

                    echo "Deploying image:"
                    echo "$(DeployedImage)"

                    gcloud run deploy "$(CloudRunService)" \
                      --project="$(GcpProject)" \
                      --region="$(GcpRegion)" \
                      --image="$(DeployedImage)" \
                      --platform=managed \
                      --no-traffic \
                      --tag=candidate \
                      --quiet

                  displayName: Deploy candidate Cloud Run revision


                # ---------------------------------------------------------
                # Verify newly-created revision became ready
                # ---------------------------------------------------------
                - bash: |
                    set -euo pipefail

                    gcloud run services describe "$(CloudRunService)" \
                      --project="$(GcpProject)" \
                      --region="$(GcpRegion)" \
                      --format="table(
                        metadata.name,
                        status.latestCreatedRevisionName,
                        status.latestReadyRevisionName,
                        status.url
                      )"

                    CREATED_REVISION="$(
                      gcloud run services describe "$(CloudRunService)" \
                        --project="$(GcpProject)" \
                        --region="$(GcpRegion)" \
                        --format='value(status.latestCreatedRevisionName)'
                    )"

                    READY_REVISION="$(
                      gcloud run services describe "$(CloudRunService)" \
                        --project="$(GcpProject)" \
                        --region="$(GcpRegion)" \
                        --format='value(status.latestReadyRevisionName)'
                    )"

                    echo "Created revision: ${CREATED_REVISION}"
                    echo "Ready revision:   ${READY_REVISION}"

                    if [ "${CREATED_REVISION}" != "${READY_REVISION}" ]; then
                      echo "##vso[task.logissue type=error]New Cloud Run revision did not become ready."
                      exit 1
                    fi

                    echo "API candidate revision is ready: ${READY_REVISION}"

                  displayName: Verify API candidate revision
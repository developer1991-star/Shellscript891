COPY requirements.txt /app/requirements.txt

RUN --mount=type=secret,id=jfrog_token,target=/run/secrets/jfrog-config \
    bash -c ' \
      AUTH=$(python -c "import json; print(json.load(open(\"/run/secrets/jfrog-config\"))[\"auths\"][\"lucius.ups.com\"][\"auth\"])"); \
      CREDS=$(printf "%s" "$AUTH" | base64 --decode); \
      JFROG_USER=${CREDS%%:*}; \
      JFROG_TOKEN=${CREDS#*:}; \
      python -m pip install \
        --no-cache-dir \
        --index-url "https://${JFROG_USER}:${JFROG_TOKEN}@lucius.ups.com/artifactory/api/pypi/upsers-pypi-prod-virtual/simple" \
        --trusted-host lucius.ups.com \
        -r /app/requirements.txt \
    '

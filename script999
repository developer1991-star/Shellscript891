trigger: none
pr: none

parameters:
  - name: imageTag
    displayName: Lucius image tag to deploy
    type: string
    default: ""

variables:
  - group: upsers-pipeline-library

  - name: GcpProject
    value: gcp-emp-ep-dev

  - name: GcpRegion
    value: us-east4

  - name: GcpDeploymentServiceAccount
    value: emp-ep-cicd-img-transf@gcp-emp-ep-dev.iam.gserviceaccount.com

  - name: SourceImage
    value: lucius.ups.com/upsers-docker-dev-virtual/ent-upsers-etl-idhextract

  - name: TargetImage
    value: us-east4-docker.pkg.dev/gcp-emp-ep-dev/seas-artifact-registry/upsers-cloudrun-etl-idh

  - name: CloudRunService
    value: upsers-cloudrun-etl-idh-dev

stages:
  - stage: Deploy_Dev
    displayName: Deploy IDH to Dev

    jobs:
      - deployment: DeployCloudRunDev
        displayName: Transfer image and deploy Cloud Run
        environment: upsers-idh-dev

        pool:
          name: EPE_AgentPool
          demands:
            - dynamic_agent_9
            - agent_env -equals prod

        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: none

                - bash: |
                    set -euo pipefail

                    if [ -z "${{ parameters.imageTag }}" ]; then
                      echo "##vso[task.logissue type=error]The imageTag parameter is required."
                      exit 1
                    fi

                    echo "Image tag: ${{ parameters.imageTag }}"
                  displayName: Validate image tag

                - task: DownloadSecureFile@1
                  name: gcpKey
                  displayName: Download GCP Dev service-account key
                  inputs:
                    secureFile: gcp-emp-ep-dev-cd-key.json

                - bash: |
                    set -euo pipefail

                    gcloud auth activate-service-account \
                      "$(GcpDeploymentServiceAccount)" \
                      --key-file="$(gcpKey.secureFilePath)" \
                      --project="$(GcpProject)"

                    gcloud config set project "$(GcpProject)"

                    echo "Authenticated GCP account:"
                    gcloud auth list \
                      --filter=status:ACTIVE \
                      --format="value(account)"
                  displayName: Authenticate to Google Cloud

                - bash: |
                    set -euo pipefail

                    gcloud auth configure-docker \
                      us-east4-docker.pkg.dev \
                      --quiet
                  displayName: Configure Google Artifact Registry authentication

                # Replace this step with the same Lucius login template
                # used by the successful CI image pipeline.
                - bash: |
                    set -euo pipefail

                    echo "Lucius authentication must be performed here."
                    echo "Use the same Enterprise Pipeline registry-login template as CI."
                    exit 1
                  displayName: Authenticate to Lucius

                - bash: |
                    set -euo pipefail

                    SOURCE="$(SourceImage):${{ parameters.imageTag }}"
                    TARGET="$(TargetImage):${{ parameters.imageTag }}"

                    echo "Pulling source image:"
                    echo "${SOURCE}"

                    podman pull "${SOURCE}"
                    podman tag "${SOURCE}" "${TARGET}"
                    podman push "${TARGET}"

                    echo "##vso[task.setvariable variable=DeployedImage]${TARGET}"
                  displayName: Transfer image from Lucius to GAR

                - bash: |
                    set -euo pipefail

                    echo "Deploying image:"
                    echo "$(DeployedImage)"

                    gcloud run deploy "$(CloudRunService)" \
                      --project="$(GcpProject)" \
                      --region="$(GcpRegion)" \
                      --image="$(DeployedImage)" \
                      --platform=managed \
                      --no-traffic \
                      --tag=candidate \
                      --quiet
                  displayName: Deploy candidate Cloud Run revision

                - bash: |
                    set -euo pipefail

                    gcloud run services describe "$(CloudRunService)" \
                      --project="$(GcpProject)" \
                      --region="$(GcpRegion)" \
                      --format="table(
                        metadata.name,
                        status.latestCreatedRevisionName,
                        status.latestReadyRevisionName,
                        status.url
                      )"

                    CREATED_REVISION="$(
                      gcloud run services describe "$(CloudRunService)" \
                        --project="$(GcpProject)" \
                        --region="$(GcpRegion)" \
                        --format='value(status.latestCreatedRevisionName)'
                    )"

                    READY_REVISION="$(
                      gcloud run services describe "$(CloudRunService)" \
                        --project="$(GcpProject)" \
                        --region="$(GcpRegion)" \
                        --format='value(status.latestReadyRevisionName)'
                    )"

                    if [ "${CREATED_REVISION}" != "${READY_REVISION}" ]; then
                      echo "##vso[task.logissue type=error]The new Cloud Run revision did not become ready."
                      exit 1
                    fi

                    echo "Candidate revision is ready: ${READY_REVISION}"
                  displayName: Verify candidate revision


RUN --mount=type=secret,id=jfrog_token,target=/run/secrets/jfrog-config \
    python -c 'import base64,json,urllib.parse; c=json.load(open("/run/secrets/jfrog-config")); a=c["auths"]; e=(a.get("lucius.ups.com") or a.get("https://lucius.ups.com"))["auth"]; u,t=base64.b64decode(e).decode().split(":",1); url="https://{}:{}@lucius.ups.com/artifactory/api/pypi/upsers-pypi-prod-virtual/simple".format(urllib.parse.quote(u,safe=""),urllib.parse.quote(t,safe="")); open("/tmp/pip.conf","w").write("[global]\nindex-url = "+url+"\ntrusted-host = lucius.ups.com\n")' && \
    PIP_CONFIG_FILE=/tmp/pip.conf python -m pip install \
        --no-cache-dir \
        -r /app/requirements.txt && \
    rm -f /tmp/pip.conf
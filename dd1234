using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PCPM.Application.D158302;

namespace PCPM.Pages;

public sealed class D158302Model : PageModel
{
    private readonly ID158302Service _d158302Service;

    public D158302Model(
        ID158302Service d158302Service)
    {
        _d158302Service = d158302Service;
    }

    // ============================================================
    // POSTED / EDITABLE VALUES
    // ============================================================

    [BindProperty]
    public string Action { get; set; } = "";

    [BindProperty]
    public string JobNumber { get; set; } = "";

    [BindProperty]
    public string FunctionalArea { get; set; } = "";

    [BindProperty]
    public string History { get; set; } = "N";

    [BindProperty]
    public List<string> Selections { get; set; } =
        CreateBlankSelections();

    [BindProperty]
    public string LatestSelection { get; set; } = "";


    // ============================================================
    // SCREEN
    // ============================================================

    public D158302Screen Screen { get; private set; } = new();

    public string DisplayDate =>
        DateTime.Now.ToString("MM/dd/yyyy");

    public string ErrorMessage =>
        Screen.ErrorMessage ?? "";


    // ============================================================
    // GET
    // ============================================================

    public async Task<IActionResult> OnGetAsync(
        string? jobNumber,
        string? fa,
        CancellationToken cancellationToken)
    {
        Action = "";

        JobNumber =
            Normalize(jobNumber);

        FunctionalArea =
            Normalize(fa);

        History = "N";

        EnsureSelections();

        Screen = await _d158302Service.LoadAsync(
            JobNumber,
            FunctionalArea,
            History,
            cancellationToken);

        ApplyScreenToPage();

        return Page();
    }


    // ============================================================
    // ENTER
    // ============================================================

    public async Task<IActionResult> OnPostAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        EnsureSelections();

        var input = BuildInput();

        Screen =
            await _d158302Service.ProcessEnterAsync(
                input,
                cancellationToken);

        ApplyScreenToPage();

        ModelState.Clear();

        return Page();
    }


    // ============================================================
    // F1 - HELP
    // ============================================================

    public IActionResult OnPostHelp()
    {
        return RedirectToPage(
            "/D158999",
            new
            {
                screen = "302"
            });
    }


    // ============================================================
    // F3 - PREVIOUS
    // ============================================================

    public IActionResult OnPostPrevious()
    {
        /*
         * Screen 302 is normally entered from Screen 500.
         * Preserve the current job number when going back.
         */

        return RedirectToPage(
            "/D158500",
            new
            {
                jobNumber = Normalize(JobNumber)
            });
    }


    // ============================================================
    // F4 - REMARK SCROLL BACKWARD
    // ============================================================

    public async Task<IActionResult> OnPostScrollLeftAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        EnsureSelections();

        var input = BuildInput();

        Screen =
            await _d158302Service.ScrollRemarksBackwardAsync(
                input,
                cancellationToken);

        ApplyScreenToPage();

        ModelState.Clear();

        return Page();
    }


    // ============================================================
    // F5 - REMARK SCROLL FORWARD
    // ============================================================

    public async Task<IActionResult> OnPostScrollRightAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        EnsureSelections();

        var input = BuildInput();

        Screen =
            await _d158302Service.ScrollRemarksForwardAsync(
                input,
                cancellationToken);

        ApplyScreenToPage();

        ModelState.Clear();

        return Page();
    }


    // ============================================================
    // F6 - RESET
    // ============================================================

    public async Task<IActionResult> OnPostResetAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        EnsureSelections();

        var input = BuildInput();

        Screen =
            await _d158302Service.ResetAsync(
                input,
                cancellationToken);

        /*
         * Legacy Screen 302 behavior:
         * after F6, JOB NUMBER and FA become editable.
         */
        Screen.ScreenReset = true;
        Screen.JobNumberEditable = true;
        Screen.FunctionalAreaEditable = true;

        ApplyScreenToPage();

        Action = "";
        LatestSelection = "";

        Selections =
            CreateBlankSelections();

        ModelState.Clear();

        return Page();
    }


    // ============================================================
    // F7 - STATUS BACKWARD
    // ============================================================

    public async Task<IActionResult> OnPostBackwardAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        EnsureSelections();

        var input = BuildInput();

        Screen =
            await _d158302Service.ScrollStatusBackwardAsync(
                input,
                cancellationToken);

        ApplyScreenToPage();

        ModelState.Clear();

        return Page();
    }


    // ============================================================
    // F8 - STATUS FORWARD
    // ============================================================

    public async Task<IActionResult> OnPostForwardAsync(
        CancellationToken cancellationToken)
    {
        NormalizePostedValues();

        EnsureSelections();

        var input = BuildInput();

        Screen =
            await _d158302Service.ScrollStatusForwardAsync(
                input,
                cancellationToken);

        ApplyScreenToPage();

        ModelState.Clear();

        return Page();
    }


    // ============================================================
    // F12 - MAIN MENU
    // ============================================================

    public IActionResult OnPostMainMenu()
    {
        return RedirectToPage("/D158000");
    }


    // ============================================================
    // BUILD APPLICATION INPUT
    // ============================================================

    private D158302Input BuildInput()
    {
        return new D158302Input
        {
            Action =
                Normalize(Action),

            JobNumber =
                Normalize(JobNumber),

            FunctionalArea =
                Normalize(FunctionalArea),

            History =
                NormalizeHistory(History),

            Selections =
                Selections
                    .Select(NormalizeSelection)
                    .ToList(),

            LatestSelection =
                NormalizeSelection(LatestSelection),

            ScreenReset =
                Screen.ScreenReset,

            TopRemarkKey =
                Screen.TopRemarkKey,

            BottomRemarkKey =
                Screen.BottomRemarkKey
        };
    }


    // ============================================================
    // APPLY APPLICATION SCREEN TO RAZOR PAGE
    // ============================================================

    private void ApplyScreenToPage()
    {
        Screen ??= new D158302Screen();

        JobNumber =
            Normalize(Screen.JobNumber);

        FunctionalArea =
            Normalize(Screen.FunctionalArea);

        History =
            NormalizeHistory(Screen.History);

        /*
         * Normal 302 display is protected.
         *
         * F6/reset makes both fields editable.
         */
        if (Screen.ScreenReset)
        {
            Screen.JobNumberEditable = true;
            Screen.FunctionalAreaEditable = true;
        }
        else
        {
            Screen.JobNumberEditable = false;
            Screen.FunctionalAreaEditable = false;
        }

        EnsureSelections();
    }


    // ============================================================
    // NORMALIZE POSTED VALUES
    // ============================================================

    private void NormalizePostedValues()
    {
        Action =
            Normalize(Action);

        JobNumber =
            Normalize(JobNumber);

        FunctionalArea =
            Normalize(FunctionalArea);

        History =
            NormalizeHistory(History);

        LatestSelection =
            NormalizeSelection(
                LatestSelection);

        EnsureSelections();

        for (var i = 0; i < Selections.Count; i++)
        {
            Selections[i] =
                NormalizeSelection(
                    Selections[i]);
        }
    }


    // ============================================================
    // SELECTION LIST
    // ============================================================

    private void EnsureSelections()
    {
        Selections ??=
            new List<string>();

        while (Selections.Count < 5)
        {
            Selections.Add("");
        }

        if (Selections.Count > 5)
        {
            Selections =
                Selections
                    .Take(5)
                    .ToList();
        }
    }

    private static List<string>
        CreateBlankSelections()
    {
        return new List<string>
        {
            "",
            "",
            "",
            "",
            ""
        };
    }


    // ============================================================
    // VALUE HELPERS
    // ============================================================

    private static string Normalize(
        string? value)
    {
        return (value ?? "")
            .Trim()
            .ToUpperInvariant();
    }

    private static string NormalizeHistory(
        string? value)
    {
        var history =
            Normalize(value);

        if (history.Length > 1)
        {
            history =
                history[..1];
        }

        return string.IsNullOrWhiteSpace(history)
            ? "N"
            : history;
    }

    private static string NormalizeSelection(
        string? value)
    {
        var selection =
            Normalize(value);

        if (selection.Length > 1)
        {
            selection =
                selection[..1];
        }

        return selection;
    }
}
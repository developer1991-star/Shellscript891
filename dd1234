           if I-ACTION = "so"
               set I-ACTION to "SO"
           else if I-ACTION = "So"
               set I-ACTION to "SO"
           else if I-ACTION = "sO"
               set I-ACTION to "SO"
           end-if                                                                                                                                         
           set I-SCREEN-R                               to S_SCREEN_R::Text.                                                                                                                            
           set I-DATE-R                                 to S_DATE_R::Text.                                                                                                                              
           set I-JOBNO                                  to S_JOBNO::Text.

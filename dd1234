           IF SEL6-ATTR NOT = SPACES                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT SEL6-ATTR TALLYING UCT-COUNT FOR ALL "U"                                                                                                                                          
              INSPECT SEL6-ATTR TALLYING UCT-COUNT FOR ALL "C"                                                                                                                                          
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_SEL6::ReadOnly to False                                                                                                                                                          
                 set S_SEL6::BackColor to type System.Drawing.Color::White                                                                                                                              
              END-IF                                                                                                                                                                                    
              MOVE ZERO TO UCT-COUNT                                                                                                                                                                    
              INSPECT SEL6-ATTR TALLYING UCT-COUNT FOR ALL "P"                                                                                                                                          
              IF UCT-COUNT > 0                                                                                                                                                                          
                 set S_SEL6::ReadOnly to True                                                                                                                                                           
                 set S_SEL6::BackColor to type System.Drawing.Color::LightGray                                                                                                                          
              END-IF                                                                                                                                                                                    
              IF SEL6-ATTR(1:3) = "UAH"                                                                                                                                                                 
                 set S_SEL6::BorderColor to type System.Drawing.Color::Red                                                                                                                              
                 set S_SEL6::BorderStyle to type System.Web.UI.WebControls.BorderStyle::Solid                                                                                                           
              ELSE                                                                                                                                                                                      
                 set S_SEL6::BorderColor to type System.Drawing.Color::White                                                                                                                            
                 set S_SEL6::BorderStyle to type System.Web.UI.WebControls.BorderStyle::NotSet                                                                                                          
              END-IF                                                                                                                                                                                    
           END-IF.
CNVTEL     IF PF1-ATTR NOT = SPACES
CNVTEL        MOVE ZERO TO UCT-COUNT
CNVTEL        INSPECT PF1-ATTR TALLYING UCT-COUNT FOR ALL "I"
CNVTEL        IF UCT-COUNT > 0
CNVTEL           set S_PF1::Visible to False
CNVTEL        ELSE
CNVTEL           set S_PF1::Visible to True
CNVTEL        END-IF
CNVTEL     END-IF.
CNVTEL     IF PF3-ATTR NOT = SPACES
CNVTEL        MOVE ZERO TO UCT-COUNT
CNVTEL        INSPECT PF3-ATTR TALLYING UCT-COUNT FOR ALL "I"
CNVTEL        IF UCT-COUNT > 0
CNVTEL           set S_PF3::Visible to False
CNVTEL        ELSE
CNVTEL           set S_PF3::Visible to True
CNVTEL        END-IF
CNVTEL     END-IF.
CNVTEL     IF PF12-ATTR NOT = SPACES
CNVTEL        MOVE ZERO TO UCT-COUNT
CNVTEL        INSPECT PF12-ATTR TALLYING UCT-COUNT FOR ALL "I"
CNVTEL        IF UCT-COUNT > 0
CNVTEL           set S_PF12::Visible to False
CNVTEL        ELSE
CNVTEL           set S_PF12::Visible to True
